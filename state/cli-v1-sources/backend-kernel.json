      "decision": "Gateway拥有任务，持久受理后返回runId，重试幂等。",
      "reason": "旧连接及reattach并不证明新后台所有权。",
      "acceptance": [
        "客户端退出后继续并查询",
        "丢响应后同键重试不重复",
        "崩溃标中断或未知且不自动重跑"
      ],
      "consumers": [
        "CLI",
        "Gateway",
        "用户"
      ],
      "priority": "P0",
      "phase": "P0",
      "dependsOn": []
