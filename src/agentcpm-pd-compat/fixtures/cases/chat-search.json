{
  "slug": "chat-search",
  "caseId": "cli.case.compat.cli.compat.chat-search",
  "scenarios": [
    {
      "name": "search-json-projection",
      "summary": "--project 显式作用域 → search.start(幂等键) → operations.get 等终态 → search.results 分页 → 旧 SessionSearchResult{query,matches,truncated} 投影",
      "blackbox": "fake",
      "argv": ["chat", "search", "hello", "--json", "--project", "proj"],
      "stdin": null,
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "accepted", "result": {"kind": "operation", "operationId": "op-1", "durable": true, "acceptedRevision": "rev-1", "deduplicated": false, "state": "queued"}}},
        {"method": "operations.get", "respond": {"outcome": "succeeded", "result": {"operation": {"operationId": "op-1", "operationType": "search", "scope": {"kind": "instance"}, "state": "succeeded", "revision": "rev-1", "cancelRequested": false, "effectStatus": "known", "progress": []}}}},
        {"method": "search.results", "respond": {"outcome": "succeeded", "result": {"items": [{"sessionId": "new-1", "projectId": "proj", "role": "user", "excerpt": "hello world"}], "indexingComplete": true, "pageInfo": {"nextCursor": null}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["search.start", "operations.get", "search.results"],
        "calls": [
          {"method": "search.start", "input": {"query": "hello", "syntax": "literal", "caseSensitive": false, "scope": {"kind": "project", "projectId": "proj"}}, "requestKey": true},
          {"method": "operations.get", "input": {"operationId": "op-1"}, "requestKey": false},
          {"method": "search.results", "input": {"operationId": "op-1"}}
        ],
        "stdoutJson": [{"query": "hello", "matches": [{"sessionId": "new-1", "projectKey": "proj", "role": "user", "text": "hello world", "snippet": "hello world"}], "truncated": false}],
        "stderrContains": ["not projectable", "lineNumber"]
      },
      "note": "chat-search 映射 projection：query/matches/truncated 投影；matches[].lineNumber 与 sessionsScanned 无新等价（dropped 列出）；--project 为显式作用域；search.start 为 async，受理后先 operations.get 轮询至终态再分页"
    },
    {
      "name": "async-poll-until-terminal",
      "summary": "search.start 受理（queued）→ operations.get 轮询 running→succeeded → 才调 search.results（非终态一律 OPERATION_NOT_READY）",
      "blackbox": "fake",
      "argv": ["chat", "search", "needle", "--json", "--project", "proj"],
      "stdin": null,
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "accepted", "result": {"kind": "operation", "operationId": "op-4", "durable": true, "acceptedRevision": "rev-4", "deduplicated": false, "state": "queued"}}},
        {"method": "operations.get", "respond": {"outcome": "succeeded", "result": {"operation": {"operationId": "op-4", "operationType": "search", "scope": {"kind": "instance"}, "state": "running", "revision": "rev-4", "cancelRequested": false, "effectStatus": "known", "progress": []}}}},
        {"method": "operations.get", "respond": {"outcome": "succeeded", "result": {"operation": {"operationId": "op-4", "operationType": "search", "scope": {"kind": "instance"}, "state": "succeeded", "revision": "rev-4", "cancelRequested": false, "effectStatus": "known", "progress": []}}}},
        {"method": "search.results", "respond": {"outcome": "succeeded", "result": {"items": [], "indexingComplete": true, "pageInfo": {"nextCursor": null}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["search.start", "operations.get", "operations.get", "search.results"],
        "calls": [
          {"method": "operations.get", "input": {"operationId": "op-4"}, "requestKey": false},
          {"method": "search.results", "input": {"operationId": "op-4"}}
        ],
        "stdoutJson": [{"query": "needle", "matches": [], "truncated": false}]
      },
      "note": "search.start execution:async（cli-v1-operations.json）：receipt 只代表受理；非终态的 search.results 会 OPERATION_NOT_READY，故 compat 先有界轮询 operations.get 至终态（同 e2e await_search_terminal 模式）"
    },
    {
      "name": "operation-failed-is-reported-not-empty",
      "summary": "operations.get 终态 failed → exit 1 如实报告，绝不投影成空匹配列表（无 search.results 调用）",
      "blackbox": "fake",
      "argv": ["chat", "search", "kw", "--project", "proj"],
      "stdin": null,
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "accepted", "result": {"kind": "operation", "operationId": "op-5", "durable": true, "acceptedRevision": "rev-5", "deduplicated": false, "state": "queued"}}},
        {"method": "operations.get", "respond": {"outcome": "succeeded", "result": {"operation": {"operationId": "op-5", "operationType": "search", "scope": {"kind": "instance"}, "state": "failed", "revision": "rev-5", "cancelRequested": false, "effectStatus": "known", "progress": [], "error": {"code": "INDEX_UNAVAILABLE", "message": "index rebuilding"}}}}}
      ],
      "expect": {
        "exitCode": 1,
        "invokeMethods": ["search.start", "operations.get"],
        "stderrContains": ["ended in state `failed`", "INDEX_UNAVAILABLE"],
        "stdoutEmpty": true
      },
      "note": "失败与无结果必须区分（合同 acceptance）：终态 failed 时 exit 1 并带 recorded error code，不输出假的空结果"
    },
    {
      "name": "regex-case-sensitive-input-mapping",
      "summary": "--regex/--case-sensitive 映射进 search.start（syntax=regex、caseSensitive=true），终态后取结果",
      "blackbox": "fake",
      "argv": ["chat", "search", "h.llo", "--regex", "--case-sensitive", "--project", "proj", "--json"],
      "stdin": null,
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "accepted", "result": {"kind": "operation", "operationId": "op-2", "durable": true, "acceptedRevision": "rev-2", "deduplicated": false, "state": "queued"}}},
        {"method": "operations.get", "respond": {"outcome": "succeeded", "result": {"operation": {"operationId": "op-2", "operationType": "search", "scope": {"kind": "instance"}, "state": "succeeded", "revision": "rev-2", "cancelRequested": false, "effectStatus": "known", "progress": []}}}},
        {"method": "search.results", "respond": {"outcome": "succeeded", "result": {"items": [], "indexingComplete": true, "pageInfo": {"nextCursor": null}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["search.start", "operations.get", "search.results"],
        "calls": [
          {"method": "search.start", "input": {"syntax": "regex", "caseSensitive": true}}
        ],
        "stdoutJson": [{"query": "h.llo", "matches": [], "truncated": false}]
      },
      "note": "chat-search 映射 options：--regex 按正则解释、--case-sensitive 大小写敏感（chatSearch.ts:71-72）"
    },
    {
      "name": "text-render-no-matches",
      "summary": "文本模式 0 结果 → 'No matches found.'，分页/截断如实报告",
      "blackbox": "fake",
      "argv": ["chat", "search", "nothing", "--project", "proj"],
      "stdin": null,
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "accepted", "result": {"kind": "operation", "operationId": "op-3", "durable": true, "acceptedRevision": "rev-3", "deduplicated": false, "state": "queued"}}},
        {"method": "operations.get", "respond": {"outcome": "succeeded", "result": {"operation": {"operationId": "op-3", "operationType": "search", "scope": {"kind": "instance"}, "state": "succeeded", "revision": "rev-3", "cancelRequested": false, "effectStatus": "known", "progress": []}}}},
        {"method": "search.results", "respond": {"outcome": "succeeded", "result": {"items": [], "indexingComplete": true, "pageInfo": {"nextCursor": null}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["search.start", "operations.get", "search.results"],
        "stdoutContains": ["Search results for: nothing", "No matches found."]
      },
      "note": "chat-search 映射 projection：文本 → 英文格式化（头部 + 逐条 + 尾部）；0 结果如实报告"
    },
    {
      "name": "missing-keyword-usage",
      "summary": "缺 keyword → exit 2（旧为 'search keyword is required' exit 1）",
      "blackbox": "local",
      "argv": ["chat", "search"],
      "stdin": null,
      "expect": {
        "exitCode": 2,
        "stderrContains": ["requires a <keyword>"],
        "invokeMethods": [],
        "stdoutEmpty": true
      },
      "note": "chat-search 映射 usageErrorContract：缺 keyword → exit 2"
    },
    {
      "name": "non-search-subcommand-usage",
      "summary": "chat <非 search> → exit 2（旧为 Usage exit 1）",
      "blackbox": "local",
      "argv": ["chat", "frob"],
      "stdin": null,
      "expect": {
        "exitCode": 2,
        "stderrContains": ["expected `chat search"],
        "stdoutEmpty": true
      },
      "note": "chat-search 映射 usageErrorContract：非 search 子命令 → exit 2"
    },
    {
      "name": "pilot-home-unsupported-projection",
      "summary": "--pilot-home 旧数据根不可投影 → unsupported_projection exit 1，无业务调用",
      "blackbox": "local",
      "argv": ["chat", "search", "kw", "--pilot-home", "/tmp/legacy-root"],
      "stdin": null,
      "expect": {
        "exitCode": 1,
        "stderrContains": ["unsupported_projection"],
        "invokeMethods": [],
        "stdoutEmpty": true
      },
      "note": "chat-search 映射 projection：--pilot-home（旧 pilotHome 直扫 JSONL）不可投影，明确失败而非换处搜索"
    },
    {
      "name": "no-scope-configuration-required",
      "summary": "无 --project/--all-projects 且未配置 defaultProjectId → configuration_required exit 1（旧 cwd 默认不继承）",
      "blackbox": "local",
      "argv": ["chat", "search", "kw"],
      "stdin": null,
      "expect": {
        "exitCode": 1,
        "stderrContains": ["configuration_required"],
        "invokeMethods": []
      },
      "note": "chat-search：scope 显式选定（--all-projects → instance；--project → 该项目；否则配置 defaultProjectId）"
    },
    {
      "name": "invalid-role-usage",
      "summary": "--role 非法值 → exit 2（不复刻旧静默忽略）",
      "blackbox": "local",
      "argv": ["chat", "search", "kw", "--project", "proj", "--role", "bogus"],
      "stdin": null,
      "expect": {
        "exitCode": 2,
        "stderrContains": ["--role expects one of user|assistant|all"],
        "invokeMethods": []
      },
      "note": "chat-search 映射 usageErrorContract：--role 非法值 → exit 2（不复刻静默忽略）"
    },
    {
      "name": "session-scoped-search",
      "summary": "--session 旧 id 经映射解析为合同 session scope {kind:session,projectId,sessionId}（两个 id 必填），不再被静默忽略",
      "blackbox": "fake",
      "argv": ["chat", "search", "kw", "--session", "old-1"],
      "stdin": null,
      "shimSessions": {
        "old-1": {"sessionId": "new-1", "projectId": "proj"}
      },
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "accepted", "result": {"kind": "operation", "operationId": "op-6", "durable": true, "acceptedRevision": "rev-6", "deduplicated": false, "state": "succeeded"}}},
        {"method": "search.results", "respond": {"outcome": "succeeded", "result": {"items": [], "indexingComplete": true, "pageInfo": {"nextCursor": null}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["search.start", "search.results"],
        "calls": [
          {"method": "search.start", "input": {"scope": {"kind": "session", "projectId": "proj", "sessionId": "new-1"}}, "requestKey": true}
        ],
        "stdoutContains": ["No matches found."]
      },
      "note": "chat-search 映射 options --session（限定 sessionId，chatSearch.ts:75）：旧 id 经 compat/sessions.json 解析为合同 Scope oneOf 的 session 分支（projectId+sessionId 均必填，网关 search.rs SearchScope::Session）；receipt 已是终态则免轮询直接取结果"
    },
    {
      "name": "unknown-session-usage-error",
      "summary": "--session 无映射（拿不到 projectId/sessionId）→ 显式 exit 2 带明确错误，无业务调用，不静默改按其他 scope 搜索",
      "blackbox": "local",
      "argv": ["chat", "search", "kw", "--session", "nope"],
      "stdin": null,
      "shimSessions": {
        "old-1": {"sessionId": "new-1", "projectId": "proj"}
      },
      "expect": {
        "exitCode": 2,
        "stderrContains": ["unknown session id `nope` for --session"],
        "invokeMethods": [],
        "stdoutEmpty": true
      },
      "note": "chat-search --session 无法投影（映射表查无此 id）→ exit 2；不得静默忽略后返回其他会话命中"
    },
    {
      "name": "capability-unavailable-passthrough",
      "summary": "目标不提供 search.start（CAPABILITY_UNAVAILABLE）时如实透传 exit 1",
      "blackbox": "fake",
      "pendingS3": true,
      "argv": ["chat", "search", "kw", "--project", "proj"],
      "stdin": null,
      "fakeScript": [
        {"method": "search.start", "respond": {"outcome": "failed", "error": {"code": "CAPABILITY_UNAVAILABLE", "message": "search.start not served"}}}
      ],
      "expect": {
        "exitCode": 1,
        "stderrContains": ["CAPABILITY_UNAVAILABLE", "search.start failed"],
        "invokeMethods": ["search.start"],
        "stdoutEmpty": true
      },
      "note": "chat-search s3Pending=[search.start, search.results, history.read]：操作已由 S3 注册交付；宽松断言，真实联调在 S4 W7 批次 B"
    }
  ]
}
