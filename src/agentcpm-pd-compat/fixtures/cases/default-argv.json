{
  "slug": "default-argv",
  "caseId": "cli.case.compat.cli.compat.default-argv",
  "scenarios": [
    {
      "name": "reserved-word-exits-2",
      "summary": "顶层保留词命中 exit 2，不吞为自由文本提示词，无业务调用",
      "blackbox": "local",
      "argv": ["tui"],
      "stdin": null,
      "expect": {
        "exitCode": 2,
        "stderrContains": ["reserved word"],
        "stdoutEmpty": true
      },
      "note": "default-argv 映射 usageErrorContract：argv 首词命中保留词时明确拒绝 exit 2；tui 是保留词清单中无独立分发的词"
    },
    {
      "name": "prompt-joined-argv-through-configured-session",
      "summary": "非保留词整条 argv 以空格 join 后经配置的默认会话 input.submit(source=argument) 提交，run.events 分页等待本轮真实终态",
      "blackbox": "fake",
      "inproc": false,
      "argv": ["hello", "world"],
      "stdin": null,
      "shimConfig": {
        "schemaVersion": 2,
        "promptTargetId": "target-1",
        "promptSessionId": "shim-s-1"
      },
      "fakeScript": [
        {"method": "input.submit", "respond": {"outcome": "accepted", "result": {"receipt": {"runId": "run-9", "sessionId": "shim-s-1", "accepted": "durable", "state": "queued", "acceptedRevision": "rev-1"}}}},
        {"method": "run.events", "respond": {"outcome": "succeeded", "result": {"frame": {"events": [{"type": "run.output.delta", "payload": {"text": "hi there"}}], "caughtUp": true, "terminal": true}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["input.submit", "run.events"],
        "calls": [
          {"method": "input.submit", "input": {"source": "argument", "text": "hello world", "sessionId": "shim-s-1"}, "requestKey": true},
          {"method": "run.events", "input": {"runId": "run-9"}, "requestKey": false}
        ],
        "stdoutContains": ["hi there"]
      },
      "note": "default-argv 映射 sequence：input.submit(source=argument, text=argv join) 的 RunAck（receipt.runId 顶层）→ run.events 分页等待 terminal；targetId 由 --target 派生不进业务输入；输出经旧 plain renderer 语义投影（run.output.delta 是新事件模型的 assistant 文本增量）"
    },
    {
      "name": "no-home-configuration-required",
      "summary": "AGENTCPM_PD_HOME 未设时提示词入口 configuration_required exit 1",
      "blackbox": "local",
      "inproc": "guarded",
      "homeEnv": false,
      "argv": ["hello"],
      "stdin": null,
      "expect": {
        "exitCode": 1,
        "stderrContains": ["configuration_required"],
        "stdoutEmpty": true
      },
      "note": "已裁决行为：AGENTCPM_PD_HOME 未设 → 业务入口 configuration_required；A 层 guarded（仅当测试进程未设该变量时执行）"
    },
    {
      "name": "no-prompt-policy-configuration-required",
      "summary": "有 home 但未配置默认会话策略（promptTargetId/promptSessionId）→ configuration_required exit 1，无业务调用",
      "blackbox": "local",
      "inproc": false,
      "argv": ["hello"],
      "stdin": null,
      "expect": {
        "exitCode": 1,
        "stderrContains": ["configuration_required", "promptTargetId"],
        "stdoutEmpty": true
      },
      "note": "default-argv 映射 sequence：默认项目/会话由 shim 配置显式确定（无隐式会话）"
    },
    {
      "name": "gap-replay-dedups-prompt-output",
      "summary": "prompt 等待的 run.events 在 gap 重放后去重：每个事件只投影一次（stdout 无重复）",
      "blackbox": "fake",
      "inproc": false,
      "argv": ["hello"],
      "stdin": null,
      "shimConfig": {
        "schemaVersion": 2,
        "promptTargetId": "target-1",
        "promptSessionId": "shim-s-1"
      },
      "fakeScript": [
        {"method": "input.submit", "respond": {"outcome": "accepted", "result": {"receipt": {"runId": "run-9", "sessionId": "shim-s-1", "accepted": "durable", "state": "queued", "acceptedRevision": "rev-1"}}}},
        {"method": "run.events", "respond": {"outcome": "succeeded", "result": {"frame": {"events": [{"cursor": "h1", "type": "run.output.delta", "payload": {"text": "hello "}}, {"cursor": "h2", "type": "run.output.delta", "payload": {"text": "world"}}], "caughtUp": true, "terminal": false, "nextCursor": "h2"}}}},
        {"method": "run.events", "respond": {"outcome": "succeeded", "result": {"frame": {"kind": "gap", "reason": "cursor_invalid", "resourceId": "run-9", "recoveryMethod": "run.snapshot"}}}},
        {"method": "run.events", "respond": {"outcome": "succeeded", "result": {"frame": {"events": [{"cursor": "h1", "type": "run.output.delta", "payload": {"text": "hello "}}, {"cursor": "h2", "type": "run.output.delta", "payload": {"text": "world"}}, {"cursor": "h3", "type": "run.output.delta", "payload": {"text": "!"}}], "caughtUp": true, "terminal": false, "nextCursor": "h3"}}}},
        {"method": "run.events", "respond": {"outcome": "succeeded", "result": {"frame": {"events": [], "caughtUp": true, "terminal": true}}}}
      ],
      "expect": {
        "exitCode": 0,
        "invokeMethods": ["input.submit", "run.events", "run.events", "run.events", "run.events"],
        "stdoutContains": ["hello world!"],
        "stdoutExcludes": ["hello worldhello"]
      },
      "note": "P2 gap 重放去重（prompt_turn 路径）：与 sdk-run 共用 entry::run::page_run_events（同一预算与去重），此处经 B 层钉住 stdout 不重复"
    }
  ]
}
