{
  "name": "tool-execute-code-traceback",
  "about": "execute_code 脚本抛异常：traceback 进 error 与 output；嵌套工具失败未捕获时同理。traceback 里带随机临时目录名，基线自比不稳。",
  "files": {
    "proj/note.txt": "first line\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "execute_code",
          "arguments": {
            "code": "from pilotdeck_tools import read_file\nread_file('/private/tmp/pdrs-bbx/root/proj/missing.txt')\n"
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "execute_code",
          "arguments": {
            "code": "print('before')\nraise ValueError('boom')\n"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-bbx-1",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-2: run the tool"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ],
  "volatile": [
    "\\.(used|ratio|displayUsed|usageTokens|localEstimateTokens|calibrationEstimatedInputTokens|fileSize|breakdown\\.total|breakdown\\.messages|resultBytes|content-length)$"
  ],
  "volatileWhy": "工具结果文本里带随机 id（子代理 UUID / 临时目录名进了 traceback）或位数不定的耗时，文本长度逐次差几个字符，token 估算、字节数和文件大小随之变；基线自比已证明"
}
