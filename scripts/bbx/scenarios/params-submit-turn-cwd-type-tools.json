 "steps": [
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-num",
    "channelKey": "test",
    "message": "cwdtool-num: run tools",
    "workspaceCwd": 5
   },
   "timeout": 30000,
   "answer": [
    {
     "on": {
      "type": "permission_request"
     },
     "ws": "permission_decide",
     "params": {
      "sessionKey": "s-num",
      "requestId": "{event.requestId}",
      "decision": "allow"
     }
    }
   ]
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-true",
    "channelKey": "test",
    "message": "cwdtool-true: run tools",
    "workspaceCwd": true
   },
   "timeout": 30000,
   "answer": [
    {
     "on": {
      "type": "permission_request"
     },
     "ws": "permission_decide",
     "params": {
      "sessionKey": "s-true",
      "requestId": "{event.requestId}",
      "decision": "allow"
     }
    }
   ]
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-obj",
    "channelKey": "test",
    "message": "cwdtool-obj: run tools",
    "workspaceCwd": {
     "a": 1
    }
   },
   "timeout": 30000,
   "answer": [
    {
     "on": {
      "type": "permission_request"
     },
     "ws": "permission_decide",
