{
  "name": "slash-plugin-command",
  "about": "以斜杠开头的普通消息（/plan、/compact 之外）：gateway 不拦截；插件命令（commands/*.md，带参数、不带参数、正文为空）与没有登记的 /xxx 在基线上都原样作为用户文本进 accepted_input 和模型请求（InputProcessor 的命令展开不在这条路径上生效）。",
  "files": {
    "home/.pilotdeck/plugins/cmd-plugin/plugin.json": {
      "name": "cmd-plugin",
      "version": "0.1.0",
      "description": "bbx plugin with slash commands",
      "commands": "commands"
    },
    "home/.pilotdeck/plugins/cmd-plugin/commands/hello.md": "---\ndescription: Say hello from the bbx plugin.\nargument-hint: \"[name]\"\n---\n\nSay hello to $ARGUMENTS.\n",
    "home/.pilotdeck/plugins/cmd-plugin/commands/empty.md": "---\ndescription: A command without a body.\n---\n"
  },
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Slash commands\"}" } },
    { "name": "main", "reply": { "text": "Done." } }
  ],
  "steps": [
    { "ws": "commands_list", "params": { "projectKey": "{PILOT_HOME}" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-slash", "channelKey": "test", "message": "/hello world and <<<PILOTDECK_COMMAND_BODY_0>>>" } },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-slash", "channelKey": "test", "message": "/hello" } },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-slash", "channelKey": "test", "message": "/empty some argument" } },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-slash", "channelKey": "test", "message": "/empty" } },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-slash", "channelKey": "test", "message": "/nosuch thing" } },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-slash", "channelKey": "test", "message": "  /hello indented" } },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-slash" } }
  ]
}
