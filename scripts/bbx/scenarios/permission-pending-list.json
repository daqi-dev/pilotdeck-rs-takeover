{
  "name": "permission-pending-list",
  "about": "权限询问待决期间 permission_list 能看到它；无人批准，超时后清空。",
  "env": {
    "PILOTDECK_PERMISSION_TIMEOUT_MS": "1500"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "create_goal",
          "arguments": {
            "objective": "listed"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_list",
          "params": {
            "sessionKey": "s-bbx-1"
          },
          "count": 1
        }
      ],
      "timeout": 15000
    },
    {
      "ws": "permission_list",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ]
}
