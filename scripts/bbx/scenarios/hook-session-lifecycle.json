{
  "name": "hook-session-lifecycle",
  "about": "插件的 SessionStart / Setup / Stop / StopFailure / SessionEnd hook：每次提交都跑 SessionStart、Setup、SessionEnd（gateway 每轮一个会话周期），它们的效果与退出码不影响本轮；Stop 收到最后一句助手消息，退出码 2 与 decision:block 让本轮以 lifecycle_blocked（stage stop）失败，additionalContext、非零退出不影响；模型请求失败时 StopFailure 收到 error；SessionEnd 的 hook 1.5 秒超时被杀（hooklog 里没有 done 行），matcher 与事件名不同的不跑。",
  "files": {
    "home/.pilotdeck/plugins/bbx-life/plugin.json": {
      "name": "bbx-life",
      "version": "0.1.0",
      "description": "bbx bbx-life",
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs session-start 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"ignored by the session\"}}\n' '' 0"
              }
            ]
          }
        ],
        "Setup": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs setup 2 '' 'setup blocking is ignored\n' 0"
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs stop @ '' '' 0"
              },
              {
                "type": "command",
                "command": "node hook.mjs stop-second 0 '' '' 0"
              }
            ]
          }
        ],
        "StopFailure": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs stop-failure 0 '' '' 0"
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "matcher": "SessionEnd",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs session-end @ '' '' 0"
              }
            ]
          },
          {
            "matcher": "Other",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs session-end-nomatch 0 '' '' 0"
              }
            ]
          },
          {
            "matcher": "SessionEnd",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs session-end-slow 0 '' '' 4000"
              }
            ]
          }
        ]
      }
    },
    "home/.pilotdeck/plugins/bbx-life/hook.mjs": "// bbx hook fixture: node hook.mjs <log> <exit> [stdout] [stderr] [sleepMs]\nimport fs from 'node:fs';\nconst [log, exit = '0', out = '', err = '', sleep = '0'] = process.argv.slice(2);\nconst dir = process.env.HOME + '/hooklog';\nconst append = (row) => { fs.mkdirSync(dir, { recursive: true }); fs.appendFileSync(dir + '/' + log + '.jsonl', JSON.stringify(row) + '\\n'); };\nlet input = '';\nprocess.stdin.on('data', (d) => { input += d; });\nprocess.stdin.on('end', () => {\n  let parsed; try { parsed = JSON.parse(input); } catch { parsed = { raw: input }; }\n  const env = {};\n  for (const k of Object.keys(process.env).sort()) env[k] = /^PILOT/.test(k) && !/BUNDLED/.test(k) ? process.env[k] : true;\n  append({ argv: process.argv.slice(2), cwd: process.cwd(), input: parsed, env });\n  // exit \"@\": the behaviour is the JSON between HOOK<< and >> in the prompt (or the last assistant message).\n  let spec = { exit, out, err, sleep };\n  if (exit === '@') {\n    const m = /HOOK<<(.*?)>>/s.exec(String(parsed.prompt ?? parsed.lastAssistantMessage ?? ''));\n    spec = { exit: 0, out: '', err: '', sleep: 0, ...(m ? JSON.parse(m[1]) : {}) };\n  }\n  setTimeout(() => {\n    append({ argv: process.argv.slice(2), done: true });\n    if (spec.out) process.stdout.write(spec.out);\n    if (spec.err) process.stderr.write(spec.err);\n    process.exit(Number(spec.exit));\n  }, Number(spec.sleep));\n});\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Hook run\"}"
      }
    },
    {
      "name": "model-error",
      "when": [
        "case-model-error:"
      ],
      "reply": {
        "status": 400,
        "body": {
          "error": {
            "message": "bad request from mock",
            "type": "invalid_request_error"
          }
        }
      }
    },
    {
      "name": "case-pass",
      "when": [
        "case-pass:"
      ],
      "reply": {
        "text": "all good"
      }
    },
    {
      "name": "case-stop-block",
      "when": [
        "case-stop-block:"
      ],
      "reply": {
        "text": "blocked HOOK<<{\"exit\":2,\"err\":\"stop hook blocked\\n\"}>>"
      }
    },
    {
      "name": "case-stop-json",
      "when": [
        "case-stop-json:"
      ],
      "reply": {
        "text": "json HOOK<<{\"out\":\"{\\\"decision\\\":\\\"block\\\",\\\"reason\\\":\\\"stop json block\\\"}\\n\"}>>"
      }
    },
    {
      "name": "case-stop-context",
      "when": [
        "case-stop-context:"
      ],
      "reply": {
        "text": "context HOOK<<{\"out\":\"{\\\"hookSpecificOutput\\\":{\\\"hookEventName\\\":\\\"Stop\\\",\\\"additionalContext\\\":\\\"stop context\\\"}}\\n\"}>>"
      }
    },
    {
      "name": "case-stop-fail",
      "when": [
        "case-stop-fail:"
      ],
      "reply": {
        "text": "fail HOOK<<{\"exit\":1,\"err\":\"stop failed\\n\"}>>"
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-pass",
        "channelKey": "test",
        "message": "case-pass: say something"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-stop-block",
        "channelKey": "test",
        "message": "case-stop-block: say something"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-stop-json",
        "channelKey": "test",
        "message": "case-stop-json: say something"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-stop-context",
        "channelKey": "test",
        "message": "case-stop-context: say something"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-stop-fail",
        "channelKey": "test",
        "message": "case-stop-fail: say something"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-model-error",
        "channelKey": "test",
        "message": "case-model-error: fail please"
      },
      "timeout": 20000
    },
    {
      "sleep": 4500
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-stop-block"
      }
    }
  ],
  "settleMs": 1000
}
