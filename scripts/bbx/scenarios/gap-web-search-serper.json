{
 "name": "gap-web-search-serper",
 "about": "tools.webSearch provider=serper（webSearch.ts:390-471）：POST + X-API-KEY，体带 q/num/gl；organic 解析；非 2xx 错误文案。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ntools:\n  webSearch:\n    enabled: true\n    provider: serper\n    endpoint: {MOCK}/serper\n    apiKey: key-serper\n",
 "provider": [
  {
   "name": "search-01",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 200,
    "body": {
     "organic": [
      {
       "title": "T1",
       "link": "https://s.example/1",
       "snippet": "S1",
       "date": "Jan 1"
      }
     ],
     "knowledgeGraph": {
      "title": "KG"
     }
    }
   },
   "when": [
    "serp ok"
   ]
  },
  {
   "name": "search-02",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 400,
    "body": {
     "message": "bad"
    }
   },
   "when": [
    "serp status"
   ]
  },
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "t02-after",
   "when": [
    "g02:",
    "\"tool_call_id\":\"call_g02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "t02",
   "when": [
    "g02:"
   ],
   "reply": {
    "tool": {
     "id": "call_g02",
     "name": "web_search",
     "arguments": {
      "query": "serp status"
     }
    }
   }
  },
  {
   "name": "t01-after",
   "when": [
    "g01:",
    "\"tool_call_id\":\"call_g01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "t01",
   "when": [
    "g01:"
   ],
   "reply": {
    "tool": {
     "id": "call_g01",
     "name": "web_search",
     "arguments": {
      "query": "serp ok",
      "gl": "cn"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-gap",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g01: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g02: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "read_session_messages",
   "params": {
    "sessionKey": "s-gap"
   }
  }
 ]
}
