            "message": "write inner: behind the inner link"
          }
        },
        {
          "sleep": 1500
        },
        {
          "ws": "set_permission_mode",
          "params": {
            "sessionKey": "s-wg",
            "mode": "bypassPermissions"
          }
        },
        {
          "ws": "submit_turn",
          "params": {
            "sessionKey": "s-wg",
            "channelKey": "test",
