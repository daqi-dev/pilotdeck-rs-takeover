{
  "name": "agent-loop-sidecar-stdio-exit",
  "about": "PILOTDECK_AGENT_LOOP_TRANSPORT=stdio，sidecar 命令换成一个读完第一行（hello）就往 stderr 写一行并以退出码 3 退出的脚本（PILOTDECK_AGENT_LOOP_SIDECAR_COMMAND=/bin/sh，PILOTDECK_AGENT_LOOP_SIDECAR_PATH 指向脚本）：握手阶段 stdout 关闭，轮次以 stdioAgentLoopSidecarConnection.ts:116-121、129-136 的错误收尾（含 stderr 诊断）。比较 submit_turn 的帧、会话记录与 provider 请求；同一会话失败后再提交一次。标题请求延迟 1.5 秒，让标题记录稳定落在失败记录之后。",
  "env": {
    "PILOTDECK_AGENT_LOOP_TRANSPORT": "stdio",
    "PILOTDECK_AGENT_LOOP_SIDECAR_COMMAND": "/bin/sh",
    "PILOTDECK_AGENT_LOOP_SIDECAR_PATH": "{ROOT}/proj/exit-sidecar.sh"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Sidecar fail\"}",
        "delayMs": 1500
      }
    },
    {
      "name": "main",
      "reply": {
        "text": "Should not be reached."
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-sf-exit",
        "channelKey": "test",
        "message": "sf-exit: hello"
      },
      "timeout": 30000
    },
    {
      "sleep": 2500
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-sf-exit",
        "channelKey": "test",
        "message": "sf-exit: again"
      },
      "timeout": 30000
    },
    {
      "sleep": 2500
    }
  ],
  "files": {
    "proj/exit-sidecar.sh": "read line\necho \"sidecar boom\" >&2\nexit 3\n"
  }
}
