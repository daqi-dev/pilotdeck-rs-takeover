{
  "name": "read-messages-paging",
  "about": "read_session_messages 的参数：三轮纯文本对话后按 limit / cursor 翻页（含 0、负数、字符串、非法游标），不存在的会话，projectKey 的各种取值（登记过的、带尾斜杠、没登记的、不存在的、相对路径、非字符串），sessionKey 的非字符串取值，background_task 的 relativeTranscriptPath（合法、绝对、越界、非 .jsonl），parentSessionId；另有一轮 provider 报错的对话，读出错误消息。",
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Paging\"}" } },
    { "name": "fail", "when": ["trigger provider failure"], "reply": { "status": 400, "body": { "error": { "message": "bbx bad request", "type": "invalid_request_error" } } } },
    { "name": "main", "reply": { "text": "Reply from the mock." } }
  ],
  "files": {
    "home/work/alpha/README.md": "alpha\n",
    "home/work/gamma/README.md": "gamma\n",
    "home/.pilotdeck/projects/private-tmp-pdrs-bbx-root-home-work-alpha/.cwd": "{HOME}/work/alpha\n"
  },
  "steps": [
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-page", "channelKey": "test", "message": "first question" } },
    { "sleep": 500 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-page", "channelKey": "test", "message": "second question" } },
    { "sleep": 500 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-page", "channelKey": "test", "message": "third question" } },
    { "sleep": 500 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-alpha", "channelKey": "test", "message": "hello alpha", "projectKey": "{HOME}/work/alpha" } },
    { "sleep": 500 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2, "cursor": "2" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 4, "cursor": "7" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "cursor": "5" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 0, "cursor": "6" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 100 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2, "cursor": "999" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2, "cursor": "abc" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2, "cursor": "-3" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2, "cursor": "3.9x" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2, "cursor": 4 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": -2 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": "2", "cursor": "1" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": 2.5 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": null, "cursor": null } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "limit": true } },
    { "ws": "read_session_messages", "params": { "sessionKey": "missing" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "missing", "limit": 2 } },
    { "ws": "read_session_messages" },
    { "ws": "read_session_messages", "params": { "sessionKey": null } },
    { "ws": "read_session_messages", "params": { "sessionKey": 7 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "a/b:c" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha", "projectKey": "{HOME}/work/alpha" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha", "projectKey": "{HOME}/work/alpha/" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha", "projectKey": "{HOME}/work/gamma" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha", "projectKey": "{HOME}/work/nope" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha", "projectKey": "work/alpha" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-alpha", "projectKey": 7 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "projectKey": "" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "projectKey": null } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "parentSessionId": "p-1", "relativeTranscriptPath": "ignored.jsonl", "limit": 1 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "bg", "sessionKind": "background_task", "relativeTranscriptPath": "s-page.jsonl", "limit": 2 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "bg", "sessionKind": "background_task", "relativeTranscriptPath": "sub/../s-page.jsonl", "limit": 1, "parentSessionId": "p-2" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "bg", "sessionKind": "background_task", "relativeTranscriptPath": "nope.jsonl" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "bg", "sessionKind": "background_task", "relativeTranscriptPath": "{PILOT_HOME}/x.jsonl" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "bg", "sessionKind": "background_task", "relativeTranscriptPath": "../escape.jsonl" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "bg", "sessionKind": "background_task", "relativeTranscriptPath": "s-page.txt" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "sessionKind": "background_task", "relativeTranscriptPath": "", "limit": 1 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-page", "sessionKind": "other", "relativeTranscriptPath": "nope.jsonl", "limit": 1 } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-fail", "channelKey": "test", "message": "trigger provider failure" }, "timeout": 60000 },
    { "sleep": 500 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-fail" } },
    { "ws": "list_sessions" }
  ],
  "volatile": ["\\.requestFingerprint$"]
}
