{
 "name": "gap-web-search-tavily",
 "about": "tools.webSearch provider=tavily（webSearch.ts:483-580）：POST 体带 api_key/max_results/include_answer；results 与 answer 解析成 organic 与 answerBox；非 2xx 错误文案。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ntools:\n  webSearch:\n    enabled: true\n    provider: tavily\n    endpoint: {MOCK}/tavily\n    apiKey: key-tavily\n",
 "provider": [
  {
   "name": "search-01",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 200,
    "body": {
     "answer": "The answer",
     "results": [
      {
       "title": "T1",
       "url": "https://t.example/1",
       "content": "C1"
      },
      {
       "title": "T2",
       "url": "https://t.example/2"
      }
     ]
    }
   },
   "when": [
    "tav ok"
   ]
  },
  {
   "name": "search-02",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 200,
    "body": {
     "answer": "",
     "results": "nope"
    }
   },
   "when": [
    "tav empty"
   ]
  },
  {
   "name": "search-03",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 403,
    "body": {
     "detail": "forbidden"
    }
   },
   "when": [
    "tav status"
   ]
  },
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "t03-after",
   "when": [
    "g03:",
    "\"tool_call_id\":\"call_g03\""
   ],
   "reply": {
    "text": "Done 03."
   }
  },
  {
   "name": "t03",
   "when": [
    "g03:"
   ],
   "reply": {
    "tool": {
     "id": "call_g03",
     "name": "web_search",
     "arguments": {
      "query": "tav status"
     }
    }
   }
  },
  {
   "name": "t02-after",
   "when": [
    "g02:",
    "\"tool_call_id\":\"call_g02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "t02",
   "when": [
    "g02:"
   ],
   "reply": {
    "tool": {
     "id": "call_g02",
     "name": "web_search",
     "arguments": {
      "query": "tav empty"
     }
    }
   }
  },
  {
   "name": "t01-after",
   "when": [
    "g01:",
    "\"tool_call_id\":\"call_g01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "t01",
   "when": [
    "g01:"
   ],
   "reply": {
    "tool": {
     "id": "call_g01",
     "name": "web_search",
     "arguments": {
      "query": "tav ok",
      "gl": "us"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-gap",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g01: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g02: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g03: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "read_session_messages",
   "params": {
    "sessionKey": "s-gap"
   }
  }
 ]
}
