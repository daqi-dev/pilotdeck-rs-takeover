{
  "env": {
    "PILOTDECK_TOKEN": "{TOKEN}"
  },
  "name": "c1-sdk-cancel-resume",
  "files": {
    "home/.pilotdeck/projects/c1-sdk-cancel-resume-fixture/.cwd": "{PROJECT}\n"
  },
  "about": "正式CLI恢复同一会话，模型发出首段后挂住；serve只读registry确认同session/project/request/runId的partial已持久化且provider已flush并仍开放后，只向该CLI PID发送SIGINT。要求自行结束，再resume同一会话并查询历史。SDK默认过滤partial，不能用CLI stdout作为取消触发。无宿主18789；provider只用bbx本地mock；固定harness后待E0 TS自比/Rust对拍。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\":\"C1 cancel resume\"}"
      }
    },
    {
      "name": "recovered",
      "when": [
        "C1-RECOVER"
      ],
      "reply": {
        "text": "C1 recovered reply."
      }
    },
    {
      "name": "cancel",
      "when": [
        "C1-CANCEL"
      ],
      "reply": {
        "chunks": [
          "C1 partial"
        ],
        "hangAfter": 1,
        "hangMs": 15000
      }
    },
    {
      "name": "initial",
      "when": [
        "C1-INITIAL"
      ],
      "reply": {
        "text": "C1 initial reply."
      }
    },
    {
      "name": "unexpected",
      "reply": {
        "text": "C1 unexpected request."
      }
    }
  ],
  "steps": [
    {
      "cli": [
        "run",
        "--project",
        "{PROJECT}",
        "--channel",
        "c1-cancel",
        "--json",
        "C1-INITIAL"
      ],
      "save": {
        "session": "sessionId\\\\\":\\\\\"([^\"\\\\]+)"
      }
    },
    {
      "serve": [
        "resume",
        "{saved.session}",
        "--project",
        "{PROJECT}",
        "--stream-json",
        "C1-CANCEL"
      ],
      "signal": "SIGINT",
      "timeout": 12000,
      "settleMs": 100,
      "untilPersistedRunEvent": {
        "sessionKey": "{saved.session}",
        "projectKey": "{PROJECT}",
        "requestText": "C1-CANCEL",
        "event": {
          "type": "assistant_text_delta",
          "text": "C1 partial"
        },
        "providerRule": "cancel"
      }
    },
    {
      "cli": [
        "resume",
        "{saved.session}",
        "--project",
        "{PROJECT}",
        "--json",
        "C1-RECOVER"
      ],
      "timeout": 20000
    },
    {
      "cli": [
        "sessions",
        "messages",
        "{saved.session}",
        "--project",
        "{PROJECT}"
      ]
    }
  ],
  "assertions": [
    {
      "id": "initial-completed",
      "path": "/steps/0/cli/exitCode",
      "equals": 0
    },
    {
      "id": "partial-reached",
      "path": "/steps/1/serve/reached",
      "equals": true
    },
    {
      "id": "signal-handled",
      "path": "/steps/1/serve/signal",
      "equals": null
    },
    {
      "id": "cancel-exit",
      "path": "/steps/1/serve/exitCode",
      "equals": 1
    },
    {
      "id": "recovery-completed",
      "path": "/steps/2/cli/exitCode",
      "equals": 0
    },
    {
      "id": "recovery-real-output",
      "path": "/steps/2/cli/stdout",
      "includes": "C1 recovered reply."
    },
    {
      "id": "recovery-status",
      "path": "/steps/2/cli/stdout",
      "includes": "\"status\":\"completed\""
    },
    {
      "id": "history-read",
      "path": "/steps/3/cli/exitCode",
      "equals": 0
    },
    {
      "id": "history-after-recovery",
      "path": "/steps/3/cli/stdout",
      "includes": "C1-RECOVER"
    },
    {
      "id": "cancel-model-request",
      "path": "/provider/cancel/0/body/model",
      "equals": "deterministic"
    },
    {
      "id": "recovery-model-request",
      "path": "/provider/recovered/0/body/model",
      "equals": "deterministic"
    },
    {
      "id": "signal-aborted-footer",
      "sides": [
        "rust"
      ],
      "path": "/steps/1/serve/stdout",
      "matches": "\\n\\{\"status\":\"aborted\",\"reason\":\"CLI interrupted\"\\}\\n$"
    },
    {
      "id": "signal-empty-stderr",
      "sides": [
        "rust"
      ],
      "path": "/steps/1/serve/stderr",
      "equals": ""
    }
  ],
  "accepted": [
    {
      "id": "D1-SDK-SIGNAL-ABORT-ORDER-001",
      "policy": "sdkSignalAbortOrder",
      "why": "Single real SIGINT/current-run abort ordering bug; raw durable recovery and independently reverified same-binary eight-wire evidence are both required. TS self instability remains DIFF.",
      "assertions": [
        "initial-completed",
        "partial-reached",
        "signal-handled",
        "cancel-exit",
        "recovery-completed",
        "recovery-real-output",
        "recovery-status",
        "history-read",
        "history-after-recovery",
        "cancel-model-request",
        "recovery-model-request",
        "signal-aborted-footer",
        "signal-empty-stderr"
      ]
    },
    {
      "id": "D1-SDK-SIGNAL-TERMINAL-OBSERVATION-001",
      "policy": "sdkSignalTerminalObservation",
      "why": "Explicitly approved preservation of Rust complete terminal: only TS missing the sole result seq7 with exact six-event prefix, matching durable seq8, real recovery and same-binary strict eight-wire proof. TS self never accepted.",
      "assertions": [
        "initial-completed",
        "partial-reached",
        "signal-handled",
        "cancel-exit",
        "recovery-completed",
        "recovery-real-output",
        "recovery-status",
        "history-read",
        "history-after-recovery",
        "cancel-model-request",
        "recovery-model-request",
        "signal-aborted-footer",
        "signal-empty-stderr"
      ]
    }
  ]
}
