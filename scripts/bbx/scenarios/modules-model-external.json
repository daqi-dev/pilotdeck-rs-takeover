{
  "name": "modules-model-external",
  "about": "modules.modelProvider 绑到外部 HTTP 模块（runtimePorts.ts:99-104，hostModelInvokerPort.ts:66-216，AgentSessionRuntimeBundle.ts:184-207）：server 照常启动；主循环的每次模型调用换成向模块 prepare（带 preparationId 与执行上下文）再 stream（一次拿回全部规范事件），请求与事件照常写进会话记录；prepare 回的 maxContextTokens / maxOutputTokens 改变本轮预算；标题生成仍走 router（假 provider）。同一会话两轮：模块客户端的 messageId 接着编号，manifest 只取一次。比较发给模块的每个请求、帧与落盘。",
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\nmodules:\n  modelProvider:\n    enabled: true\n    implementationId: bbx.model\n    contract: pilotdeck.model/v1\n    transport: module-http-v2\n    endpoint: {MOCK}\n    manifestPath: /mp/module-manifest\n    callPath: /mp/call\n    methods:\n      - prepare\n      - stream\n",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\":\"Model run\"}"
      }
    },
    {
      "name": "mp-manifest",
      "url": "/mp/module-manifest",
      "reply": {
        "status": 200,
        "body": {
          "protocolVersion": "2.0",
          "implementationId": "bbx.model",
          "contract": "pilotdeck.model/v1",
          "transport": "module-http-v2",
          "methods": [
            "prepare",
            "stream"
          ]
        }
      }
    },
    {
      "name": "mp-prepare-2",
      "url": "/mp/call",
      "when": [
        "\"operation\":\"prepare\"",
        "turn-2:"
      ],
      "save": {
        "mid": "\"messageId\":\"(module-http-\\d+)\""
      },
      "reply": {
        "status": 200,
        "body": {
          "kind": "response",
          "messageId": "bbx-module-reply",
          "inReplyTo": "{saved.mid}",
          "ok": true,
          "payload": {
            "prepared": {
              "provider": "bbx",
              "model": "deterministic",
              "request": {
                "provider": "bbx",
                "model": "deterministic",
                "messages": [
                  {
                    "role": "user",
                    "content": [
                      {
                        "type": "text",
                        "text": "marker-two"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "mp-prepare-1",
      "url": "/mp/call",
      "when": [
        "\"operation\":\"prepare\"",
        "turn-1:"
      ],
      "save": {
        "mid": "\"messageId\":\"(module-http-\\d+)\""
      },
      "reply": {
        "status": 200,
        "body": {
          "kind": "response",
          "messageId": "bbx-module-reply",
          "inReplyTo": "{saved.mid}",
          "ok": true,
          "payload": {
            "prepared": {
              "provider": "bbx",
              "model": "deterministic",
              "request": {
                "provider": "bbx",
                "model": "deterministic",
                "messages": [
                  {
                    "role": "user",
                    "content": [
                      {
                        "type": "text",
                        "text": "marker-one"
                      }
                    ]
                  }
                ]
              },
              "maxContextTokens": 32768,
              "maxOutputTokens": 2048
            }
          }
        }
      }
    },
    {
      "name": "mp-stream-1",
      "url": "/mp/call",
      "when": [
        "\"operation\":\"stream\"",
        "marker-one"
      ],
      "save": {
        "mid": "\"messageId\":\"(module-http-\\d+)\""
      },
      "reply": {
        "status": 200,
        "body": {
          "kind": "response",
          "messageId": "bbx-module-reply",
          "inReplyTo": "{saved.mid}",
          "ok": true,
          "payload": {
            "events": [
              {
                "type": "request_started",
                "provider": "bbx",
                "model": "deterministic"
              },
              {
                "type": "message_start",
                "role": "assistant"
              },
              {
                "type": "text_delta",
                "text": "Hello from module."
              },
              {
                "type": "message_end",
                "finishReason": "stop"
              },
              {
                "type": "usage",
                "usage": {
                  "inputTokens": 10,
                  "outputTokens": 3
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "mp-stream-2",
      "url": "/mp/call",
      "when": [
        "\"operation\":\"stream\"",
        "marker-two"
      ],
      "save": {
        "mid": "\"messageId\":\"(module-http-\\d+)\""
      },
      "reply": {
        "status": 200,
        "body": {
          "kind": "response",
          "messageId": "bbx-module-reply",
          "inReplyTo": "{saved.mid}",
          "ok": true,
          "payload": {
            "events": [
              {
                "type": "request_started",
                "provider": "bbx",
                "model": "deterministic"
              },
              {
                "type": "message_start",
                "role": "assistant"
              },
              {
                "type": "thinking_delta",
                "text": "pondering"
              },
              {
                "type": "text_delta",
                "text": "Second "
              },
              {
                "type": "text_delta",
                "text": "answer."
              },
              {
                "type": "message_end",
                "finishReason": "stop"
              },
              {
                "type": "usage",
                "usage": {
                  "inputTokens": 20,
                  "outputTokens": 5,
                  "cacheReadTokens": 4
                }
              }
            ]
          }
        }
      }
    },
    {
      "name": "main",
      "reply": {
        "text": "provider-direct"
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-m1",
        "channelKey": "test",
        "message": "turn-1: hello"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-m1",
        "channelKey": "test",
        "message": "turn-2: again"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-m1"
      }
    }
  ]
}
