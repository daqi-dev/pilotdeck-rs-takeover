{
 "name": "gap-tool-read-file-vision",
 "about": "read_file 在主模型声明 multimodal.input [text, image, pdf] 时（readFile.ts:189-300）：真实 PNG 作为图片内容回给模型、内容不是图片的 .png、PDF 整读、PDF 按页渲染（pages=1）。比较发给 provider 的请求里图片 / PDF 怎么出现（OpenAI chat 形状），以及会话记录。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/vision\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        vision:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n          multimodal:\n            input: [text, image, pdf]\ntelemetry:\n  enabled: false\n",
 "files": {
  "home/.pilotdeck/projects/private-tmp-pdrs-bbx-root-home-work-alpha/.cwd": "{HOME}/work/alpha\n",
  "home/work/alpha/doc.pdf": "%PDF-1.4\n1 0 obj<<>>endobj\ntrailer<<>>\n%%EOF\n"
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "t05-after",
   "when": [
    "g05:",
    "\"tool_call_id\":\"call_g05\""
   ],
   "reply": {
    "text": "Done 05."
   }
  },
  {
   "name": "t05",
   "when": [
    "g05:"
   ],
   "reply": {
    "tool": {
     "id": "call_g05",
     "name": "read_file",
     "arguments": {
      "file_path": "doc.pdf",
      "pages": "1"
     }
    }
   }
  },
  {
   "name": "t04-after",
