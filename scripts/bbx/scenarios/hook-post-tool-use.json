{
  "name": "hook-post-tool-use",
  "about": "插件的 PostToolUse / PostToolUseFailure hook：放行、additionalContext（进结果 metadata.lifecycle，再到下一次模型请求）、退出码 2 与 decision:block（工具结果带 lifecycle.blocked，循环以 lifecycle_blocked 结束这一轮）、stdout 非法、非零退出；bash 失败时 PostToolUseFailure 收到 error / isInterrupt。",
  "files": {
    "home/.pilotdeck/plugins/bbx-post/plugin.json": {
      "name": "bbx-post",
      "version": "0.1.0",
      "description": "bbx bbx-post",
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs post 0 '' '' 0",
                "if": "bash(case-pass)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"context from post hook\"}}\n' '' 0",
                "if": "bash(case-context)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 2 '' 'post hook blocked\n' 0",
                "if": "bash(case-block)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"decision\":\"block\",\"reason\":\"post json block\"}\n' '' 0",
                "if": "bash(case-json-block)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"unterminated' '' 0",
                "if": "bash(case-garbage)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 3 '' 'post failed\n' 0",
                "if": "bash(case-fail)"
              }
            ]
          },
          {
            "matcher": "write_file",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs post 0 '' '' 0",
                "if": "bash(case-pass)"
              }
            ]
          }
        ],
        "PostToolUseFailure": [
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs post-failure 0 '' '' 0"
              },
              {
                "type": "command",
                "command": "node hook.mjs post-failure 0 '{\"decision\":\"block\",\"reason\":\"ignored\"}\n' '' 0"
              }
            ]
          }
        ]
      }
    },
    "home/.pilotdeck/plugins/bbx-post/hook.mjs": "// bbx hook fixture: node hook.mjs <log> <exit> [stdout] [stderr] [sleepMs]\nimport fs from 'node:fs';\nconst [log, exit = '0', out = '', err = '', sleep = '0'] = process.argv.slice(2);\nconst dir = process.env.HOME + '/hooklog';\nconst append = (row) => { fs.mkdirSync(dir, { recursive: true }); fs.appendFileSync(dir + '/' + log + '.jsonl', JSON.stringify(row) + '\\n'); };\nlet input = '';\nprocess.stdin.on('data', (d) => { input += d; });\nprocess.stdin.on('end', () => {\n  let parsed; try { parsed = JSON.parse(input); } catch { parsed = { raw: input }; }\n  const env = {};\n  for (const k of Object.keys(process.env).sort()) env[k] = /^PILOT/.test(k) && !/BUNDLED/.test(k) ? process.env[k] : true;\n  append({ argv: process.argv.slice(2), cwd: process.cwd(), input: parsed, env });\n  // exit \"@\": the behaviour is the JSON between HOOK<< and >> in the prompt (or the last assistant message).\n  let spec = { exit, out, err, sleep };\n  if (exit === '@') {\n    const m = /HOOK<<(.*?)>>/s.exec(String(parsed.prompt ?? parsed.lastAssistantMessage ?? ''));\n    spec = { exit: 0, out: '', err: '', sleep: 0, ...(m ? JSON.parse(m[1]) : {}) };\n  }\n  setTimeout(() => {\n    append({ argv: process.argv.slice(2), done: true });\n    if (spec.out) process.stdout.write(spec.out);\n    if (spec.err) process.stderr.write(spec.err);\n    process.exit(Number(spec.exit));\n  }, Number(spec.sleep));\n});\n"
  },
  "provider": [
    {
