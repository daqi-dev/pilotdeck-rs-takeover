{
 "name": "submit-turn-params",
 "about": "submit_turn 其余每轮参数各一个会话：syntheticMessages（InProcessGateway.ts:1488-1494，转成带 metadata.synthetic 的用户消息）、allowedTools / disallowedTools（会话工具面）、maxBudgetUsd、modelOverride、modelSelection（model / auto）、trustedContext（pilotdeck server 没有授权器，CAPABILITY_UNAVAILABLE）、telemetry、maxTurns、timeoutMs。比发给 provider 的请求、事件流和会话记录。",
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\": \"Params run\"}"
   }
  },
  {
   "name": "main",
   "reply": {
    "text": "Hello from the mock."
   }
  }
 ],
