{
  "name": "tool-ask-user-question-invalid",
  "about": "ask_user_question：输入校验（重复问题、重复选项、过长 header、预置答案）。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-4-after-tool",
      "when": [
        "turn-4:",
        "\"tool_call_id\":\"call_bbx_4\""
      ],
      "reply": {
        "text": "Done 4."
      }
    },
    {
      "name": "turn-4",
      "when": [
        "turn-4:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_4",
          "name": "ask_user_question",
          "arguments": {
            "questions": [
              {
                "question": "Pre-answered?",
                "header": "A",
                "options": [
                  {
                    "label": "x",
                    "description": "1"
                  },
                  {
                    "label": "y",
                    "description": "2"
                  }
                ]
              }
            ],
            "answers": {
              "Pre-answered?": "x"
            }
          }
        }
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
      }
