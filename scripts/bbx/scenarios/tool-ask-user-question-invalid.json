        "tool": {
          "id": "call_bbx_3",
          "name": "ask_user_question",
          "arguments": {
            "questions": [
              {
                "question": "Too long header?",
                "header": "ABCDEFGHIJKLMNOP",
                "options": [
                  {
                    "label": "x",
                    "description": "1"
                  },
                  {
                    "label": "y",
                    "description": "2"
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "name": "turn-2-after-tool",
