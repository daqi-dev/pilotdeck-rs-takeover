 "steps": [
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-mode",
    "channelKey": "test",
    "runId": "run-m-1",
    "message": "t1: go",
    "mode": "bypassPermissions"
   },
   "answer": [
    {
     "on": {
      "type": "elicitation_request"
     },
     "ws": "elicitation_respond",
     "params": {
      "sessionKey": "s-mode",
      "requestId": "{event.requestId}",
      "answer": {
       "type": "answered",
       "answers": {
        "What should happen next?": [
         "execute_plan"
        ]
       }
      }
     },
     "count": 1
    },
    {
     "on": {
      "type": "permission_request"
     },
     "ws": "permission_decide",
     "params": {
      "sessionKey": "s-mode",
      "requestId": "{event.requestId}",
      "decision": "deny",
      "reason": "bbx denies"
     }
    }
   ],
   "timeout": 20000
