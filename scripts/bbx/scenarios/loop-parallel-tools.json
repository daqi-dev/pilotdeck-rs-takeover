{
  "name": "loop-parallel-tools",
  "about": "一次回复里多个工具调用时的失败与权限询问（agent/modules/capability/hostToolPort.ts:78-108：并发安全的一组先 Promise.all 授权再一起执行，其余一组先逐个授权、再按原顺序串行执行；被拒的调用直接得到权限结果，不进执行；tool/scheduler/ConcurrentToolScheduler.ts）。loop-multi-tool 已覆盖全部成功与两次询问都同意，这里补：q1：并发安全组里 glob 成功、grep 正则非法、glob 的目录不存在，串行组里 read_file 读不存在的文件；q2：两个 write_file 都要询问，第一个拒绝、第二个同意（两次询问都发生在任何执行之前）；q3：要询问的 bash 写文件（同意）+ 并发安全的 glob / grep + 失败的 read_file，看执行先后与结果顺序；q4：两个并发安全的调用都访问工作区外的路径，看是否并行询问，第一个拒绝、第二个同意。",
  "files": {
    "home/.pilotdeck/a.txt": "alpha\n",
    "home/.pilotdeck/b.txt": "beta\n",
    "outside/o.txt": "outside\n"
  },
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\":\"Par\"}" } },
    { "name": "q1-done", "when": ["q1:", "\"tool_call_id\":\"call_q1d\""], "reply": { "text": "q1 done." } },
    { "name": "q1", "when": ["q1:"], "reply": { "text": "Four calls.", "tools": [
      { "id": "call_q1a", "name": "glob", "arguments": { "pattern": "*.txt" } },
      { "id": "call_q1b", "name": "grep", "arguments": { "pattern": "(unclosed" } },
      { "id": "call_q1c", "name": "glob", "arguments": { "pattern": "*", "path": "nodir" } },
      { "id": "call_q1d", "name": "read_file", "arguments": { "file_path": "missing.txt" } }
    ] } },
    { "name": "q2-done", "when": ["q2:", "\"tool_call_id\":\"call_q2b\""], "reply": { "text": "q2 done." } },
    { "name": "q2", "when": ["q2:"], "reply": { "tools": [
      { "id": "call_q2a", "name": "write_file", "arguments": { "file_path": "w1.txt", "content": "one\n" } },
      { "id": "call_q2b", "name": "write_file", "arguments": { "file_path": "w2.txt", "content": "two\n" } }
    ] } },
    { "name": "q3-done", "when": ["q3:", "\"tool_call_id\":\"call_q3d\""], "reply": { "text": "q3 done." } },
    { "name": "q3", "when": ["q3:"], "reply": { "tools": [
      { "id": "call_q3a", "name": "bash", "arguments": { "command": "echo three > q3.txt" } },
      { "id": "call_q3b", "name": "glob", "arguments": { "pattern": "q3*" } },
      { "id": "call_q3c", "name": "grep", "arguments": { "pattern": "alpha", "path": "a.txt" } },
      { "id": "call_q3d", "name": "read_file", "arguments": { "file_path": "nope.txt" } }
    ] } },
    { "name": "q4-done", "when": ["q4:", "\"tool_call_id\":\"call_q4b\""], "reply": { "text": "q4 done." } },
    { "name": "q4", "when": ["q4:"], "reply": { "tools": [
      { "id": "call_q4a", "name": "glob", "arguments": { "pattern": "*.txt", "path": "{ROOT}/outside" } },
      { "id": "call_q4b", "name": "grep", "arguments": { "pattern": "outside", "path": "{ROOT}/outside" } }
    ] } }
  ],
  "steps": [
    { "ws": "submit_turn", "params": { "sessionKey": "s-q1", "channelKey": "test", "message": "q1: mixed failures" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-q1" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-q2", "channelKey": "test", "message": "q2: two writes" }, "timeout": 30000,
      "answer": [
        { "on": { "type": "permission_request" }, "ws": "permission_decide", "params": { "sessionKey": "s-q2", "requestId": "{event.requestId}", "decision": "deny" }, "count": 1 },
        { "on": { "type": "permission_request" }, "ws": "permission_decide", "params": { "sessionKey": "s-q2", "requestId": "{event.requestId}", "decision": "allow" } }
      ] },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-q2" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-q3", "channelKey": "test", "message": "q3: write and look" }, "timeout": 30000,
      "answer": [
        { "on": { "type": "permission_request" }, "ws": "permission_decide", "params": { "sessionKey": "s-q3", "requestId": "{event.requestId}", "decision": "allow" } }
      ] },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-q3" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-q4", "channelKey": "test", "message": "q4: outside" }, "timeout": 30000,
      "answer": [
        { "on": { "type": "permission_request" }, "ws": "permission_decide", "params": { "sessionKey": "s-q4", "requestId": "{event.requestId}", "decision": "deny" }, "count": 1 },
        { "on": { "type": "permission_request" }, "ws": "permission_decide", "params": { "sessionKey": "s-q4", "requestId": "{event.requestId}", "decision": "allow" } }
      ] },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-q4" } }
  ]
}
