{
  "name": "permission-allow-edit-file",
  "about": "edit_file：默认权限模式下先 read_file（只读，不询问），再 edit_file → 询问 → 批准 → 执行。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "edit_file",
          "arguments": {
            "file_path": "{PILOT_HOME}/notes/old.txt",
            "old_string": "beta",
            "new_string": "BETA"
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "read_file",
          "arguments": {
            "file_path": "{PILOT_HOME}/notes/old.txt"
          }
        }
      }
    }
  ],
  "files": {
    "home/.pilotdeck/notes/old.txt": "alpha\nbeta\ngamma\n"
  },
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      },
      "timeout": 15000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-2: run the tool"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-bbx-1",
            "requestId": "{event.requestId}",
            "decision": "allow"
          }
        }
      ],
      "timeout": 15000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ]
}
