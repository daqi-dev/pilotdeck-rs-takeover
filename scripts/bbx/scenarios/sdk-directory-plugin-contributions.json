      "path": "/provider/a-final/1",
      "exists": false
    },
    {
      "id": "b-initial-model",
      "path": "/provider/b-initial/0/body/model",
      "equals": "deterministic"
    },
    {
      "id": "b-initial-unique",
      "path": "/provider/b-initial/1",
      "exists": false
    },
    {
      "id": "b-final-model",
      "path": "/provider/b-final/0/body/model",
