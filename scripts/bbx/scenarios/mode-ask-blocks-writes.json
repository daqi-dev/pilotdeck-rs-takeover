{
  "name": "mode-ask-blocks-writes",
  "about": "runMode=ask（只读问答模式）且权限模式 bypassPermissions 时，工具运行时在 schema 校验与权限判断之前按 ASK_MODE_ALLOWED_TOOLS 拦截（ToolRuntime.ts:141-150；askModeConstraints.ts），bypassPermissions 解不开：白名单外的工具（write_file、todo_write、edit_file；参数不合 schema 时也先报 ask_mode_violation）被拦；bash 非只读命令被拦，只读命令（pwd）放行；execute_code 在白名单里，但脚本调用 write_file 时 isReadOnly 为假，被拦；只读脚本放行。采集器对任何权限询问一律拒绝。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-7-after-tool",
      "when": [
        "turn-7:",
        "\"tool_call_id\":\"call_bbx_7\""
      ],
      "reply": {
        "text": "Done 7."
      }
    },
    {
      "name": "turn-7",
      "when": [
        "turn-7:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_7",
          "name": "edit_file",
          "arguments": {}
        }
      }
    },
    {
      "name": "turn-6-after-tool",
      "when": [
        "turn-6:",
        "\"tool_call_id\":\"call_bbx_6\""
      ],
      "reply": {
        "text": "Done 6."
      }
    },
    {
      "name": "turn-6",
      "when": [
        "turn-6:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_6",
          "name": "todo_write",
          "arguments": {
            "todos": []
          }
        }
      }
    },
    {
      "name": "turn-5-after-tool",
      "when": [
        "turn-5:",
        "\"tool_call_id\":\"call_bbx_5\""
      ],
      "reply": {
        "text": "Done 5."
      }
    },
    {
      "name": "turn-5",
      "when": [
        "turn-5:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_5",
          "name": "execute_code",
          "arguments": {
            "code": "print('read only ok')\n"
          }
        }
      }
    },
    {
      "name": "turn-4-after-tool",
      "when": [
        "turn-4:",
        "\"tool_call_id\":\"call_bbx_4\""
      ],
      "reply": {
        "text": "Done 4."
      }
    },
    {
      "name": "turn-4",
      "when": [
        "turn-4:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_4",
          "name": "execute_code",
          "arguments": {
            "code": "from pilotdeck_tools import write_file\nwrite_file('{PILOT_HOME}/askmode-rpc.txt', 'x')\n"
          }
        }
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
      }
    },
    {
      "name": "turn-3",
      "when": [
        "turn-3:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_3",
          "name": "bash",
          "arguments": {
            "command": "pwd"
          }
        }
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "bash",
          "arguments": {
            "command": "touch {PILOT_HOME}/askmode-bash.txt"
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "write_file",
          "arguments": {
            "file_path": "{PILOT_HOME}/askmode-write.txt",
            "content": "written in ask run mode\n"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-bbx-1",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool",
        "runMode": "ask"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-bbx-1",
            "requestId": "{event.requestId}",
            "decision": "deny",
            "reason": "bbx denies every prompt"
          }
        }
      ],
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
