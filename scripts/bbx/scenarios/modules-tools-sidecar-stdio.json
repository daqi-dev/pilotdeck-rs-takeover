  },
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-t14",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-t14",
    "channelKey": "test",
    "message": "t14: go"
   },
   "timeout": 60000
