        "tool": {
          "id": "call_bbx_1",
          "name": "bash",
          "arguments": {
            "command": "mkdir -p {PROJECT}/outside && printf 'TOPSECRET\\n' > {PROJECT}/outside/secret.txt && ln -s {PROJECT}/outside {PILOT_HOME}/link-out && ln -s {PROJECT}/outside/secret.txt {PILOT_HOME}/secret-link.txt && echo ok"
          }
        }
      }
    }
