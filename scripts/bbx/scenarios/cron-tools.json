{
  "name": "cron-tools",
  "about": "cron 开启时普通会话里的 cron_* 工具（结果里不含服务端随机 id 的那些）：声明、非法表达式、多余参数、缺参数、列表、更新的时区非法与版本冲突、立即运行找不到、停止未在运行的任务、删除与重复删除，以及 tasks.json 落盘。",
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ncron:\n  enabled: true\n",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Cron tools\"}"
      }
    },
    {
      "name": "cron-fired",
      "when": [
        "cron-fired-msg"
      ],
      "unless": [
        "bbx-main-session"
      ],
      "reply": {
        "text": "Fired."
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "cron_create",
          "arguments": {
            "message": "bad expr",
            "schedule": {
              "type": "cron",
              "expression": "not a cron"
            }
          }
        }
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "cron_create",
          "arguments": {
            "message": "extra",
            "schedule": {
              "type": "delay",
              "amount": 1,
              "unit": "hour"
            },
            "bogus": true
          }
        }
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
