{
 "name": "tool-knowledge-query-credential",
 "about": "knowledge_query 绑定带 credentialEnv（parseModulesConfig.ts:165-180，HttpModuleClient.ts:43-58，domainPorts.ts:134-160）：只读凭据从服务端环境变量取、去空白后作 Bearer 头发出；宿主不再并入 tenantId / agentId；模型输入里带身份字段（tenant_id、agentId、modelConfigId）时拒绝且不发请求。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\nmodules:\n  knowledge:\n    enabled: true\n    implementationId: staffdeck.knowledge\n    contract: staffdeck.knowledge/v1\n    transport: module-http-v2\n    endpoint: {MOCK}/kb\n    manifestPath: /api/v1/knowledge-module/module-manifest\n    callPath: /api/v1/agents/agent-1/knowledge-module/v2/module/call\n    methods:\n      - query\n    agentId: agent-1\n    credentialEnv: BBX_KB_TOKEN\n",
 "env": {
  "BBX_KB_TOKEN": "  secret-token  "
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\": \"Tool run\"}"
   }
  },
  {
   "name": "kb-manifest",
   "unless": [
    "\""
   ],
   "reply": {
    "status": 200,
    "body": {
     "protocolVersion": "2.0",
     "implementationId": "staffdeck.knowledge",
     "contract": "staffdeck.knowledge/v1",
     "transport": "module-http-v2",
     "methods": [
      "query",
      "list_bases"
     ]
    }
   }
  },
  {
   "name": "kb-ok",
   "when": [
    "\"method\":\"module_call\"",
    "what is bbx"
   ],
   "reply": {
    "status": 200,
    "body": {
     "kind": "response",
     "messageId": "kb-resp-1",
     "inReplyTo": "module-http-1",
     "requestId": "knowledge-query-1",
     "ok": true,
     "payload": {
      "result": {
       "answer": "bbx is a black-box diff",
       "citations": [
        {
         "id": "c1",
         "title": "README"
        }
       ]
      }
     }
    }
   }
  },
  {
   "name": "q04-after",
   "when": [
    "q04:",
    "\"tool_call_id\":\"call_q04\""
   ],
   "reply": {
    "text": "Done 04."
   }
  },
  {
   "name": "q04",
   "when": [
    "q04:"
   ],
   "reply": {
    "tool": {
     "id": "call_q04",
     "name": "knowledge_query",
     "arguments": {
      "query": "pick model",
      "modelConfigId": "m"
     }
    }
   }
  },
  {
   "name": "q03-after",
   "when": [
    "q03:",
    "\"tool_call_id\":\"call_q03\""
   ],
   "reply": {
    "text": "Done 03."
   }
  },
  {
   "name": "q03",
   "when": [
    "q03:"
   ],
   "reply": {
    "tool": {
     "id": "call_q03",
     "name": "knowledge_query",
     "arguments": {
      "query": "who am i",
      "agentId": "agent-1"
     }
    }
   }
  },
  {
   "name": "q02-after",
   "when": [
    "q02:",
    "\"tool_call_id\":\"call_q02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "q02",
   "when": [
    "q02:"
   ],
   "reply": {
    "tool": {
     "id": "call_q02",
     "name": "knowledge_query",
     "arguments": {
      "query": "who am i",
      "tenant_id": "t-x"
     }
    }
   }
  },
  {
   "name": "q01-after",
   "when": [
    "q01:",
    "\"tool_call_id\":\"call_q01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "q01",
   "when": [
    "q01:"
   ],
   "reply": {
    "tool": {
     "id": "call_q01",
     "name": "knowledge_query",
     "arguments": {
      "query": "what is bbx",
      "top_k": 3
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-kc",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-kc",
    "channelKey": "test",
    "message": "q01: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-kc",
    "channelKey": "test",
    "message": "q02: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-kc",
    "channelKey": "test",
    "message": "q03: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-kc",
    "channelKey": "test",
    "message": "q04: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "read_session_messages",
   "params": {
    "sessionKey": "s-kc"
   }
  }
 ]
}
