{
  "name": "server-local-token-origin",
  "about": "回环监听上 /auth/local-token 的来源检查。第 0、1 步：回环 Host（采集器固定从 127.0.0.1 发出）不带 Origin、或带回环 Origin（http://localhost:3001），两侧都返回 token。第 2、3 步：带外部 Origin（http://evil.example:38411）或 Origin: null，基线照样返回 token，Rust 有意按基线对非回环监听的形式回 404 not found——这是基线的 DNS 重绑定问题（GatewayServer.ts:103-112 对回环监听上的任何请求都给 token），登记为 accepted。第 4 步：/health 带外部 Origin 两侧照常 200，说明检查只在这一条路由上。外部 Host 的拒绝采集器发不出来（fetch 不许改 Host），由 native_http 的单元测试覆盖。",
  "volatile": [
    "\\.http\\.headers\\.date$"
  ],
  "accepted": [
    {
      "id": "local-token-dns-rebinding",
      "why": "基线自身的安全问题：回环监听上 /auth/local-token 不看 Host / Origin（GatewayServer.ts:103-112），恶意网页经 DNS 重绑定同源读到 token。Rust 对外部 Origin（含 null）按基线对非回环监听的既有形式回 404 not found",
      "paths": [
        "^\\$\\.steps\\[[23]\\]\\.http\\.(status|body|headers\\.content-type)$"
      ],
      "assertions": [
        "local-token-step0-status",
        "local-token-step0-body",
        "local-token-step0-headers-content-type",
        "local-token-step1-status",
        "local-token-step1-body",
        "local-token-step1-headers-content-type",
        "local-token-step2-status",
        "local-token-step2-body",
        "local-token-step2-headers-content-type",
        "local-token-step3-status",
        "local-token-step3-body",
        "local-token-step3-headers-content-type",
        "local-token-step4-status",
        "local-token-step4-body"
      ]
    }
  ],
  "steps": [
    {
      "http": "GET /auth/local-token"
    },
    {
      "http": "GET /auth/local-token",
      "headers": {
        "origin": "http://localhost:3001"
      }
    },
    {
      "http": "GET /auth/local-token",
      "headers": {
        "origin": "http://evil.example:38411"
      }
    },
    {
      "http": "GET /auth/local-token",
      "headers": {
        "origin": "null"
      }
    },
    {
      "http": "GET /health",
      "headers": {
        "origin": "http://evil.example:38411"
      }
    }
  ],
  "assertions": [
    {
      "id": "local-token-step0-status",
      "sides": [
        "rust"
      ],
      "path": "/steps/0/http/status",
      "equals": 200
    },
    {
      "id": "local-token-step0-body",
      "sides": [
        "rust"
      ],
      "path": "/steps/0/http/body",
      "equals": {
        "token": "bbx-token"
      }
    },
    {
      "id": "local-token-step0-headers-content-type",
      "sides": [
        "rust"
      ],
      "path": "/steps/0/http/headers/content-type",
      "equals": "application/json"
    },
    {
      "id": "local-token-step1-status",
      "sides": [
        "rust"
      ],
      "path": "/steps/1/http/status",
      "equals": 200
    },
    {
      "id": "local-token-step1-body",
      "sides": [
        "rust"
      ],
      "path": "/steps/1/http/body",
      "equals": {
        "token": "bbx-token"
      }
    },
    {
      "id": "local-token-step1-headers-content-type",
      "sides": [
        "rust"
      ],
      "path": "/steps/1/http/headers/content-type",
      "equals": "application/json"
    },
    {
      "id": "local-token-step2-status",
      "sides": [
        "rust"
      ],
      "path": "/steps/2/http/status",
      "equals": 404
    },
    {
      "id": "local-token-step2-body",
      "sides": [
        "rust"
      ],
      "path": "/steps/2/http/body",
      "equals": "not found"
    },
    {
      "id": "local-token-step2-headers-content-type",
      "sides": [
        "rust"
      ],
      "path": "/steps/2/http/headers/content-type",
      "equals": "text/plain; charset=utf-8"
    },
    {
      "id": "local-token-step3-status",
      "sides": [
        "rust"
      ],
      "path": "/steps/3/http/status",
      "equals": 404
    },
    {
      "id": "local-token-step3-body",
      "sides": [
        "rust"
      ],
      "path": "/steps/3/http/body",
      "equals": "not found"
    },
    {
      "id": "local-token-step3-headers-content-type",
      "sides": [
        "rust"
      ],
      "path": "/steps/3/http/headers/content-type",
      "equals": "text/plain; charset=utf-8"
    },
    {
      "id": "local-token-step4-status",
      "sides": [
        "rust"
      ],
      "path": "/steps/4/http/status",
      "equals": 200
    },
    {
      "id": "local-token-step4-body",
      "sides": [
        "rust"
      ],
      "path": "/steps/4/http/body",
      "equals": {
        "ok": true
      }
    }
  ]
}
