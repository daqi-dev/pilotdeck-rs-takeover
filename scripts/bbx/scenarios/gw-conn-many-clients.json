{
  "name": "gw-conn-many-clients",
  "about": "同时连着很多客户端：基线对连接数没有上限（GatewayServer.ts:62-71 用 node:http 缺省选项，没设 maxConnections；连接只放进一个 Set，170-171），100 条同时在线的 WS 连接都能握手拿到 hello_ok，期间 /health、/api/web 和已有连接上的请求照常应答，放掉之后照常。",
  "volatile": [
    "\\.http\\.headers\\.date$"
  ],
  "steps": [
    {
      "ws": "describe_server",
      "params": {}
    },
    {
      "flood": 100
    },
    {
      "http": "GET /health"
    },
    {
      "http": "GET /api/web/projects",
      "headers": {
        "authorization": "Bearer {TOKEN}"
      }
    },
    {
      "ws": "list_sessions",
      "params": {}
    },
    {
      "ws": "describe_server",
      "params": {}
    },
    {
      "flood": "release"
    },
    {
      "flood": 30
    },
    {
      "http": "GET /health"
    },
    {
      "flood": "release"
    }
  ]
}
