ryId\":\"m-5\",\"parentEntryId\":\"m-4\"}\n{\"type\":\"session_metadata\",\"metadata\":{\"gitBranch\":\"feature/later\",\"updatedAt\":\"2026-11-01T00:00:06.000Z\"},\"sessionId\":\"s-meta\",\"turnId\":\"seed-turn-1\",\"sequence\":6,\"createdAt\":\"2026-11-01T00:00:06.000Z\",\"entryId\":\"m-6\",\"parentEntryId\":\"m-5\"}\n"
