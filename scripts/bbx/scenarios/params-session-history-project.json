{
  "name": "params-session-history-project",
  "about": "会话读写类 method 的可选参数 projectKey（tag_session / record_agent_status_message / fork_session / replace_last_turn / finalize_last_turn_replacement / restore_session_transcript）与 read_session_messages.direction：projectKey 取会话所在的已登记项目、另一个已登记项目、未登记目录、空串、数字；record_agent_status_message 另比不在内存里的会话（走落盘路径）；direction 取 backward / forward / 非法串 / 数字。比较响应与落盘。",
  "files": {
    "home/work/alpha/README.md": "alpha\n",
    "home/.pilotdeck/projects/private-tmp-pdrs-bbx-root-home-work-alpha/.cwd": "{HOME}/work/alpha\n",
    "home/work/beta/README.md": "beta\n",
    "home/.pilotdeck/projects/private-tmp-pdrs-bbx-root-home-work-beta/.cwd": "{HOME}/work/beta\n"
  },
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Params run\"}" } },
    { "name": "main", "reply": { "text": "Answer." } }
  ],
  "steps": [
    { "ws": "submit_turn", "params": { "sessionKey": "s-pk", "channelKey": "test", "projectKey": "{HOME}/work/alpha", "runId": "run-1", "message": "pk-1: first" }, "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-pk", "channelKey": "test", "projectKey": "{HOME}/work/alpha", "runId": "run-2", "message": "pk-2: second" }, "timeout": 20000 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/alpha", "direction": "backward" }, "save": { "first": "\"text\":\"pk-1: first\",\"entryId\":\"([0-9a-f-]{36})\"" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/alpha", "direction": "forward", "limit": 1 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/alpha", "direction": "backward", "limit": 1, "cursor": "1" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/alpha", "direction": "sideways", "limit": 1 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/alpha", "direction": 5 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/beta" } },
    { "ws": "tag_session", "params": { "sessionKey": "s-pk", "value": "tag-beta-live", "projectKey": "{HOME}/work/beta" } },
    { "ws": "close_session", "params": { "sessionKey": "s-pk" } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-pk", "turnId": "run-2", "projectKey": 123, "status": { "event": "note", "kind": "info", "text": "closed num key" } } },
    { "ws": "tag_session", "params": { "sessionKey": "s-tag", "value": "tag-alpha", "projectKey": "{HOME}/work/alpha" } },
    { "ws": "tag_session", "params": { "sessionKey": "s-tag-b", "value": "tag-beta" } },
    { "ws": "tag_session", "params": { "sessionKey": "s-tag-u", "value": "tag-unreg", "projectKey": "{PROJECT}" } },
    { "ws": "tag_session", "params": { "sessionKey": "s-tag-e", "value": "tag-empty", "projectKey": "" } },
    { "ws": "tag_session", "params": { "sessionKey": "s-tag-n", "value": "tag-num", "projectKey": 123 } },
    { "ws": "tag_session", "params": { "sessionKey": "s-tag-o", "value": "tag-obj", "projectKey": {} } },
    { "ws": "list_sessions", "params": { "projectKey": "{HOME}/work/alpha" } },
    { "ws": "fork_session", "params": { "sessionKey": "s-pk", "fromEntryId": "{saved.first}", "projectKey": "{HOME}/work/beta" } },
    { "ws": "fork_session", "params": { "sessionKey": "s-pk", "fromEntryId": "{saved.first}", "projectKey": "" } },
    { "ws": "fork_session", "params": { "sessionKey": "s-pk", "fromEntryId": "{saved.first}", "projectKey": 123 } },
    { "ws": "fork_session", "params": { "sessionKey": "s-pk", "fromEntryId": "{saved.first}", "projectKey": "{HOME}/work/alpha" }, "save": { "forked": "\"newSessionKey\":\"([^\"]+)\"" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "{saved.forked}", "projectKey": "{HOME}/work/alpha" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-pk", "expectedTurnId": "run-2", "replacementTurnId": "run-3", "projectKey": "{HOME}/work/beta" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-pk", "expectedTurnId": "run-2", "replacementTurnId": "run-3", "projectKey": "" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-pk", "expectedTurnId": "run-2", "replacementTurnId": "run-3", "projectKey": 123 } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-pk", "expectedTurnId": "run-2", "replacementTurnId": "run-3", "projectKey": "{HOME}/work/alpha" }, "save": { "tx": "\"transactionId\":\"([0-9a-f-]{36})\"" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-pk", "transactionId": "{saved.tx}", "action": "rollback", "projectKey": "{HOME}/work/beta" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-pk", "transactionId": "{saved.tx}", "action": "rollback", "projectKey": 123 } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-pk", "transactionId": "{saved.tx}", "action": "rollback", "projectKey": "{HOME}/work/alpha" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-pk", "projectKey": "{HOME}/work/alpha" } },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-rs-a", "projectKey": "{HOME}/work/alpha", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "title": "Alpha chat", "messages": [{ "role": "user", "text": "in alpha" }, { "role": "assistant", "text": "ok alpha" }] } } },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-rs-b", "projectKey": "{HOME}/work/beta", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "messages": [{ "role": "user", "text": "in beta" }] } } },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-rs-none", "projectKey": "{ROOT}/nowhere", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "messages": [{ "role": "user", "text": "nowhere" }] } } },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-rs-empty", "projectKey": "", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "messages": [{ "role": "user", "text": "empty key" }] } } },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-rs-num", "projectKey": 123, "archive": { "schemaVersion": 1, "format": "portable_text_messages", "messages": [{ "role": "user", "text": "num key" }] } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-rs-a", "turnId": "t-a", "projectKey": "{HOME}/work/alpha", "status": { "event": "note", "kind": "info", "text": "alpha cold" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-rs-b", "turnId": "t-b", "projectKey": "{HOME}/work/alpha", "status": { "event": "note", "kind": "info", "text": "beta session via alpha" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-rs-c", "turnId": "t-c", "projectKey": "{PROJECT}/sub", "status": { "event": "note", "kind": "info", "text": "unregistered dir" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-rs-d", "turnId": "t-d", "projectKey": "", "status": { "event": "note", "kind": "info", "text": "empty key" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-rs-e", "turnId": "t-e", "projectKey": 123, "status": { "event": "note", "kind": "info", "text": "num key" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-pk", "turnId": "run-2", "projectKey": 123, "status": { "event": "note", "kind": "info", "text": "live num key" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-cwd", "turnId": "t-cwd", "projectKey": "{PROJECT}", "status": { "event": "note", "kind": "info", "text": "server cwd project" } } },
    { "ws": "record_agent_status_message", "params": { "sessionKey": "s-rs-f", "turnId": "t-f", "projectKey": 0, "status": { "event": "note", "kind": "info", "text": "zero key" } } },
    { "ws": "fork_session", "params": { "sessionKey": "s-cwd", "fromEntryId": "no-such-entry", "projectKey": "" } },
    { "ws": "fork_session", "params": { "sessionKey": "s-cwd", "fromEntryId": "no-such-entry", "projectKey": null } },
    { "ws": "fork_session", "params": { "sessionKey": "s-cwd", "fromEntryId": "no-such-entry", "projectKey": false } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-cwd", "expectedTurnId": "t-cwd", "replacementTurnId": "t-new", "projectKey": [] } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-cwd", "transactionId": "00000000-0000-4000-8000-000000000000", "action": "commit", "projectKey": "" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-cwd", "transactionId": "00000000-0000-4000-8000-000000000000", "action": "rollback", "projectKey": "" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-cwd", "transactionId": "00000000-0000-4000-8000-000000000000", "action": "rollback", "projectKey": 0 } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-rs-a", "projectKey": "{HOME}/work/alpha" } },
    { "ws": "list_sessions", "params": { "projectKey": "{HOME}/work/alpha" } },
    { "ws": "list_sessions", "params": { "projectKey": "{HOME}/work/beta" } }
  ]
}
