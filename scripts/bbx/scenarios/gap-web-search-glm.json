   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g03: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g04: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
