{
  "name": "cli-cron-online-list",
  "about": "cron list 连上 server（src/cli/pilotdeck.ts:370-376）：cronList({ includeHistory: argv.includes('--history'), limit: readNumberFlag('--limit') })，readNumberFlag 是 parseInt(值, 10)，NaN 时不传；值以 -- 开头或为空时当没给（readStringFlag，pilotdeck.ts:527-534）。结果 JSON.stringify(result, null, 2) 打到 stdout。先用 WS 建三个任务、对其中一个 run_now 三次（写三条运行历史；limit 只截运行历史），再看 list / --history / 各种 --limit。基线 CLI 连上 server 后 WebSocket 不关，输出完不退出（挂起，疑似基线 bug，见报告），这类步骤声明 expectTimeout；最后 stopServer SIGKILL：被杀掉的 CLI 只发 FIN 不发关闭帧，基线 server 的 WebSocket 不处理半关闭（src/gateway/server/websocket.ts:19-20 只听 close / error），SIGTERM 后 server.close() 永远等不完（另一处挂起，见报告），所以用 SIGKILL 统一收尾，停机行为不在这些场景里比。",
  "gatewayPort": 18789,
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ncron:\n  enabled: true\n",
  "files": {
    "home/.pilotdeck/server-token": "bbx-token\n",
    "home/.pilotdeck/projects/tmp-pdrs-bbx-root-proj/.cwd": "{PROJECT}\n"
  },
  "env": {
    "DOCKER_CONTAINER": "1",
    "COMMIT_HASH": "bbx"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Cron\"}"
      }
    },
    {
      "name": "main",
      "reply": {
        "text": "Cron ran."
      }
    }
  ],
  "steps": [
    {
      "cli": [
        "cron",
        "list"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "ws": "cron_create",
      "params": {
        "projectKey": "{PROJECT}",
        "message": "alpha task",
        "schedule": {
          "type": "cron",
          "expression": "0 9 * * *"
        }
      }
    },
    {
      "ws": "cron_create",
      "params": {
        "projectKey": "{PROJECT}",
        "message": "beta task",
        "schedule": {
          "type": "once",
          "runAt": "2099-01-02T03:04:05.000Z"
        }
      }
    },
    {
      "ws": "cron_create",
      "params": {
        "projectKey": "{PROJECT}",
        "message": "gamma task",
        "schedule": {
          "type": "cron",
          "expression": "30 8 * * 1-5"
        }
      },
      "save": {
        "g": "taskId\\W+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
      }
    },
    {
      "ws": "cron_run_now",
      "params": {
        "taskId": "{saved.g}",
        "projectKey": "{PROJECT}"
      }
    },
    {
      "sleep": 3000
    },
    {
      "ws": "cron_run_now",
      "params": {
        "taskId": "{saved.g}",
        "projectKey": "{PROJECT}"
      }
    },
    {
      "sleep": 3000
    },
    {
      "ws": "cron_run_now",
      "params": {
        "taskId": "{saved.g}",
        "projectKey": "{PROJECT}"
      }
    },
    {
      "sleep": 3000
    },
    {
      "cli": [
        "cron",
        "list"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--limit",
        "1"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "1"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "abc"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "0"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "-1"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "2x"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        " 2"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "1.9"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "+1"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        "99999999999999999999"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--limit",
        "--history"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "--history",
        "--limit",
        ""
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
        "cron",
        "list",
        "extra",
        "words",
        "--HISTORY"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "stopServer": "SIGKILL"
    }
  ]
}
