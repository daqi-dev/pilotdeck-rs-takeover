{
  "name": "tool-web-fetch",
  "about": "web_fetch（bypassPermissions）只走本机：参数校验（缺 url、单段主机名、带凭据、超长、mode 非法、llm 缺 prompt）与对本机假 provider 的抓取（http 升级为 https 后对明文端口握手失败）。成功路径需要本机 HTTPS 服务，采集器暂无。",
  "files": {},
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-9-after-tool",
      "when": [
        "turn-9:",
        "\"tool_call_id\":\"call_bbx_9\""
      ],
      "reply": {
        "text": "Done 9."
      }
    },
    {
      "name": "turn-9",
      "when": [
        "turn-9:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_9",
          "name": "web_fetch",
          "arguments": {
            "url": "{MOCK}/page",
            "prompt": "summarize"
          }
        }
      }
    },
    {
      "name": "turn-8-after-tool",
      "when": [
        "turn-8:",
        "\"tool_call_id\":\"call_bbx_8\""
