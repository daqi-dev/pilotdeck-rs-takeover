{
  "name": "abort-tool-agent",
  "about": "中止落在一次性子代理（agent 工具）执行中，子代理的模型请求还没回（3 秒）：abort_turn、close_session、timeoutMs。比较子代理事件（subagent_started / subagent_completed）、PostToolUseFailure 与 SubagentStop hook、帧、会话与子代理记录、下一轮。",
  "files": {
    "home/.pilotdeck/plugins/bbx-abort/plugin.json": {
      "name": "bbx-abort",
      "version": "0.1.0",
      "description": "bbx bbx-abort",
      "hooks": {
        "PostToolUseFailure": [
          {
            "matcher": "agent",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs post-failure 0 '' '' 0"
              }
            ]
          }
        ],
        "SubagentStop": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs subagent-stop 0 '' '' 0"
              }
            ]
          }
        ]
      }
    },
    "home/.pilotdeck/plugins/bbx-abort/hook.mjs": "// bbx hook fixture: node hook.mjs <log> <exit> [stdout] [stderr] [sleepMs]\nimport fs from 'node:fs';\nconst [log, exit = '0', out = '', err = '', sleep = '0'] = process.argv.slice(2);\nconst dir = process.env.HOME + '/hooklog';\nconst append = (row) => { fs.mkdirSync(dir, { recursive: true }); fs.appendFileSync(dir + '/' + log + '.jsonl', JSON.stringify(row) + '\\n'); };\nlet input = '';\nprocess.stdin.on('data', (d) => { input += d; });\nprocess.stdin.on('end', () => {\n  let parsed; try { parsed = JSON.parse(input); } catch { parsed = { raw: input }; }\n  const keep = {};\n  for (const k of ['hook_event_name', 'hookEventName', 'tool_name', 'toolName', 'error', 'isInterrupt', 'is_interrupt', 'prompt', 'reason', 'stopHookActive']) if (k in parsed) keep[k] = parsed[k];\n  append({ argv: process.argv.slice(2), input: keep });\n  setTimeout(() => {\n    append({ argv: process.argv.slice(2), done: true });\n    if (out) process.stdout.write(out);\n    if (err) process.stderr.write(err);\n    process.exit(Number(exit));\n  }, Number(sleep));\n});\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Abort run\"}"
      }
    },
    {
      "name": "child-ta-run",
      "when": [
        "CHILD-ta-run"
      ],
      "reply": {
        "text": "Scope: x.\nResult: y.\nKey files: none\nFiles changed: none\nIssues: none",
        "delayMs": 3000
      }
    },
    {
      "name": "child-ta-close",
      "when": [
        "CHILD-ta-close"
      ],
      "reply": {
        "text": "Scope: x.\nResult: y.\nKey files: none\nFiles changed: none\nIssues: none",
        "delayMs": 3000
      }
    },
    {
      "name": "child-ta-timeout",
      "when": [
        "CHILD-ta-timeout"
      ],
      "reply": {
        "text": "Scope: x.\nResult: y.\nKey files: none\nFiles changed: none\nIssues: none",
        "delayMs": 3000
      }
    },
    {
      "name": "next-ta-run",
      "when": [
        "next-ta-run:"
      ],
      "reply": {
        "text": "Next ta-run."
      }
    },
    {
      "name": "ta-run-after",
      "when": [
        "ta-run:",
        "\"tool_call_id\":\"call_ta_run\""
      ],
      "reply": {
        "text": "Done ta-run."
      }
    },
    {
      "name": "ta-run",
      "when": [
        "ta-run:"
      ],
      "reply": {
        "tool": {
          "id": "call_ta_run",
          "name": "agent",
          "arguments": {
            "description": "Look",
            "prompt": "CHILD-ta-run: look.",
            "subagent_type": "general-purpose"
          }
        }
      }
    },
    {
      "name": "next-ta-close",
      "when": [
        "next-ta-close:"
      ],
      "reply": {
        "text": "Next ta-close."
      }
    },
    {
      "name": "ta-close-after",
      "when": [
        "ta-close:",
        "\"tool_call_id\":\"call_ta_close\""
      ],
      "reply": {
        "text": "Done ta-close."
      }
    },
    {
      "name": "ta-close",
      "when": [
        "ta-close:"
      ],
      "reply": {
        "tool": {
          "id": "call_ta_close",
          "name": "agent",
          "arguments": {
            "description": "Look",
            "prompt": "CHILD-ta-close: look.",
            "subagent_type": "general-purpose"
          }
        }
      }
    },
    {
      "name": "next-ta-timeout",
      "when": [
        "next-ta-timeout:"
      ],
      "reply": {
        "text": "Next ta-timeout."
      }
    },
    {
      "name": "ta-timeout-after",
      "when": [
        "ta-timeout:",
        "\"tool_call_id\":\"call_ta_timeout\""
      ],
      "reply": {
        "text": "Done ta-timeout."
      }
    },
    {
      "name": "ta-timeout",
      "when": [
        "ta-timeout:"
      ],
      "reply": {
        "tool": {
          "id": "call_ta_timeout",
          "name": "agent",
          "arguments": {
            "description": "Look",
            "prompt": "CHILD-ta-timeout: look.",
            "subagent_type": "general-purpose"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-ta-run",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-ta-run",
        "channelKey": "test",
        "runId": "run-ta-run",
        "message": "ta-run: go"
      },
      "timeout": 20000,
      "answer": [
        {
          "on": {
            "type": "tool_call_started",
            "name": "agent"
          },
          "ws": "abort_turn",
          "params": {
            "sessionKey": "s-ta-run",
            "runId": "run-ta-run"
          },
          "count": 1
        }
      ]
    },
    {
      "sleep": 3500
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-ta-run",
        "channelKey": "test",
        "message": "next-ta-run: again"
      },
      "timeout": 20000
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-ta-close",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-ta-close",
        "channelKey": "test",
        "message": "ta-close: go"
      },
      "timeout": 20000,
      "answer": [
        {
          "on": {
            "type": "tool_call_started",
            "name": "agent"
          },
          "ws": "close_session",
          "params": {
            "sessionKey": "s-ta-close"
          },
          "count": 1
        }
      ]
    },
    {
      "sleep": 3500
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-ta-close",
        "channelKey": "test",
        "message": "next-ta-close: again"
      },
      "timeout": 20000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-ta-run"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-ta-close"
      }
    }
  ]
}
