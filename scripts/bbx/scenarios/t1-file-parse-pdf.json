{
  "name": "t1-file-parse-pdf",
  "about": "正式公共HTTP file_parse成功返回固定PDF全文和准确metadata；损坏PDF明确422。",
  "env": {
    "PILOTDECK_PDF_TOOL": "{PDF_TOOL}"
  },
  "steps": [
    {
      "http": "POST /api/module-host/call",
      "headers": {
        "authorization": "Bearer {TOKEN}"
      },
      "body": {
        "principal": {
          "pilotDeckUserId": "u",
          "tenantId": "t",
          "actorUserId": "a",
          "agentId": "g"
        },
        "operation": "file_parse",
        "input": {
          "filename": "normal.pdf",
          "content_base64": ""
        }
      }
    },
    {
      "http": "POST /api/module-host/call",
      "headers": {
        "authorization": "Bearer {TOKEN}"
      },
      "body": {
        "principal": {
          "pilotDeckUserId": "u",
          "tenantId": "t",
          "actorUserId": "a",
          "agentId": "g"
        },
        "operation": "file_parse",
        "input": {
          "filename": "bad.pdf",
          "content_base64": "bm90IGEgcGRm"
        }
      }
    }
  ],
  "assertions": [
    {
      "id": "pdf-status",
      "path": "/steps/0/http/status",
      "equals": 200
    },
    {
      "id": "pdf-response",
      "path": "/steps/0/http/body",
      "equals": {
        "filename": "normal.pdf",
        "text": "PilotDeck native PDF\n\n",
        "mediaType": "application/pdf",
        "metadata": {
          "fileType": "pdf",
          "bytes": 594
        }
      }
    },
    {
      "id": "bad-pdf-status",
      "path": "/steps/1/http/status",
      "equals": 422
    },
    {
      "id": "bad-pdf-code",
      "path": "/steps/1/http/body/code",
      "equals": "PUBLIC_FILE_PARSE_FAILED"
    },
    {
      "id": "http-date-0",
      "path": "/steps/0/http/headers/date",
      "matches": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun), [0-9]{2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT$"
    },
    {
      "id": "http-date-1",
      "path": "/steps/1/http/headers/date",
      "matches": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun), [0-9]{2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT$"
    }
  ],
  "volatile": [
    "\\.http\\.headers\\.date$"
  ]
}
