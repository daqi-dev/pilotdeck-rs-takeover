{
 "name": "gap-web-search-baidu",
 "about": "tools.webSearch provider=baidu（additionalWebSearch.ts）：POST + Bearer，messages/search_source/resource_type_filter 体；references 里只取 type=web；code≠0、非 2xx（apiKey 打码）、缺结果列表的错误文案。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ntools:\n  webSearch:\n    enabled: true\n    provider: baidu\n    endpoint: {MOCK}/baidu\n    apiKey: key-baidu\n",
 "provider": [
  {
   "name": "search-01",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 200,
    "body": {
     "references": [
      {
       "title": "T1",
       "url": "https://bd.example/1",
       "content": "C1",
       "type": "web",
       "date": "2026-02-02"
      },
      {
       "title": "IMG",
       "url": "https://bd.example/img",
       "type": "image"
      },
      {
       "title": "T3",
       "url": "https://bd.example/3",
       "snippet": "S3"
      }
     ]
    }
   },
   "when": [
    "baidu ok"
   ]
  },
  {
   "name": "search-02",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 200,
    "body": {
     "code": 216100,
     "message": "invalid param"
    }
   },
   "when": [
    "baidu code"
   ]
  },
  {
   "name": "search-03",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 401,
    "body": {
     "msg": "key-baidu rejected"
    }
   },
   "when": [
    "baidu status"
   ]
  },
  {
   "name": "search-04",
   "unless": [
    "\"model\":"
   ],
   "reply": {
    "status": 200,
    "body": {
     "result": []
    }
   },
   "when": [
    "baidu nolist"
   ]
  },
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "t04-after",
   "when": [
    "g04:",
    "\"tool_call_id\":\"call_g04\""
   ],
   "reply": {
    "text": "Done 04."
   }
  },
  {
   "name": "t04",
   "when": [
    "g04:"
   ],
   "reply": {
    "tool": {
     "id": "call_g04",
     "name": "web_search",
     "arguments": {
      "query": "baidu nolist"
     }
    }
   }
  },
  {
   "name": "t03-after",
   "when": [
    "g03:",
    "\"tool_call_id\":\"call_g03\""
   ],
   "reply": {
    "text": "Done 03."
   }
  },
  {
   "name": "t03",
   "when": [
    "g03:"
   ],
   "reply": {
    "tool": {
     "id": "call_g03",
     "name": "web_search",
     "arguments": {
      "query": "baidu status"
     }
    }
   }
  },
  {
   "name": "t02-after",
   "when": [
    "g02:",
    "\"tool_call_id\":\"call_g02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "t02",
   "when": [
    "g02:"
   ],
   "reply": {
    "tool": {
     "id": "call_g02",
     "name": "web_search",
     "arguments": {
      "query": "baidu code"
     }
    }
   }
  },
  {
   "name": "t01-after",
   "when": [
    "g01:",
    "\"tool_call_id\":\"call_g01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "t01",
   "when": [
    "g01:"
   ],
   "reply": {
    "tool": {
     "id": "call_g01",
     "name": "web_search",
     "arguments": {
      "query": "baidu ok",
      "gl": "cn"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-gap",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g01: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g02: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g03: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g04: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "read_session_messages",
   "params": {
    "sessionKey": "s-gap"
   }
  }
 ]
}
