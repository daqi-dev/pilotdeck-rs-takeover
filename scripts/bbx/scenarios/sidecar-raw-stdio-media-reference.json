{
 "name": "sidecar-raw-stdio-media-reference",
 "about": "stdio 部署上 execute 的 payload.messages 里带顶层 media_reference 块（默认工厂 toCanonicalContentBlocks 照收，pilotdeck-agent-loop-default-factory.ts:623-648），发模型请求前 materializeMediaReferences（materializeMediaReferences.ts:24-71）用 readFile(path, \"utf8\") 读出文件内容：相对路径按进程工作目录（这里是 proj）、绝对路径照读，没有目录限制；image / pdf（mimeType 须是 application/pdf）/ audio 换成对应的 base64 块，字节数取 originalBytes；读不到（不存在、是目录、上级不存在）或类型不支持时换成 preview 文本，并由 AgentLoop.ts:2313-2318 的 console.warn 在 stderr 打一行诊断。比的是发给宿主 model 调用里的请求消息与 stderr。非 ASCII 内容按 UTF-8 原样读出。",
 "server": false,
 "steps": [
  {
   "sidecar": "stdio",
   "readMs": 6000,
   "send": [
    {
     "json": {
      "kind": "request",
      "messageId": "x1",
      "method": "execute",
      "runId": "run-1",
      "operationId": "op-1",
      "requestId": "rq-1",
      "payload": {
       "messages": [
        {
         "role": "user",
         "content": [
          {
           "type": "text",
           "text": "look"
          },
          {
           "type": "media_reference",
           "path": "media/img.txt",
           "originalBytes": 12,
           "preview": "preview of media/img.txt",
           "hasMore": false,
           "mimeType": "image/png",
           "mediaType": "image",
           "detail": "high"
          },
          {
           "type": "media_reference",
           "path": "{PROJECT}/media/doc.txt",
           "originalBytes": 12,
           "preview": "preview of {PROJECT}/media/doc.txt",
           "hasMore": false,
           "mimeType": "application/pdf",
           "mediaType": "pdf",
           "pages": 2
          },
          {
           "type": "media_reference",
           "path": "media/sound.txt",
           "originalBytes": 12,
           "preview": "preview of media/sound.txt",
           "hasMore": false,
           "mimeType": "audio/wav",
           "mediaType": "audio"
          }
         ]
        },
        {
         "role": "user",
         "content": [
          {
           "type": "text",
           "text": "look"
          },
          {
           "type": "media_reference",
           "path": "media/bad-utf8.txt",
           "originalBytes": 12,
           "preview": "preview of media/bad-utf8.txt",
           "hasMore": false,
           "mimeType": "image/jpeg",
           "mediaType": "image"
          }
         ]
        }
       ]
      }
     }
    },
    {
     "until": {
      "text": "\"module\":\"model\""
     },
     "timeout": 8000,
     "save": {
      "c1Msg": "\"messageId\":\"([^\"]+)\"",
      "c1Req": "\"requestId\":\"([^\"]+)\""
