{
 "name": "agent-loop-sidecar-tcp-tool",
 "about": "PILOTDECK_AGENT_LOOP_TRANSPORT=tcp 下带工具调用的轮次（与 agent-loop-sidecar-stdio-tool 相同的输入，sidecar 换成外部常驻的 TCP 进程）：第一轮 read_file 再 bash（宿主侧执行工具，sidecar 只经 module_call 调用），第二轮同会话纯文本，两轮各连一次 sidecar（agentLoopSidecarClient.ts:355-362 每轮 connect，tcpAgentLoopSidecarConnection.ts:37），同一个 sidecar 实例。比较帧、provider 请求、agent_loop_operation_* 记录与 sidecar 进程的输出和退出。",
 "volatile": [
  "\\.jsonl\\[\\d+\\]\\.binding\\.(moduleInstanceId|connectionGeneration)$",
  "\\.jsonl\\[\\d+\\]\\.streamId$"
 ],
 "env": {
  "PILOTDECK_AGENT_LOOP_TRANSPORT": "tcp",
  "PILOTDECK_AGENT_LOOP_TCP_PORT": "38414"
 },
 "files": {
  "proj/notes.txt": "alpha\nbeta\n"
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\": \"Sidecar tool\"}",
    "delayMs": 4000
   }
  },
  {
   "name": "second",
   "when": [
    "sc-two:"
   ],
   "reply": {
    "text": "Second turn done."
   }
  },
  {
   "name": "after-bash",
   "when": [
    "sc-one:",
    "\"tool_call_id\":\"call_sc_bash\""
   ],
   "reply": {
    "text": "Tools done."
   }
  },
  {
   "name": "after-read",
   "when": [
    "sc-one:",
    "\"tool_call_id\":\"call_sc_read\""
   ],
   "reply": {
    "tool": {
     "id": "call_sc_bash",
     "name": "bash",
     "arguments": {
      "command": "echo from-bash"
     }
    }
   }
  },
  {
   "name": "first",
   "when": [
    "sc-one:"
   ],
   "reply": {
    "tool": {
     "id": "call_sc_read",
     "name": "read_file",
     "arguments": {
      "file_path": "{PROJECT}/notes.txt"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "sidecar": "start",
   "port": 38414
  },
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-sc-tool",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-sc-tool",
    "channelKey": "test",
    "message": "sc-one: read and run"
   },
   "timeout": 60000
  },
  {
   "sleep": 5000
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-sc-tool",
    "channelKey": "test",
    "message": "sc-two: again"
   },
   "timeout": 60000
  },
  {
   "sidecar": "stop"
  }
 ]
}
