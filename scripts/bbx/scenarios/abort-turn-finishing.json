{
  "name": "abort-turn-finishing",
  "about": "中止落在轮次收尾之后、标题生成请求还挂着（假 provider 3 秒后才回标题）。abort_turn、close_session（超时列不适用：标题生成不在轮次内，轮次先于任何超时结束）。比较 turn_completed、会话标题记录、下一轮。动作在收到 turn_completed 时发出：两侧都在解开标题与本轮信号的连接（TurnRunner.ts:640-648 finalizeSessionMetadata）之后才发这一帧，中止一定落在解绑之后；原来在 assistant_block 时发出，落在解绑前后取决于两侧发帧快慢（cb8 2026-11-14 基线对 Rust 0/10），那是触发点不确定。仍在测原来那件事：回复完整之后到来的中止 / 关会话不取消已经在路上的标题生成。本场景是 abort_turn 列，close_session 列见 abort-turn-finishing-close。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Abort run\"}",
        "delayMs": 3000
      }
    },
    {
      "name": "next-fn-run",
      "when": [
        "next-fn-run:"
      ],
      "reply": {
        "text": "Next fn-run."
      }
    },
    {
      "name": "fn-run",
      "when": [
        "fn-run:"
      ],
      "reply": {
        "text": "answer fn-run"
      }
    }
  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-fn-run",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-fn-run",
        "channelKey": "test",
        "runId": "run-fn-run",
        "message": "fn-run: go"
      },
      "timeout": 20000,
      "answer": [
        {
          "on": {
            "type": "turn_completed"
          },
          "ws": "abort_turn",
          "params": {
            "sessionKey": "s-fn-run",
            "runId": "run-fn-run"
          },
          "count": 1
        }
      ]
    },
    {
      "sleep": 3500
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-fn-run",
        "channelKey": "test",
        "message": "next-fn-run: again"
      },
      "timeout": 20000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-fn-run"
      }
    }
  ]
}
