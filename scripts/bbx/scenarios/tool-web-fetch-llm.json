{
  "name": "tool-web-fetch-llm",
  "about": "web_fetch 的 llm 模式（缺省模式）正常路径：假站点（UserPromptSubmit hook 起的本机 HTTPS，site/site.mjs）回 HTML / 纯文本 / JSON / 图片 / 同主机重定向 / 跨主机重定向 / http 升级 / 空页 / 超过 10 万字符的页 / 没有 content-type 的页，二次模型请求发到配置里的 openrouter / moonshotai/kimi-k2.6（webFetch.ts:82-84，经 router.stream、isMainAgent:false），比较二次请求的每个字节、工具结果与 data、会话记录、站点收到的请求头；第二次抓同一页走缓存（fromCache）但照样调二次模型。",
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n    openrouter:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        moonshotai/kimi-k2.6:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
  "httpsPort": 38419,
  "env": {
    "NODE_EXTRA_CA_CERTS": "{HTTPS_CA}"
  },
  "files": {
    "home/.pilotdeck/plugins/bbx-site/plugin.json": {
      "name": "bbx-site",
      "version": "0.1.0",
      "description": "bbx web_fetch site",
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node {ROOT}/site/site.mjs {ROOT} 38417 38411"
              }
            ]
          }
        ]
      }
    },
    "site/site.mjs": "// bbx web_fetch 假站点：node site.mjs <root> <port> <gatewayPort>\n// 由 UserPromptSubmit hook 调起：已有实例在听就直接退出；否则脱离起一个常驻子进程，等它开始监听再退出（hook 不输出任何东西）。\n// 子进程按 <root>/site/routes.json 应答 HTTPS（证书是仓库里的一次性测试 CA 叶子，见 <root>/site/tls.json），\n// 每个请求记一行到 <root>/home/sitelog/requests.jsonl（方法、路径、头），落盘照常比较。\n// 根目录被清掉（下一侧开跑）或 gateway 端口不再接受连接时自行退出；最长活 180 秒。\nimport fs from 'node:fs';\nimport net from 'node:net';\nimport https from 'node:https';\nimport { spawn } from 'node:child_process';\n\nconst [root, portText, gatewayText, mode] = process.argv.slice(2);\nconst port = Number(portText);\nconst gatewayPort = Number(gatewayText);\nconst probe = (p) => new Promise((resolve) => {\n  const s = net.connect({ host: '127.0.0.1', port: p });\n  s.once('connect', () => { s.destroy(); resolve(true); });\n  s.once('error', () => resolve(false));\n});\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms));\n\nif (mode !== 'serve') {\n  process.stdin.resume();\n  process.stdin.on('data', () => {});\n  if (!(await probe(port))) {\n    spawn(process.execPath, [process.argv[1], root, portText, gatewayText, 'serve'], { detached: true, stdio: 'ignore' }).unref();\n    for (let i = 0; i < 200 && !(await probe(port)); i++) await sleep(25);\n  }\n  process.exit(0);\n}\n\nconst marker = `${root}/site/routes.json`;\nconst routes = JSON.parse(fs.readFileSync(marker, 'utf8'));\nconst tls = JSON.parse(fs.readFileSync(`${root}/site/tls.json`, 'utf8'));\nconst logDir = `${root}/home/sitelog`;\nconst server = https.createServer({ cert: tls.cert, key: tls.key }, async (req, res) => {\n  for await (const _ of req) { /* drain */ }\n  fs.mkdirSync(logDir, { recursive: true });\n  fs.appendFileSync(`${logDir}/requests.jsonl`, JSON.stringify({ method: req.method, url: req.url, headers: req.headers }) + '\\n');\n  const route = routes[req.url] ?? { status: 404, body: 'no route' };\n  if (route.delayMs) await sleep(route.delayMs);\n  let body;\n  if (route.b64 !== undefined) body = Buffer.from(route.b64, 'base64');\n  else if (route.repeat) body = Buffer.concat([Buffer.from(route.repeat.prefix ?? ''), Buffer.from(route.repeat.text.repeat(route.repeat.times)), Buffer.from(route.repeat.suffix ?? '')]);\n  else body = Buffer.from(route.body ?? '');\n  const headers = { ...(route.headers ?? {}) };\n  if (!route.chunked && !route.hang) headers['content-length'] = String(body.length);\n  res.writeHead(route.status ?? 200, route.statusText ?? undefined, headers);\n  if (route.hang) { res.write(body.subarray(0, route.hang)); setTimeout(() => res.destroy(), route.hangMs ?? 20000).unref(); return; }\n  res.end(body);\n});\nserver.on('tlsClientError', () => {});\nfor (let i = 0; ; i++) {\n  try {\n    await new Promise((resolve, reject) => { server.once('error', reject); server.listen(port, '127.0.0.1', resolve); });\n    break;\n  } catch (error) {\n    if (error.code !== 'EADDRINUSE' || i > 120) process.exit(1);\n    await sleep(50);\n  }\n}\nconst started = Date.now();\nsetInterval(async () => {\n  if (!fs.existsSync(marker) || Date.now() - started > 180000 || !(await probe(gatewayPort))) process.exit(0);\n}, 200);\n",
