{
  "name": "tool-path-not-allowed",
  "about": "工作区外的路径被拒后的 path_not_allowed（tool/builtin/filesystem/pathSafety.ts:74-77 Path … is outside the PilotDeck workspace.）。只有 loop-parallel-tools 的 q4 碰到过它，而那个场景在并发负载下偶有记录先后不同；这里单独、串行地做：default 模式下 glob / grep / read_file 访问 {ROOT}/outside，权限询问一律拒绝，比较工具结果、事件与落盘。",
  "files": {
    "outside/a.txt": "outside text\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Outside\"}"
      }
    },
    {
      "name": "p1-after",
      "when": [
        "p1:",
        "\"tool_call_id\":\"call_p1\""
      ],
      "reply": {
        "text": "Done p1."
      }
    },
    {
      "name": "p1",
      "when": [
        "p1:"
      ],
      "reply": {
        "tool": {
          "id": "call_p1",
          "name": "glob",
          "arguments": {
            "pattern": "*.txt",
            "path": "{ROOT}/outside"
          }
        }
      }
    },
    {
      "name": "p2-after",
      "when": [
        "p2:",
        "\"tool_call_id\":\"call_p2\""
      ],
      "reply": {
        "text": "Done p2."
      }
    },
    {
      "name": "p2",
      "when": [
        "p2:"
      ],
      "reply": {
        "tool": {
          "id": "call_p2",
          "name": "grep",
          "arguments": {
            "pattern": "outside",
            "path": "{ROOT}/outside"
          }
        }
      }
    },
    {
      "name": "p3-after",
      "when": [
        "p3:",
        "\"tool_call_id\":\"call_p3\""
      ],
      "reply": {
        "text": "Done p3."
      }
    },
    {
      "name": "p3",
      "when": [
        "p3:"
      ],
      "reply": {
        "tool": {
          "id": "call_p3",
          "name": "read_file",
          "arguments": {
            "path": "{ROOT}/outside/a.txt"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-p1",
        "channelKey": "test",
        "message": "p1: look outside"
      },
      "timeout": 30000,
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-p1",
            "requestId": "{event.requestId}",
            "decision": "deny"
          }
        }
      ]
    },
    {
      "sleep": 300
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-p1"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-p2",
        "channelKey": "test",
        "message": "p2: look outside"
      },
      "timeout": 30000,
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-p2",
            "requestId": "{event.requestId}",
            "decision": "deny"
          }
        }
      ]
    },
    {
      "sleep": 300
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-p2"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-p3",
        "channelKey": "test",
        "message": "p3: look outside"
      },
      "timeout": 30000,
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-p3",
            "requestId": "{event.requestId}",
            "decision": "deny"
          }
        }
      ]
    },
    {
      "sleep": 300
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-p3"
      }
    }
  ]
}
