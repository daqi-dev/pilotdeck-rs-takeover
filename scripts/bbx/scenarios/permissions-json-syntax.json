{
 "name": "permissions-json-syntax",
 "about": "~/.pilotdeck/permissions.json 的规则语法与优先级（permission/settings.ts，InProcessGateway.ts:1441-1457,1566-1569，agent/turn/permissionOverrides.ts replaceUserRules）与绕过尝试：allow 规则 Bash(touch allowed*) 面对 &&、;、$()、|、换行、大小写、多空格、引号；deny 规则 Bash(rm *) 面对绝对路径、前导空格、;、command 前缀、大写；Bash(git push*)；Read 在 askTools、Glob 在 allow、Write 在 deny；同一条同时在 allow 与 deny；会话授权（grant_session_permission）与文件 deny 冲突；permission_decide remember 后文件不变；会话进行中用 write_file 改写文件后下一轮生效；allow 与 ask 同时命中。缺省权限模式，采集器按轮允许或拒绝。",
 "files": {
  "home/.pilotdeck/permissions.json": {
   "version": 1,
   "allowedTools": [
    "Bash(touch allowed*)",
    "  Bash( echo hi* )  ",
    "Glob",
    "Bash(rm -f nothing-granted)"
   ],
   "disallowedTools": [
    "Bash(rm *)",
    "Bash(git push*)",
    "Write",
    "Bash(rm -f nothing-granted)"
   ],
   "askTools": [
    "Read",
    "Bash(touch allowed-z)"
   ],
   "skipPermissions": false
  },
  "home/.pilotdeck/notes/p.txt": "perm\n"
 },
