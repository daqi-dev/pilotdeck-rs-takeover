{
 "name": "proto-openai-responses-request",
 "about": "用公共 host 的 model_stream 直接驱动 OpenAI Responses 请求组装（model/providers/openai-responses/request.ts）与流解析（stream.ts）。q1 结构化输出→text.format（strict 缺省 true，schema 经 normalizeOpenAISchema）；q2 tool_choice required、工具 strict:true、metadata 值转字符串；q3 none + strict:false；q4 指定函数→{type:function,name}；q5 instructions、max_output_tokens、input_image（base64 / url）、PDF→input_file、助手 thinking→input_text、function_call / function_call_output、结果里的图片另起一条用户消息、出错的结果、只有 thinking 的助手消息；q6 reasoning.effort high；q7 关闭→effort none；q8 enabled 但不选强度→不带 reasoning；q9 server-default；q10/q11 speedMapping openai_service_tier→service_tier priority；q12 流里的推理摘要、分块文本与工具调用；q13 用量带 cached_tokens / reasoning_tokens；q14 status incomplete；q15 response.failed；q16 HTTP 400（端点回退到不带 /v1 的路径）；q17 工具参数需要 jsonrepair；q18 工具参数无法修复。",
 "config": "schemaVersion: 1\nagent:\n  model: resp/gpt-bbx\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    resp:\n      protocol: openai-responses\n      url: {MOCK}\n      apiKey: bbx-responses-key\n      speedMapping: openai_service_tier\n      retry:\n        baseDelayMs: 1\n        maxDelayMs: 1\n        jitter: 0\n      models:\n        gpt-bbx:\n          multimodal:\n            input: [text, image, pdf]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-think:\n          thinking:\n            state: enabled\n            efforts: [low, high]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-off:\n          thinking:\n            state: disabled\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-server:\n          thinking:\n            state: enabled\n            format: server-default\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-fast:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n            supportsSpeed: true\ntelemetry:\n  enabled: false\n",
 "provider": [
  {
   "name": "q1",
   "when": [
    "q1: structured"
   ],
   "reply": {
    "text": "{\"value\":42,\"tags\":[\"a\"]}"
   }
  },
  {
   "name": "q12",
   "when": [
    "q12: reasoning and tool"
   ],
   "reply": {
    "reasoning": "chain of thought",
    "chunks": [
     "look",
     "ing"
    ],
    "text": "looking",
    "tool": {
     "id": "call_q12",
     "name": "lookup",
     "arguments": {
      "q": "z"
     }
    }
   }
  },
  {
   "name": "q13",
   "when": [
    "q13: cached usage"
   ],
   "reply": {
    "text": "cached",
    "usage": {
     "prompt_tokens": 100,
     "completion_tokens": 7,
     "total_tokens": 107,
     "prompt_tokens_details": {
      "cached_tokens": 64
     },
     "completion_tokens_details": {
      "reasoning_tokens": 3
     }
    }
   }
  },
  {
   "name": "q14",
   "when": [
    "q14: incomplete"
   ],
   "reply": {
    "text": "partial",
    "finish": "incomplete"
   }
  },
  {
   "name": "q15",
   "when": [
    "q15: failed"
   ],
   "reply": {
    "text": "oops",
    "finish": "failed",
    "error": {
     "code": "rate_limit_exceeded",
     "message": "Failed inside the stream."
    }
   }
  },
  {
   "name": "q16",
   "when": [
    "q16: http 400"
   ],
   "reply": {
    "status": 400,
    "body": {
     "error": {
      "message": "Unsupported parameter: reasoning.",
      "type": "invalid_request_error",
      "param": "reasoning",
      "code": "unsupported_parameter"
     }
    }
   }
  },
  {
   "name": "q17",
   "when": [
    "q17: repair args"
   ],
   "reply": {
    "tool": {
     "id": "call_q17",
     "name": "lookup",
     "rawArguments": "{\"q\": \"x\","
    }
   }
  },
  {
   "name": "q18",
   "when": [
    "q18: broken args"
   ],
   "reply": {
    "tool": {
     "id": "call_q18",
     "name": "lookup",
     "rawArguments": "}}}not json"
    }
   }
  },
  {
   "name": "other",
   "reply": {
    "text": "ok"
   }
  }
 ],
