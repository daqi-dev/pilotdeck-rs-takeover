   }
  },
  {
   "name": "sub",
   "when": [
    "ins-sub:"
   ],
   "reply": {
    "text": "ok sub"
   }
  }
 ],
 "steps": [
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-root",
    "channelKey": "test",
    "message": "ins-root: hi",
    "projectKey": "{HOME}/work/alpha"
   }
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-sub",
    "channelKey": "test",
    "message": "ins-sub: hi",
    "projectKey": "{HOME}/work/alpha",
    "workspaceCwd": "{HOME}/work/alpha/sub"
   }
  },
  {
   "sleep": 300
  }
 ]
