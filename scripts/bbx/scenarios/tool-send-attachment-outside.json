{
  "name": "tool-send-attachment-outside",
  "about": "send_attachment：工作区外的文件在默认权限模式下要先请求许可。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "send_attachment",
          "arguments": {
            "file_path": "/private/tmp/pdrs-bbx/root/outside/secret.txt"
          }
        }
      }
    }
  ],
  "files": {
    "outside/secret.txt": "outside\n"
  },
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      },
      "timeout": 3000
    },
    {
      "sleep": 200
    },
    {
      "disconnect": true
    }
  ]
}
