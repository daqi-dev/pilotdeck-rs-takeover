{
  "name": "skills-manage",
  "about": "skills 管理一族：skill_scan / skill_validate（目录与清单两种）/ skill_create / skill_read / skill_write / skill_import（copy、冲突、force、校验失败）/ skill_delete 的正常路径与主要失败路径，以及落盘结果；改动之后 reload_extensions，再开新会话发一轮，看系统提示词里的 skills 段是否体现增删。",
  "files": {
    "home/.pilotdeck/skills/existing-skill/SKILL.md": "---\nname: existing-skill\ndescription: A user-level skill that exists before the scenario starts.\n---\n\n# existing\n",
    "proj/import-src/good-skill/SKILL.md": "---\nname: good-skill\ndescription: An importable skill with a helper script inside it.\nversion: 2\n---\n\n# good skill\n\nUse it well.\n",
    "proj/import-src/good-skill/scripts/run.sh": "#!/bin/sh\necho hi\n",
    "proj/import-src/bad-skill/SKILL.md": "# no frontmatter here\n",
    "proj/import-src/plain-dir/readme.txt": "not a skill\n",
    "proj/import-src/short-desc/SKILL.md": "---\nname: short-desc\ndescription: tiny\n---\nbody\n"
  },
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Skills\"}" } },
    { "name": "main", "reply": { "text": "Skill turn done." } }
  ],
  "steps": [
    { "ws": "skill_scan", "params": { "parentPath": "{PROJECT}/import-src" } },
    { "ws": "skill_scan", "params": { "parentPath": "{PROJECT}/import-src/good-skill" } },
    { "ws": "skill_scan", "params": { "parentPath": "{PROJECT}/missing" } },
    { "ws": "skill_scan", "params": { "parentPath": "{PROJECT}/import-src/good-skill/SKILL.md" } },
    { "ws": "skill_scan", "params": { "parentPath": "  " } },
    { "ws": "skill_validate", "params": { "sourcePath": "{PROJECT}/import-src/good-skill" } },
    { "ws": "skill_validate", "params": { "sourcePath": "{PROJECT}/import-src/bad-skill" } },
    { "ws": "skill_validate", "params": { "sourcePath": "{PROJECT}/import-src/short-desc" } },
    { "ws": "skill_validate", "params": { "sourcePath": "{PROJECT}/nowhere" } },
    { "ws": "skill_validate", "params": { "skillMdContent": "---\nname: m\ndescription: manifest checked skill description\n---\n", "files": [ { "relativePath": "SKILL.md", "size": 40 }, { "relativePath": "../escape.txt", "size": 1 }, { "relativePath": "tool.exe", "size": 2000000 } ] } },
    { "ws": "skill_validate", "params": {} },
    { "ws": "skill_create", "params": { "scope": "user", "slug": "made-skill", "name": "Made Skill", "description": "Created through skill_create in the scenario.", "body": "Do the made thing." } },
    { "ws": "skill_create", "params": { "scope": "user", "slug": "made-skill" } },
    { "ws": "skill_create", "params": { "scope": "user", "slug": "../escape" } },
    { "ws": "skill_create", "params": { "scope": "builtin", "slug": "nope" } },
    { "ws": "skill_create", "params": { "scope": "project", "slug": "proj-skill", "projectKey": "{PILOT_HOME}" } },
    { "ws": "skill_create", "params": { "scope": "project", "slug": "proj-skill", "projectKey": "{PROJECT}", "content": "---\nname: proj-skill\ndescription: Project scoped skill created by content.\n---\nProject body.\n" } },
    { "ws": "skill_read", "params": { "scope": "user", "slug": "made-skill" } },
    { "ws": "skill_read", "params": { "scope": "user", "slug": "ghost" } },
    { "ws": "skill_write", "params": { "scope": "user", "slug": "made-skill", "content": "---\nname: made-skill\ndescription: Rewritten through skill_write in the scenario.\nversion: 1.5\n---\nNew body.\n" } },
    { "ws": "skill_write", "params": { "scope": "user", "slug": "made-skill" } },
    { "ws": "skill_read", "params": { "scope": "user", "slug": "made-skill" } },
    { "ws": "skill_import", "params": { "scope": "user", "sourcePath": "{PROJECT}/import-src/good-skill" } },
    { "ws": "skill_import", "params": { "scope": "user", "sourcePath": "{PROJECT}/import-src/good-skill" } },
    { "ws": "skill_import", "params": { "scope": "user", "sourcePath": "{PROJECT}/import-src/good-skill", "slug": "good-skill", "force": true } },
    { "ws": "skill_import", "params": { "scope": "user", "sourcePath": "{PROJECT}/import-src/bad-skill" } },
    { "ws": "skill_import", "params": { "scope": "user", "sourcePath": "{PROJECT}/import-src/plain-dir" } },
    { "ws": "skill_import", "params": { "scope": "user", "sourcePath": "{PROJECT}/import-src/missing" } },
    { "ws": "skill_import", "params": { "scope": "user" } },
    { "ws": "skill_list", "params": { "projectKey": "{PROJECT}", "limit": 50 } },
    { "ws": "skill_delete", "params": { "scope": "user", "slug": "existing-skill" } },
    { "ws": "skill_delete", "params": { "scope": "user", "slug": "never-there" } },
    { "ws": "skill_delete", "params": { "scope": "builtin", "slug": "existing-skill" } },
    { "ws": "reload_extensions", "params": {} },
    { "ws": "submit_turn", "params": { "sessionKey": "s-skills", "channelKey": "test", "message": "list my skills" } },
    { "sleep": 500 }
  ]
}
