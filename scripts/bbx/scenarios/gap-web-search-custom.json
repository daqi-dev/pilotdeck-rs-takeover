{
 "name": "gap-web-search-custom",
 "about": "tools.webSearch 自定义 provider（pilot/config/parseToolsConfig.ts、tool/builtin/webSearch.ts:140-180,705-760）：enabled + provider=custom，endpoint 指向假 provider 的 /search，POST + bearer 鉴权、自定义 queryParam 与结果字段路径（resultsPath=choices）。比较 web_search 是否出现在工具清单、发到 endpoint 的请求（方法、头、体）、工具结果；再测 gl 参数、空 query、缺 query。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ntools:\n  webSearch:\n    enabled: true\n    provider: custom\n    endpoint: {MOCK}/search\n    apiKey: search-key\n    customProvider:\n      name: BBX Search\n      method: POST\n      queryParam: q\n      resultsPath: choices\n      titleField: finish_reason\n      urlField: index\n      snippetField: message.content\n",
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "search-endpoint",
   "when": [
    "\"q\":"
   ],
   "reply": {
    "text": "search body"
   }
  },
  {
   "name": "t04-after",
   "when": [
    "g04:",
    "\"tool_call_id\":\"call_g04\""
   ],
   "reply": {
    "text": "Done 04."
   }
  },
  {
   "name": "t04",
   "when": [
    "g04:"
   ],
   "reply": {
    "tool": {
     "id": "call_g04",
     "name": "web_search",
     "arguments": {}
    }
   }
  },
  {
   "name": "t03-after",
   "when": [
    "g03:",
    "\"tool_call_id\":\"call_g03\""
   ],
   "reply": {
    "text": "Done 03."
   }
  },
  {
   "name": "t03",
   "when": [
    "g03:"
   ],
   "reply": {
    "tool": {
     "id": "call_g03",
     "name": "web_search",
     "arguments": {
      "query": ""
     }
    }
   }
  },
  {
   "name": "t02-after",
   "when": [
    "g02:",
    "\"tool_call_id\":\"call_g02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "t02",
   "when": [
    "g02:"
   ],
   "reply": {
    "tool": {
     "id": "call_g02",
     "name": "web_search",
     "arguments": {
      "query": "中文 搜索",
      "gl": "cn"
     }
    }
   }
  },
  {
   "name": "t01-after",
   "when": [
    "g01:",
    "\"tool_call_id\":\"call_g01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "t01",
   "when": [
    "g01:"
   ],
   "reply": {
    "tool": {
     "id": "call_g01",
     "name": "web_search",
     "arguments": {
      "query": "pilotdeck rust"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-gap",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g01: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g02: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g03: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g04: go"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "read_session_messages",
   "params": {
    "sessionKey": "s-gap"
   }
  }
 ]
}
