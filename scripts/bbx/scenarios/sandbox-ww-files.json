{
 "name": "sandbox-ww-files",
 "about": "agent.sandboxMode=workspace-write 下的写工具（SandboxedFsPort.ts:30-129，write_file/edit_file/edit_notebook 以解析出的根作 workspaceRoot，按字面判断不解析符号链接）：bypassPermissions 下写工作区内、工作区外绝对路径、..、TMPDIR、sub/..、以 .. 开头的文件名、经工作区内指向外部的符号链接写。最后一轮列出落点。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\n  sandboxMode: workspace-write\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
 "files": {
  "home/.pilotdeck/projects/private-tmp-pdrs-bbx-root-home-work-alpha/.cwd": "{HOME}/work/alpha\n",
  "home/work/alpha/README.md": "alpha\n",
  "home/work/alpha/nb.ipynb": "{\n \"cells\": [\n  {\n   \"cell_type\": \"code\",\n   \"id\": \"c1\",\n   \"metadata\": {},\n   \"source\": \"print(1)\",\n   \"outputs\": [],\n   \"execution_count\": null\n  }\n ],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\n",
  "outside/o.txt": "outside\n"
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Sbx\"}"
   }
  },
  {
   "name": "b99-after",
   "when": [
    "b99:",
    "\"tool_call_id\":\"call_b99\""
   ],
   "reply": {
    "text": "Done b99."
   }
  },
  {
   "name": "b99",
   "when": [
    "b99:"
   ],
   "reply": {
    "tool": {
     "id": "call_b99",
     "name": "bash",
     "arguments": {
      "command": "ls -la {ROOT}/outside | awk '{print $1, $NF}'; ls ../; ls -R $TMPDIR/sbx 2>&1 | sort; ls -la . | awk '{print $1, $NF}'"
     }
    }
   }
  },
  {
   "name": "w07-after",
   "when": [
    "w07:",
    "\"tool_call_id\":\"call_w07\""
   ],
   "reply": {
    "text": "Done w07."
