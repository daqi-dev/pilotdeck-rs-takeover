{
  "name": "tool-todo-write",
  "about": "todo_write：结构化写入、merge 更新、markdown 覆盖、无参读取；plan_todo_written 落盘。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-5-after-tool",
      "when": [
        "turn-5:",
        "\"tool_call_id\":\"call_bbx_5\""
      ],
      "reply": {
        "text": "Done 5."
      }
    },
    {
      "name": "turn-5",
      "when": [
        "turn-5:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_5",
          "name": "todo_write",
          "arguments": {
            "todos": [
              {
                "id": "z",
                "content": "only one",
                "status": "completed"
              }
            ]
          }
        }
      }
    },
    {
      "name": "turn-4-after-tool",
      "when": [
        "turn-4:",
        "\"tool_call_id\":\"call_bbx_4\""
      ],
      "reply": {
        "text": "Done 4."
      }
    },
    {
      "name": "turn-4",
      "when": [
        "turn-4:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_4",
          "name": "todo_write",
          "arguments": {
            "markdown": "- [x] done item\n* [ ] next item\n  - [X]   spaced item  \nnot a todo\n- [ ] later item"
          }
        }
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
      }
    },
    {
      "name": "turn-3",
      "when": [
        "turn-3:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_3",
          "name": "todo_write",
          "arguments": {}
        }
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "todo_write",
          "arguments": {
            "todos": [
              {
                "id": "a",
                "status": "completed"
              },
              {
                "id": "c",
                "content": "third step"
              },
              {
                "id": "c",
                "content": "third step again",
                "priority": " low "
              },
              {
                "content": "appended"
              }
            ],
            "merge": true
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "todo_write",
          "arguments": {
            "todos": [
              {
                "id": "a",
                "content": "first step",
                "status": "in_progress"
              },
              {
                "id": "b",
                "content": " second step ",
                "status": "pending",
                "priority": "high"
              },
              {
                "content": "no id"
              }
            ],
            "reason": " initial plan "
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      }
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-2: run the tool"
      }
