{
 "name": "agent-loop-sidecar-tcp-abort",
 "about": "PILOTDECK_AGENT_LOOP_TRANSPORT=tcp 下中止一轮（与 agent-loop-sidecar-stdio-abort 相同的输入）：a 模型流式输出中 abort_turn；b bash 工具执行中 abort_turn；随后 a 的会话再提交一轮。宿主经 TCP 向 sidecar 发 cancel（agentLoopSidecarClient.ts:931-958），sidecar 以 cancelled 收尾（agentLoopSidecarServer.ts:169-192、358），常驻 sidecar 不因中止退出。",
 "volatile": [
  "\\.jsonl\\[\\d+\\]\\.binding\\.(moduleInstanceId|connectionGeneration)$",
  "\\.jsonl\\[\\d+\\]\\.streamId$"
 ],
 "env": {
  "PILOTDECK_AGENT_LOOP_TRANSPORT": "tcp",
  "PILOTDECK_AGENT_LOOP_TCP_PORT": "38414"
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\": \"Sidecar abort\"}",
    "delayMs": 4000
   }
  },
  {
   "name": "next",
   "when": [
    "sa-next:"
   ],
   "reply": {
    "text": "Next ok."
   }
  },
  {
   "name": "a",
   "when": [
    "sa-a:"
   ],
   "reply": {
    "chunks": [
     "partial ",
     "never"
    ],
    "hangAfter": 1,
    "hangMs": 4000
   }
  },
  {
   "name": "b-after",
   "when": [
    "sa-b:",
    "\"tool_call_id\":\"call_sa_b\""
   ],
   "reply": {
    "text": "Never reached b."
   }
  },
  {
   "name": "b",
   "when": [
    "sa-b:"
   ],
   "reply": {
    "tool": {
     "id": "call_sa_b",
     "name": "bash",
     "arguments": {
      "command": "trap '' TERM; sleep 1; echo survived"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "sidecar": "start",
   "port": 38414
  },
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-sa-a",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-sa-a",
    "channelKey": "test",
    "message": "sa-a: go"
   },
   "answer": [
    {
     "on": {
      "type": "assistant_text_delta"
     },
     "ws": "abort_turn",
     "params": {
      "sessionKey": "s-sa-a"
     },
     "count": 1
    }
   ],
   "timeout": 30000
  },
  {
   "sleep": 5000
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-sa-a",
    "channelKey": "test",
    "message": "sa-next: again"
   },
   "timeout": 30000
  },
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-sa-b",
    "mode": "bypassPermissions"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-sa-b",
    "channelKey": "test",
    "message": "sa-b: go"
   },
   "answer": [
    {
     "on": {
      "type": "tool_call_started"
     },
     "ws": "abort_turn",
     "params": {
      "sessionKey": "s-sa-b"
     },
     "count": 1
    }
   ],
   "timeout": 30000
  },
  {
   "sleep": 5000
  },
  {
   "sidecar": "stop"
  }
 ],
 "settleMs": 1000
}
