{
 "name": "sidecar-raw-tcp-disconnect-pending",
 "about": "TCP 部署：第一条连接上的 execute 发出 model module_call 后，宿主不回应就断开连接（步骤结束时关掉套接字）。基线 serve 的 finally 只把连接标成关闭、解除流的绑定（agentLoopSidecarServer.ts:201-204），执行本身不取消：仍挂在那条调用上，abortControllers / operation 表是进程级的，所以第二条连接上 status 是 running、cancelRequested false；在第二条连接上 cancel 它，abort 释放挂起的调用，执行以 aborted 结束，终止帧因流没有连接而不发（publishStreamEvent 575-576），status 变成 cancelled。第三条连接再查一次。",
 "server": false,
 "env": {
  "PILOTDECK_AGENT_LOOP_TCP_PORT": "38414"
 },
 "steps": [
  {
   "sidecar": "start",
   "port": 38414
  },
  {
   "raw": {
    "port": 38414,
    "lines": true,
    "readMs": 300,
    "send": [
     {
      "json": {
       "kind": "request",
       "messageId": "x1",
       "method": "execute",
       "runId": "run-1",
       "operationId": "op-1",
       "requestId": "rq-1",
       "payload": {}
      }
     },
     {
      "until": {
       "text": "\"method\":\"module_call\""
      },
      "timeout": 8000,
      "save": {
       "m1Msg": "\"messageId\":\"([^\"]+)\"",
       "m1Req": "\"requestId\":\"([^\"]+)\""
      }
     }
    ]
   }
  },
  {
   "sleep": 500
  },
  {
   "raw": {
    "port": 38414,
    "lines": true,
    "readMs": 1000,
    "send": [
     {
      "json": {
       "kind": "request",
       "messageId": "h2",
       "method": "hello",
       "payload": {}
      }
     },
     {
      "json": {
       "kind": "request",
       "messageId": "s1a",
       "method": "status",
       "requestId": "rq-1"
      }
     },
     {
      "wait": 300
     },
     {
      "json": {
       "kind": "request",
       "messageId": "c1",
       "method": "cancel",
       "runId": "run-1",
       "operationId": "op-1",
       "reason": "user"
      }
     },
     {
      "wait": 500
     },
     {
      "json": {
       "kind": "request",
       "messageId": "s1b",
       "method": "status",
       "requestId": "rq-1"
      }
     }
    ]
   }
  },
  {
   "raw": {
    "port": 38414,
    "lines": true,
    "readMs": 800,
    "send": [
     {
      "json": {
       "kind": "request",
       "messageId": "s1c",
       "method": "status",
       "requestId": "rq-1"
      }
     },
     {
      "json": {
       "kind": "request",
       "messageId": "c1c",
       "method": "cancel",
       "runId": "run-1",
       "operationId": "op-1",
       "reason": "user"
      }
     }
    ]
   }
  },
  {
   "sidecar": "stop"
  }
 ],
 "accepted": [
  {
   "id": "module-call-abortsignal-field",
   "why": "基线 bug（与它自己的协议 schema 矛盾）：sidecar 发给宿主的 module_call 帧里带 \"abortSignal\":{}（hostModelInvokerPort.ts:101 把 AbortSignal 对象放进了调用载荷，序列化成空对象），基线自己的 schema 校验下这些帧不合法（上游验收集：基线 1204 帧里 326 帧因此不合法）。Rust 不发这个字段，全部帧合法。只放过这个字段本身",
   "paths": [
    "^\\$\\.steps\\[\\d+\\]\\.(sidecar|raw)\\.lines\\[\\d+\\]\\.abortSignal$"
   ]
  }
 ]
}
