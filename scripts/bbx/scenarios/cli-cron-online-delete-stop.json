{
  "name": "cli-cron-online-delete-stop",
  "about": "cron delete / stop 连上 server（src/cli/pilotdeck.ts:399-421）：任务 id 取 argv[1]（紧跟子命令的那个参数，哪怕它是 --task / --run / --stop-running 这样的旗标），没有时才看 --task；delete 带 stopRunning: argv.includes('--stop-running')；stop 的 --run 给 runId，任务 id 与 runId 都没有时打用法。覆盖删除成功、重复删除、不存在的任务、旗标被当成任务 id、停一个正在跑的一次性运行（run_now 触发、模型请求挂住）、停不在跑的任务。基线 CLI 连上 server 后 WebSocket 不关，输出完不退出（挂起，疑似基线 bug，见报告），这类步骤声明 expectTimeout；最后 stopServer SIGKILL：被杀掉的 CLI 只发 FIN 不发关闭帧，基线 server 的 WebSocket 不处理半关闭（src/gateway/server/websocket.ts:19-20 只听 close / error），SIGTERM 后 server.close() 永远等不完（另一处挂起，见报告），所以用 SIGKILL 统一收尾，停机行为不在这些场景里比。",
  "gatewayPort": 18789,
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\ncron:\n  enabled: true\n",
  "files": {
    "home/.pilotdeck/server-token": "bbx-token\n",
    "home/.pilotdeck/projects/tmp-pdrs-bbx-root-proj/.cwd": "{PROJECT}\n"
  },
  "env": {
    "DOCKER_CONTAINER": "1",
    "COMMIT_HASH": "bbx"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Cron\"}"
      }
    },
    {
      "name": "hang",
      "when": [
        "cron-turn: hang"
      ],
      "reply": {
        "text": "Late.",
        "delayMs": 15000
      }
    },
    {
      "name": "main",
      "reply": {
        "text": "Cron ran."
      }
    }
  ],
  "steps": [
    {
      "ws": "cron_create",
      "params": {
        "projectKey": "{PROJECT}",
        "message": "first",
        "schedule": {
          "type": "cron",
          "expression": "0 9 * * *"
        }
      },
      "save": {
        "t1": "taskId\\W+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
      }
    },
    {
      "ws": "cron_create",
      "params": {
        "projectKey": "{PROJECT}",
        "message": "second",
        "schedule": {
          "type": "cron",
          "expression": "0 10 * * *"
        }
      },
      "save": {
        "t2": "taskId\\W+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
      }
    },
    {
      "ws": "cron_create",
      "params": {
        "projectKey": "{PROJECT}",
        "message": "cron-turn: hang",
        "schedule": {
          "type": "cron",
          "expression": "0 11 * * *"
        }
      },
      "save": {
        "t3": "taskId\\W+([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})"
      }
    },
    {
      "cli": [
        "cron",
        "delete",
        "{saved.t1}"
      ],
      "timeout": 4000,
      "expectTimeout": true
    },
    {
      "cli": [
