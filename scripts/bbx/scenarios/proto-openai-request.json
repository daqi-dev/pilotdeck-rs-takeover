{
 "name": "proto-openai-request",
 "about": "用公共 host 的 model_stream 直接驱动 OpenAI chat completions 请求组装（model/providers/openai/request.ts）与流解析（stream.ts）。o1 结构化输出→response_format（strict 缺省 true，schema 经 normalizeOpenAISchema）；o2 tool_choice required、metadata 值转字符串；o3 none + strict:false；o4 指定函数；o5 系统提示、max_tokens、用户图片、助手 thinking→reasoning_content、工具调用与结果、结果里的图片另起一条用户消息、只有 thinking 的助手消息；o6–o13 推理字段的各格式（model/thinking/registry.ts：openai reasoning_effort、关闭→none、qwen-cloud enable_thinking、qwen-local chat_template_kwargs、thinking-type、openrouter reasoning、moonshot kimi-k3 只发 reasoning_effort、ollama server-default）；o14/o15 speedMapping openai_service_tier→service_tier priority；o16 流里的 reasoning_content；o17 usage 带缓存命中；o18 finish_reason content_filter；o19 未知 finish_reason。已知不稳：响应头 date（与 module-host-model 相同，需要 volatile \\.http\\.headers\\.date$，本场景未加）。",
 "config": "schemaVersion: 1\nagent:\n  model: oa/gpt-bbx\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    oa:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-oa-key\n      speedMapping: openai_service_tier\n      models:\n        gpt-bbx:\n          multimodal:\n            input: [text, image, pdf]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-think:\n          thinking:\n            state: enabled\n            efforts: [low, high]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-off:\n          thinking:\n            state: disabled\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        qwen-local:\n          thinking:\n            state: enabled\n            efforts: [high]\n            format: qwen-local\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n        gpt-fast:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n            supportsSpeed: true\n    dashscope:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-dashscope-key\n      models:\n        qwen-think:\n          thinking:\n            state: enabled\n            efforts: [low]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n    deepseek:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-deepseek-key\n      models:\n        ds-think:\n          thinking:\n            state: enabled\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n    openrouter:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-openrouter-key\n      models:\n        or-think:\n          thinking:\n            state: enabled\n            efforts: [low]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n    moonshot:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-moonshot-key\n      models:\n        kimi-k3-bbx:\n          thinking:\n            state: enabled\n            efforts: [high]\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n    ollama:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-ollama-key\n      models:\n        llama-bbx:\n          thinking:\n            state: enabled\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
 "provider": [
  {
   "name": "o1",
   "when": [
    "o1: structured"
   ],
   "reply": {
    "text": "{\"value\":42,\"tags\":[\"a\"]}"
   }
  },
  {
   "name": "o16",
   "when": [
    "o16: reasoning stream"
   ],
   "reply": {
    "reasoning": "chain of thought",
    "chunks": [
     "an",
     "swer"
    ]
   }
  },
  {
   "name": "o17",
   "when": [
    "o17: cached usage"
   ],
   "reply": {
    "text": "cached",
    "usage": {
     "prompt_tokens": 100,
     "completion_tokens": 7,
     "total_tokens": 107,
     "prompt_tokens_details": {
      "cached_tokens": 64
     },
     "completion_tokens_details": {
      "reasoning_tokens": 3
     }
    }
   }
  },
  {
   "name": "o18",
   "when": [
    "o18: content filter"
   ],
   "reply": {
    "text": "partial",
    "finish": "content_filter"
   }
  },
  {
   "name": "o19",
   "when": [
    "o19: odd finish"
   ],
   "reply": {
    "text": "odd",
    "finish": "weird_reason"
   }
  },
  {
   "name": "other",
   "reply": {
    "text": "ok"
   }
  }
