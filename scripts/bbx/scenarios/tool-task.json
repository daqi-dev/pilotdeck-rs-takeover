{
  "name": "tool-task",
  "about": "task_*（bypassPermissions）与 gateway method background_tasks / background_task_stop：空列表、建任务后列表（运行中 / 已完成）、未知 taskId 的 output / wait / stop、参数非法；任务状态与输出的落盘。taskId 是随机 UUID，假 provider 不能把它带回下一次工具调用，所以按 id 读输出 / 等待 / 停止的成功路径不在本场景。",
  "files": {},
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-13-after-tool",
      "when": [
        "turn-13:",
        "\"tool_call_id\":\"call_bbx_13\""
      ],
      "reply": {
        "text": "Done 13."
      }
    },
    {
      "name": "turn-13",
      "when": [
        "turn-13:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_13",
          "name": "task_list",
          "arguments": {
            "status": 5
