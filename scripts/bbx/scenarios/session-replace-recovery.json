  "steps": [
    {
      "serve": [
        "server"
      ],
      "then": [
        {
          "ws": "read_session_messages",
          "params": {
            "sessionKey": "s-roll"
          }
        },
        {
          "ws": "read_session_messages",
          "params": {
            "sessionKey": "s-done"
          }
        },
        {
          "ws": "read_session_messages",
          "params": {
            "sessionKey": "s-nojournal"
          }
        },
        {
          "ws": "read_session_messages",
          "params": {
            "sessionKey": "s-orphan"
          }
        },
        {
          "disconnect": true
        }
      ]
    }
  ]
}
