{
  "name": "tool-subagent-input",
  "about": "send_message / subagent：参数校验与未知 subagent。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
      }
    },
    {
      "name": "turn-3",
      "when": [
        "turn-3:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_3",
          "name": "subagent",
          "arguments": {
            "description": "x"
          }
        }
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "send_message",
          "arguments": {
            "subagent_id": "nope",
            "message": "hello there"
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "send_message",
          "arguments": {
            "message": "hello there"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      }
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-2: run the tool"
      }
    },
    {
      "sleep": 300
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-3: run the tool"
      }
    },
    {
      "sleep": 300
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ]
}
