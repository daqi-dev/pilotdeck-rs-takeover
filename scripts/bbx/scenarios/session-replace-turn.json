{
  "name": "session-replace-turn",
  "about": "replace_last_turn 与 finalize_last_turn_replacement（编辑 / 重新生成最后一轮）：缺参数、expectedTurnId 不是最后一轮、准备替换（读会话、落盘的备份与日志）、重复准备被拒、事务挂起时提交别的 runId 被拒、未知 / 非法事务号、非法 action、回滚后读回原记录；再次准备后提交替换轮次（自动提交）、提交后再 finalize 被拒、读会话；替换轮次 provider 失败；另一会话在轮次进行中（挂在权限询问上）时 expectedTurnId 不符被拒、相符则中止该轮并替换首轮（去掉生成的标题），再回滚。",
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Replace run\"}" } },
    { "name": "turn-fail", "when": ["turn-4:"], "reply": { "status": 400, "body": { "error": { "message": "bbx forced failure" } } } },
    { "name": "turn-a", "when": ["turn-a:"], "reply": { "tool": { "id": "call_bbx_a", "name": "bash", "arguments": { "command": "echo needs-permission > made.txt" } } } },
    { "name": "main", "reply": { "text": "Answer." } }
  ],
  "steps": [
    { "ws": "submit_turn", "params": { "sessionKey": "s-rep", "channelKey": "test", "runId": "run-1", "message": "turn-1: first" }, "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-rep", "channelKey": "test", "runId": "run-2", "message": "turn-2: second" }, "timeout": 20000 },
    { "ws": "replace_last_turn", "params": {} },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "expectedTurnId": "run-2" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "replacementTurnId": "run-3" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "expectedTurnId": "run-1", "replacementTurnId": "run-3" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-missing", "expectedTurnId": "run-1", "replacementTurnId": "run-3" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "expectedTurnId": "run-2", "replacementTurnId": "run-3" }, "save": { "tx1": "\"transactionId\":\"([0-9a-f-]{36})\"" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-rep" } },
    { "ws": "list_sessions", "params": {} },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "expectedTurnId": "run-2", "replacementTurnId": "run-3" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-rep", "channelKey": "test", "runId": "run-other", "message": "turn-x: not the replacement" }, "timeout": 20000 },
    { "ws": "finalize_last_turn_replacement", "params": {} },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-rep", "transactionId": "00000000-0000-4000-8000-000000000000", "action": "rollback" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-rep", "transactionId": "not-a-uuid", "action": "rollback" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-rep", "transactionId": "{saved.tx1}", "action": "bogus" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-rep", "transactionId": "{saved.tx1}", "action": "rollback" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-rep", "transactionId": "{saved.tx1}", "action": "rollback" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-rep" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "expectedTurnId": "run-2", "replacementTurnId": "run-3" }, "save": { "tx2": "\"transactionId\":\"([0-9a-f-]{36})\"" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-rep", "channelKey": "test", "runId": "run-3", "message": "turn-3: edited second" }, "timeout": 20000 },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-rep", "transactionId": "{saved.tx2}", "action": "commit" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-rep" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-rep", "expectedTurnId": "run-3", "replacementTurnId": "run-4" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-rep", "channelKey": "test", "runId": "run-4", "message": "turn-4: provider fails" }, "timeout": 20000 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-rep" } },
    { "ws": "list_sessions", "params": {} },
    { "ws": "submit_turn", "params": { "sessionKey": "s-act", "channelKey": "test", "runId": "run-a", "message": "turn-a: ask" }, "timeout": 3000, "expectTimeout": true },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-act", "expectedTurnId": "run-zzz", "replacementTurnId": "run-b" } },
    { "ws": "replace_last_turn", "params": { "sessionKey": "s-act", "expectedTurnId": "run-a", "replacementTurnId": "run-b" }, "save": { "tx3": "\"transactionId\":\"([0-9a-f-]{36})\"" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-act" } },
    { "ws": "finalize_last_turn_replacement", "params": { "sessionKey": "s-act", "transactionId": "{saved.tx3}", "action": "rollback" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-act" } }
  ]
}
