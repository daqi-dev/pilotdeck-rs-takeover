{
  "name": "proto-openai-responses-basic",
  "about": "OpenAI Responses 协议（model/providerEndpoint.ts:101 POST <url>/v1/responses；providers/openai-responses/request.ts 请求体、stream.ts SSE 事件解析、response.ts 非流式解析；streaming/streamModel.ts:257-279 头 authorization: Bearer）。protocol: openai-responses 的 provider 指向假 provider。标题生成走非流式（session/title/SessionTitleGenerator.ts:74 complete）。o1 纯文本；o2 工具调用后回文本（历史里的 function_call / function_call_output）；o3 文本加两个工具调用；o4 推理摘要文本 + 分块文本，第二轮把 thinking 作为 input_text 回传；o5 400；o6 500（流式重试后出错）；o7 429；o8 用量带 cached_tokens / reasoning_tokens；o9 status incomplete（截断）；o10 response.failed 事件。比较请求的方法、路径、头、体和后续事件、落盘。",
  "config": "schemaVersion: 1\nagent:\n  model: resp/gpt-bbx\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    resp:\n      protocol: openai-responses\n      url: {MOCK}\n      apiKey: bbx-responses-key\n      retry:\n        baseDelayMs: 1\n        maxDelayMs: 1\n        jitter: 0\n      models:\n        gpt-bbx:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
  "files": { "home/.pilotdeck/a.txt": "alpha\n", "home/.pilotdeck/b.txt": "beta\n" },
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\":\"Resp\"}", "usage": { "prompt_tokens": 30, "completion_tokens": 5, "total_tokens": 35 } } },
    { "name": "o1", "when": ["o1:"], "reply": { "text": "Hello from Responses mock." } },
    { "name": "o2-done", "when": ["o2:", "\"call_id\":\"call_o2\",\"output\""], "reply": { "text": "o2 done." } },
    { "name": "o2", "when": ["o2:"], "reply": { "tool": { "id": "call_o2", "name": "read_file", "arguments": { "file_path": "a.txt" } } } },
    { "name": "o3-done", "when": ["o3:", "\"call_id\":\"call_o3b\",\"output\""], "reply": { "text": "o3 done." } },
    { "name": "o3", "when": ["o3:"], "reply": { "text": "Reading two.", "tools": [
      { "id": "call_o3a", "name": "read_file", "arguments": { "file_path": "a.txt" } },
      { "id": "call_o3b", "name": "read_file", "arguments": { "file_path": "b.txt" } } ] } },
    { "name": "o4-second", "when": ["o4:", "o4 again"], "reply": { "text": "o4 second answer." } },
    { "name": "o4", "when": ["o4:"], "reply": { "reasoning": "Let me think about o4.", "text": "o4 answer.", "chunks": ["o4 ", "answer."] } },
    { "name": "o5", "when": ["o5:"], "reply": { "status": 400, "body": { "error": { "message": "Invalid input from mock.", "type": "invalid_request_error", "param": "input", "code": "invalid_value" } } } },
    { "name": "o6", "when": ["o6:"], "reply": { "status": 500, "body": { "error": { "message": "The server had an error while processing your request.", "type": "server_error", "param": null, "code": null } } } },
    { "name": "o7", "when": ["o7:"], "reply": { "status": 429, "body": { "error": { "message": "Rate limit reached for requests", "type": "requests", "param": null, "code": "rate_limit_exceeded" } } } },
    { "name": "o8", "when": ["o8:"], "reply": { "text": "o8 usage.", "usage": { "prompt_tokens": 120, "completion_tokens": 40, "total_tokens": 160, "prompt_tokens_details": { "cached_tokens": 100 }, "completion_tokens_details": { "reasoning_tokens": 25 } } } },
    { "name": "o9-more", "when": ["o9:", "o9 cut"], "reply": { "text": " o9 rest." } },
    { "name": "o9", "when": ["o9:"], "reply": { "text": "o9 cut", "finish": "incomplete" } },
    { "name": "o10", "when": ["o10:"], "reply": { "text": "o10 partial", "finish": "failed", "error": { "code": "server_error", "message": "Responses stream failed in mock." } } }
  ],
  "steps": [
    { "ws": "submit_turn", "params": { "sessionKey": "s-o1", "channelKey": "test", "message": "o1: hi" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-o1" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o2", "channelKey": "test", "message": "o2: read" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o3", "channelKey": "test", "message": "o3: read two" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-o3" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o4", "channelKey": "test", "message": "o4: think" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o4", "channelKey": "test", "message": "o4 again" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-o4" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o5", "channelKey": "test", "message": "o5: fail" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o6", "channelKey": "test", "message": "o6: server" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o7", "channelKey": "test", "message": "o7: limited" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-o7" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o8", "channelKey": "test", "message": "o8: usage" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "usage_snapshot", "params": { "sessionKey": "s-o8" } },
    { "ws": "model_usage_snapshot", "params": { "sessionKey": "s-o8" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o9", "channelKey": "test", "message": "o9: long" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-o9" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-o10", "channelKey": "test", "message": "o10: failed" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-o10" } }
  ]
}
