{
  "name": "permission-remember",
  "about": "批准并记住（remember）：同一会话里同一工具第二次不再询问；别的工具仍然询问；之后列出待决权限。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
      }
    },
    {
      "name": "turn-3",
      "when": [
        "turn-3:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_3",
          "name": "update_goal",
          "arguments": {
            "status": "complete"
          }
        }
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "create_goal",
          "arguments": {
            "objective": "second"
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "create_goal",
          "arguments": {
            "objective": "first",
            "id": "goal-bbx"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-bbx-1",
            "requestId": "{event.requestId}",
            "decision": "allow",
            "remember": true
          }
        }
      ],
      "timeout": 15000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-2: run the tool"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-bbx-1",
            "requestId": "{event.requestId}",
            "decision": "deny",
            "reason": "should not be asked"
          }
        }
      ],
      "timeout": 15000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-3: run the tool"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-bbx-1",
            "requestId": "{event.requestId}",
            "decision": "deny",
            "reason": "other tool"
          }
        }
      ],
      "timeout": 15000
    },
    {
      "ws": "permission_list",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ]
}
