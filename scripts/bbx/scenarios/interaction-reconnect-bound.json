{
  "name": "interaction-reconnect-bound",
  "about": "reconnect_interaction 带正确 previousBinding 的成功路径：先在第一条连接上绑定会话（connectionId 用 save 存下），提交一轮挂在权限询问上，断开、重连，用存下的 connectionId 作 previousBinding 重新挂接，看挂起的权限询问是否转到新连接（permission_list、permission_decide 允许后轮次跑完）、再挂接一次（旧绑定已失效）。",
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Reconnect run\"}" } },
    { "name": "turn-1-after-tool", "when": ["turn-1:", "\"tool_call_id\":\"call_bbx_1\""], "reply": { "text": "Done 1." } },
    { "name": "turn-1", "when": ["turn-1:"], "reply": { "tool": { "id": "call_bbx_1", "name": "bash", "arguments": { "command": "echo needs-permission > made.txt" } } } }
  ],
  "steps": [
    { "ws": "reconnect_interaction", "params": { "sessionKey": "s-bbx-1" }, "save": { "cid": "\"connectionId\":\"([^\"]+)\"" } },
    {
      "ws": "submit_turn",
      "params": { "sessionKey": "s-bbx-1", "channelKey": "test", "runId": "run-bbx-1", "message": "turn-1: ask" },
      "timeout": 8000,
      "expectTimeout": true
    },
    { "ws": "permission_list", "params": { "sessionKey": "s-bbx-1" }, "save": { "rid": "\"requestId\":\"([^\"]+)\"" } },
    { "disconnect": true },
    { "sleep": 500 },
    { "connect": true },
    { "ws": "reconnect_interaction", "params": { "sessionKey": "s-bbx-1", "previousBinding": { "connectionId": "{saved.cid}", "generation": 1 } } },
    { "ws": "permission_list", "params": { "sessionKey": "s-bbx-1" } },
    { "ws": "reconnect_interaction", "params": { "sessionKey": "s-bbx-1", "previousBinding": { "connectionId": "{saved.cid}", "generation": 1 } } },
    { "ws": "permission_decide", "params": { "sessionKey": "s-bbx-1", "requestId": "{saved.rid}", "decision": "allow" } },
    { "sleep": 3000 },
    { "ws": "active_turn_snapshot", "params": { "sessionKey": "s-bbx-1", "includeEvents": false } },
    { "ws": "run_get", "params": { "sessionKey": "s-bbx-1", "runId": "run-bbx-1" } }
  ]
}
