{
  "name": "permission-allow-create-goal",
  "about": "create_goal：默认权限模式 → 询问 → 批准 → 执行。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Tool run\"}"
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "create_goal",
          "arguments": {
            "objective": "needs approval",
            "id": "goal-bbx"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: run the tool"
      },
      "answer": [
        {
          "on": {
            "type": "permission_request"
          },
          "ws": "permission_decide",
          "params": {
            "sessionKey": "s-bbx-1",
            "requestId": "{event.requestId}",
            "decision": "allow"
          }
        }
      ],
      "timeout": 15000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ]
}
