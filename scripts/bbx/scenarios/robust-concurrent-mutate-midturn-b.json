{
  "name": "robust-concurrent-mutate-midturn-b",
  "about": "轮次进行中（bash sleep 2 期间）调 close_session、delete_session、fork_session（从上一轮的用户消息分叉）：各自的回答、进行中轮次的结局（被中止？跑完？）、会话文件是否还在、list_sessions、分叉出的会话内容。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Robust run\"}"
      }
    },
    {
      "name": "turn-3-after-tool",
      "when": [
        "turn-3:",
        "\"tool_call_id\":\"call_bbx_3\""
      ],
      "reply": {
        "text": "Done 3."
      }
    },
    {
      "name": "turn-3",
      "when": [
        "turn-3:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_3",
          "name": "bash",
          "arguments": {
            "command": "sleep 2; echo t3 > t3.txt"
          }
        }
      }
    },
    {
      "name": "turn-2-after-tool",
      "when": [
        "turn-2:",
        "\"tool_call_id\":\"call_bbx_2\""
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_2",
          "name": "bash",
          "arguments": {
            "command": "sleep 2; echo t2 > t2.txt"
          }
        }
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "bash",
          "arguments": {
            "command": "sleep 2; echo t1 > t1.txt"
          }
        }
      }
    },
    {
      "name": "turn-4",
      "when": [
        "turn-4:"
      ],
      "reply": {
        "text": "Done 4."
      }
    }
  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-c",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-c",
        "channelKey": "test",
        "message": "turn-1: sleep",
        "runId": "run-bbx-1"
      },
      "timeout": 20000,
      "answer": [
        {
          "on": {
            "type": "tool_call_started"
          },
          "ws": "close_session",
          "params": {
            "sessionKey": "s-c"
          },
          "count": 1
        }
      ]
    },
    {
      "sleep": 2500
    },
    {
      "ws": "run_get",
      "params": {
        "sessionKey": "s-c",
        "runId": "run-bbx-1"
      }
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-d",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-d",
        "channelKey": "test",
        "message": "turn-2: sleep",
        "runId": "run-bbx-2"
      },
      "timeout": 20000,
      "answer": [
        {
          "on": {
            "type": "tool_call_started"
          },
          "ws": "delete_session",
          "params": {
            "sessionKey": "s-d"
          },
          "count": 1
        }
      ]
    },
    {
      "sleep": 2500
    },
    {
      "ws": "run_get",
      "params": {
        "sessionKey": "s-d",
        "runId": "run-bbx-2"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-f",
        "channelKey": "test",
        "message": "turn-4: first",
        "runId": "run-bbx-4"
      },
      "timeout": 15000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-f"
      },
      "save": {
        "eid": "\"role\":\"user\",\"kind\":\"text\",\"text\":\"turn-4: first\",\"entryId\":\"([^\"]+)\""
      }
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-f",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-f",
        "channelKey": "test",
        "message": "turn-3: sleep",
        "runId": "run-bbx-3"
      },
      "timeout": 20000,
      "answer": [
        {
          "on": {
            "type": "tool_call_started"
          },
          "ws": "fork_session",
          "params": {
            "sessionKey": "s-f",
            "fromEntryId": "{saved.eid}"
          },
          "count": 1
        }
      ]
    },
    {
      "sleep": 2500
    },
    {
      "ws": "list_sessions",
      "params": {}
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-c"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-d"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-f"
      }
    }
  ]
}
