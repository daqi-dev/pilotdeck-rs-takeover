  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-sh-timeout",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-sh-timeout",
        "channelKey": "test",
        "message": "sh-timeout: go",
        "timeoutMs": 1500
      },
      "timeout": 20000
    },
    {
      "sleep": 4500
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-sh-timeout",
        "channelKey": "test",
        "message": "next-sh-timeout: again"
      },
      "timeout": 20000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-sh-timeout"
      }
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-st-timeout",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-st-timeout",
        "channelKey": "test",
