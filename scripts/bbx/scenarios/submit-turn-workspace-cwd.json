{
  "name": "submit-turn-workspace-cwd",
  "about": "submit_turn.workspaceCwd：新建会话时作为会话 cwd（系统提示词的 cwd 行、bash 工作目录、相对路径解析、工作区边界、写文件落点）；同一会话后续轮次换 workspaceCwd 是否生效；workspaceCwd 不存在、是文件、是相对路径时的行为。",
  "files": {
    "proj/note.txt": "project note\n",
    "home/work/other/inner.txt": "inner body\n",
    "home/work/afile.txt": "a file\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Cwd run\"}"
      }
    },
    {
      "name": "t6b-after",
      "when": [
        "t6b:",
        "\"tool_call_id\":\"call_cwd_t6b\""
      ],
      "reply": {
        "text": "Done t6b."
      }
    },
    {
      "name": "t6b",
      "when": [
        "t6b:"
      ],
      "reply": {
        "tool": {
          "id": "call_cwd_t6b",
          "name": "read_file",
          "arguments": {
            "file_path": "inner.txt"
          }
        }
      }
    },
    {
      "name": "t6a-after",
      "when": [
        "t6a:",
        "\"tool_call_id\":\"call_cwd_t6a\""
      ],
      "reply": {
        "text": "Done t6a."
      }
    },
    {
      "name": "t6a",
      "when": [
        "t6a:"
      ],
      "reply": {
        "tool": {
          "id": "call_cwd_t6a",
          "name": "read_file",
          "arguments": {
            "file_path": "{PROJECT}/note.txt"
          }
        }
      }
    },
    {
      "name": "t5c-after",
      "when": [
        "t5c:",
        "\"tool_call_id\":\"call_cwd_t5c\""
      ],
      "reply": {
        "text": "Done t5c."
      }
    },
    {
      "name": "t5c",
      "when": [
        "t5c:"
      ],
      "reply": {
        "tool": {
          "id": "call_cwd_t5c",
          "name": "write_file",
          "arguments": {
            "file_path": "made-rel.txt",
            "content": "rel\n"
          }
        }
      }
    },
    {
      "name": "t5b-after",
      "when": [
        "t5b:",
