  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-cwd",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-cwd",
        "channelKey": "test",
        "message": "t1a: run",
        "workspaceCwd": "{HOME}/work/other"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-cwd",
        "channelKey": "test",
        "message": "t1b: read"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-cwd",
        "channelKey": "test",
        "message": "t1c: read outside"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-cwd",
        "channelKey": "test",
        "message": "t1d: write"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-cwd",
        "channelKey": "test",
        "message": "t2a: switch cwd",
        "workspaceCwd": "{PROJECT}"
      },
      "timeout": 30000
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-missing",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-missing",
        "channelKey": "test",
        "message": "t3a: missing dir",
        "workspaceCwd": "{HOME}/work/missing"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-missing",
        "channelKey": "test",
        "message": "t3b: read in missing"
      },
      "timeout": 30000
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-file",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-file",
        "channelKey": "test",
        "message": "t4a: file cwd",
        "workspaceCwd": "{HOME}/work/afile.txt"
      },
      "timeout": 30000
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-rel",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-rel",
        "channelKey": "test",
        "message": "t5a: relative cwd",
        "workspaceCwd": "work/other"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-rel",
        "channelKey": "test",
        "message": "t5b: relative read"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-rel",
        "channelKey": "test",
        "message": "t5c: relative write"
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-def",
        "channelKey": "test",
        "message": "t6a: outside in default mode",
        "workspaceCwd": "{HOME}/work/other",
        "canPrompt": false
      },
      "timeout": 30000
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-def",
        "channelKey": "test",
        "message": "t6b: inside in default mode",
        "canPrompt": false
