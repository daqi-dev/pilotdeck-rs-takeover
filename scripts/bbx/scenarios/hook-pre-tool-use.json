{
  "name": "hook-pre-tool-use",
  "about": "插件的 PreToolUse hook（bash，bypassPermissions）：多条 hook 的执行顺序（同 matcher 两条、正则 matcher、多选 matcher；write_file 的 matcher 不跑）、退出码 2 阻止、JSON permissionDecision deny（带 / 不带理由）、decision:block、continue:false、updatedInput 改写（改写后的命令真的执行）与改写成非法输入、stdout 非法、退出码 1、matcher 不匹配。hook 收到的 stdin、工作目录、环境变量落盘在 home/hooklog。",
  "files": {
    "home/.pilotdeck/plugins/bbx-pre/plugin.json": {
      "name": "bbx-pre",
      "version": "0.1.0",
      "description": "bbx bbx-pre",
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '' '' 0 first",
                "if": "bash(case-order)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '' '' 0 second",
                "if": "bash(case-order)"
              }
            ]
          },
          {
            "matcher": "write_file",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '' '' 0 write-file-never",
                "if": "bash(case-order)"
              }
            ]
          },
          {
            "matcher": "/^ba/",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '' '' 0 regex",
                "if": "bash(case-order)"
              }
            ]
          },
          {
            "matcher": "edit_file|bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '' '' 0 alternatives",
                "if": "bash(case-order)"
              }
            ]
          },
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 2 '' 'blocked by hook\n' 0",
                "if": "bash(case-block)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"denied by hook\"}}\n' '' 0",
                "if": "bash(case-deny-reason)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\"}}\n' '' 0",
                "if": "bash(case-deny-bare)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"decision\":\"block\",\"reason\":\"json block reason\"}\n' '' 0",
                "if": "bash(case-json-block)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"continue\":false,\"stopReason\":\"stop reason only\"}\n' '' 0",
                "if": "bash(case-stop)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"command\":\"printf rewritten > rewritten.txt\",\"description\":\"rewritten by hook\"}}}\n' '' 0",
                "if": "bash(case-rewrite-ok)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"updatedInput\":{\"cmd\":1}}}\n' '' 0",
                "if": "bash(case-rewrite-bad)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 'not json\n{broken\n' '' 0",
                "if": "bash(case-garbage)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 1 'partial' 'boom\n' 0",
                "if": "bash(case-fail)"
              }
            ]
          },
          {
            "matcher": "read_file",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '' '' 0",
                "if": "read_file(case-nomatch)"
              }
            ]
          }
        ]
      }
    },
    "home/.pilotdeck/plugins/bbx-pre/hook.mjs": "// bbx hook fixture: node hook.mjs <log> <exit> [stdout] [stderr] [sleepMs]\nimport fs from 'node:fs';\nconst [log, exit = '0', out = '', err = '', sleep = '0'] = process.argv.slice(2);\nconst dir = process.env.HOME + '/hooklog';\nconst append = (row) => { fs.mkdirSync(dir, { recursive: true }); fs.appendFileSync(dir + '/' + log + '.jsonl', JSON.stringify(row) + '\\n'); };\nlet input = '';\nprocess.stdin.on('data', (d) => { input += d; });\nprocess.stdin.on('end', () => {\n  let parsed; try { parsed = JSON.parse(input); } catch { parsed = { raw: input }; }\n  const env = {};\n  for (const k of Object.keys(process.env).sort()) env[k] = /^PILOT/.test(k) && !/BUNDLED/.test(k) ? process.env[k] : true;\n  append({ argv: process.argv.slice(2), cwd: process.cwd(), input: parsed, env });\n  // exit \"@\": the behaviour is the JSON between HOOK<< and >> in the prompt (or the last assistant message).\n  let spec = { exit, out, err, sleep };\n  if (exit === '@') {\n    const m = /HOOK<<(.*?)>>/s.exec(String(parsed.prompt ?? parsed.lastAssistantMessage ?? ''));\n    spec = { exit: 0, out: '', err: '', sleep: 0, ...(m ? JSON.parse(m[1]) : {}) };\n  }\n  setTimeout(() => {\n    append({ argv: process.argv.slice(2), done: true });\n    if (spec.out) process.stdout.write(spec.out);\n    if (spec.err) process.stderr.write(spec.err);\n    process.exit(Number(spec.exit));\n  }, Number(spec.sleep));\n});\n"
  },
