{
  "name": "params-session-lifecycle",
  "about": "会话生命周期类可选参数：list_sessions.cursor（GatewaySessionCatalog.ts:24-35，`cursor ? parseInt(cursor, 10) : 0`，非有限值为 0，负数参与下一页游标计算）取数字前缀串、带前导空白、科学计数、负数、十六进制、非数字、数字、布尔、数组、对象；new_session.hint（InProcessGateway.ts:2030-2034 不读）取字符串 / 数字；abort_turn.reason 与 close_session.reason 在轮次挂在权限询问上时取字符串 / 空串 / 数字，比较事件、权限列表与会话记录。",
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\": \"Lifecycle run\"}" } },
    { "name": "turn", "when": ["lc-"], "reply": { "tool": { "id": "call_lc", "name": "bash", "arguments": { "command": "echo lc > lc.txt" } } } }
  ],
  "steps": [
    { "ws": "new_session", "params": { "channelKey": "web", "hint": "a hint" }, "save": { "n1": "\"sessionKey\":\"([^\"]+)\"" } },
    { "ws": "new_session", "params": { "channelKey": "web", "hint": 5 } },
    { "ws": "new_session", "params": { "channelKey": "web", "hint": "", "projectKey": "{PROJECT}" } },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-lc-1", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "title": "One", "messages": [{ "role": "user", "text": "one" }] } } },
    { "sleep": 30 },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-lc-2", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "title": "Two", "messages": [{ "role": "user", "text": "two" }] } } },
    { "sleep": 30 },
    { "ws": "restore_session_transcript", "params": { "sessionKey": "s-lc-3", "archive": { "schemaVersion": 1, "format": "portable_text_messages", "title": "Three", "messages": [{ "role": "user", "text": "three" }] } } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "1" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "2abc" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "  1" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "1e1" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "-1" } },
    { "ws": "list_sessions", "params": { "limit": 2, "cursor": "-5" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "0x2" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "abc" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": "" } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": 2 } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": true } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": [2] } },
    { "ws": "list_sessions", "params": { "limit": 1, "cursor": {} } },
    { "ws": "list_sessions", "params": { "cursor": "1" } },
    { "ws": "list_sessions", "params": { "limit": 5, "cursor": "2" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-ab-1", "channelKey": "test", "runId": "run-ab-1", "message": "lc-ab1: write" }, "answer": [{ "on": { "type": "permission_request" }, "ws": "abort_turn", "params": { "sessionKey": "s-ab-1", "reason": "user pressed stop" }, "count": 1 }], "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-ab-2", "channelKey": "test", "runId": "run-ab-2", "message": "lc-ab2: write" }, "answer": [{ "on": { "type": "permission_request" }, "ws": "abort_turn", "params": { "sessionKey": "s-ab-2", "runId": "run-ab-2", "reason": "" }, "count": 1 }], "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-ab-3", "channelKey": "test", "runId": "run-ab-3", "message": "lc-ab3: write" }, "answer": [{ "on": { "type": "permission_request" }, "ws": "abort_turn", "params": { "sessionKey": "s-ab-3", "reason": 42 }, "count": 1 }], "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-cl-1", "channelKey": "test", "runId": "run-cl-1", "message": "lc-cl1: write" }, "answer": [{ "on": { "type": "permission_request" }, "ws": "close_session", "params": { "sessionKey": "s-cl-1", "reason": "closing from ui" }, "count": 1 }], "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-cl-2", "channelKey": "test", "runId": "run-cl-2", "message": "lc-cl2: write" }, "answer": [{ "on": { "type": "permission_request" }, "ws": "close_session", "params": { "sessionKey": "s-cl-2", "reason": 7 }, "count": 1 }], "timeout": 20000 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-cl-3", "channelKey": "test", "runId": "run-cl-3", "message": "lc-cl3: write" }, "answer": [{ "on": { "type": "permission_request" }, "ws": "close_session", "params": { "sessionKey": "s-cl-3", "reason": "" }, "count": 1 }], "timeout": 20000 },
    { "ws": "close_session", "params": { "sessionKey": "s-lc-1", "reason": "idle close" } },
    { "sleep": 500 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-ab-1" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-ab-3" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-cl-1" } },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-cl-2" } }
  ]
}
