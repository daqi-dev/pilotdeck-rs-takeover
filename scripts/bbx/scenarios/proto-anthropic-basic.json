{
  "name": "proto-anthropic-basic",
  "about": "Anthropic messages 协议（model/providerEndpoint.ts:99 POST <url>/v1/messages；streaming/streamModel.ts:819-833 头 x-api-key、anthropic-version；providers/anthropic/request.ts 请求体、stream.ts SSE 解析）。protocol: anthropic 的 provider 指向假 provider。a1 纯文本；a2 工具调用后回文本（历史里的 tool_use / tool_result 形状）；a3 文本加两个工具调用；a4 带 thinking 块的回复（下一轮历史里回传 thinking + signature）；a5 400 invalid_request_error；a6 529 overloaded_error（重试）；a7 429 rate_limit_error。比较请求的方法、路径、头、体和后续事件、落盘。",
  "volatile": ["/chats/s-a[234]\\.jsonl\\.jsonl\\[\\d+\\]\\.request\\.cachePlan\\.fingerprint$"],
  "config": "schemaVersion: 1\nagent:\n  model: anth/claude-bbx\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    anth:\n      protocol: anthropic\n      url: {MOCK}\n      apiKey: bbx-anthropic-key\n      retry:\n        baseDelayMs: 1\n        maxDelayMs: 1\n        jitter: 0\n      models:\n        claude-bbx:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
  "files": { "home/.pilotdeck/a.txt": "alpha\n", "home/.pilotdeck/b.txt": "beta\n" },
  "provider": [
    { "name": "title", "when": ["Generate a concise title"], "reply": { "text": "{\"title\":\"Anth\"}" } },
    { "name": "a1", "when": ["a1:"], "reply": { "text": "Hello from Anthropic mock." } },
    { "name": "a2-done", "when": ["a2:", "\"tool_use_id\":\"toolu_a2\""], "reply": { "text": "a2 done." } },
    { "name": "a2", "when": ["a2:"], "reply": { "tool": { "id": "toolu_a2", "name": "read_file", "arguments": { "file_path": "a.txt" } } } },
    { "name": "a3-done", "when": ["a3:", "\"tool_use_id\":\"toolu_a3b\""], "reply": { "text": "a3 done." } },
    { "name": "a3", "when": ["a3:"], "reply": { "text": "Reading two.", "tools": [
      { "id": "toolu_a3a", "name": "read_file", "arguments": { "file_path": "a.txt" } },
      { "id": "toolu_a3b", "name": "read_file", "arguments": { "file_path": "b.txt" } } ] } },
    { "name": "a4-second", "when": ["a4:", "a4 again"], "reply": { "text": "a4 second answer." } },
    { "name": "a4", "when": ["a4:"], "reply": { "reasoning": "Let me think about a4.", "text": "a4 answer.", "chunks": ["a4 ", "answer."] } },
    { "name": "a5", "when": ["a5:"], "reply": { "status": 400, "body": { "type": "error", "error": { "type": "invalid_request_error", "message": "messages: bad request from mock" } } } },
    { "name": "a6", "when": ["a6:"], "reply": { "status": 529, "body": { "type": "error", "error": { "type": "overloaded_error", "message": "Overloaded" } } } },
    { "name": "a7", "when": ["a7:"], "reply": { "status": 429, "body": { "type": "error", "error": { "type": "rate_limit_error", "message": "Number of requests has exceeded your rate limit" } } } }
  ],
  "steps": [
    { "ws": "submit_turn", "params": { "sessionKey": "s-a1", "channelKey": "test", "message": "a1: hi" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-a1" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a2", "channelKey": "test", "message": "a2: read" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a3", "channelKey": "test", "message": "a3: read two" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-a3" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a4", "channelKey": "test", "message": "a4: think" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a4", "channelKey": "test", "message": "a4 again" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-a4" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a5", "channelKey": "test", "message": "a5: fail" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a6", "channelKey": "test", "message": "a6: overloaded" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-a7", "channelKey": "test", "message": "a7: limited" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-a7" } }
  ]
}
