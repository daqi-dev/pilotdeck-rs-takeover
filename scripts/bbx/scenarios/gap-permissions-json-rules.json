{
 "name": "gap-permissions-json-rules",
 "about": "预先写好的 ~/.pilotdeck/permissions.json（permission/settings.ts 读取与 normalizePermissionEntry 的 Claude 风格别名 Bash(...) / Read / Write，InProcessGateway.ts:1441-1457 每轮读入）：默认权限模式下，命中 allowedTools 的 bash（touch allowed*，非只读命令）直接执行，命中 disallowedTools 的被拒，都不命中的发权限询问（采集器拒绝），Read 别名放行读文件，Write 被 disallowedTools 拒；重复项、空白项、非字符串项被忽略。",
 "files": {
  "home/.pilotdeck/permissions.json": {
   "version": 1,
   "allowedTools": [
    "Bash(touch allowed*)",
    "Read",
    "  ",
    42,
    "Read"
   ],
   "disallowedTools": [
    "Bash(rm *)",
    "Write"
   ],
   "askTools": []
  },
  "home/.pilotdeck/notes/p.txt": "perm\n"
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "t05-after",
   "when": [
    "g05:",
    "\"tool_call_id\":\"call_g05\""
   ],
   "reply": {
    "text": "Done 05."
   }
  },
  {
   "name": "t05",
   "when": [
    "g05:"
   ],
   "reply": {
    "tool": {
     "id": "call_g05",
     "name": "write_file",
     "arguments": {
      "file_path": "notes/new.txt",
      "content": "x"
     }
    }
   }
  },
  {
   "name": "t04-after",
   "when": [
    "g04:",
    "\"tool_call_id\":\"call_g04\""
   ],
   "reply": {
    "text": "Done 04."
   }
  },
  {
   "name": "t04",
   "when": [
    "g04:"
   ],
   "reply": {
    "tool": {
     "id": "call_g04",
     "name": "read_file",
     "arguments": {
      "file_path": "notes/p.txt"
     }
    }
   }
  },
  {
   "name": "t03-after",
   "when": [
    "g03:",
    "\"tool_call_id\":\"call_g03\""
   ],
   "reply": {
    "text": "Done 03."
   }
  },
  {
   "name": "t03",
   "when": [
    "g03:"
   ],
   "reply": {
    "tool": {
     "id": "call_g03",
     "name": "bash",
     "arguments": {
      "command": "touch not-listed"
     }
    }
   }
  },
  {
   "name": "t02-after",
   "when": [
    "g02:",
    "\"tool_call_id\":\"call_g02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "t02",
   "when": [
    "g02:"
   ],
   "reply": {
    "tool": {
     "id": "call_g02",
     "name": "bash",
     "arguments": {
      "command": "rm -f nothing-here"
     }
    }
   }
  },
  {
   "name": "t01-after",
   "when": [
    "g01:",
    "\"tool_call_id\":\"call_g01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "t01",
   "when": [
    "g01:"
   ],
   "reply": {
    "tool": {
     "id": "call_g01",
     "name": "bash",
     "arguments": {
      "command": "touch allowed-one"
     }
    }
   }
  }
 ],
