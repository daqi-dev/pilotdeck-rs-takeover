 "steps": [
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-e1",
    "channelKey": "test",
    "runId": "run-e1",
    "message": "e1: go",
    "canPrompt": false,
    "canElicit": true
   },
   "answer": [
    {
     "on": {
      "type": "elicitation_request"
     },
     "ws": "elicitation_respond",
     "params": {
      "sessionKey": "s-e1",
      "requestId": "{event.requestId}",
      "answer": {
       "type": "answered",
       "answers": {
        "Which color?": "Blue"
       }
      }
     },
     "count": 1
    },
    {
     "on": {
      "type": "permission_request"
     },
     "ws": "permission_decide",
     "params": {
      "sessionKey": "s-e1",
      "requestId": "{event.requestId}",
      "decision": "deny",
      "reason": "bbx denies"
     }
    }
   ],
   "timeout": 20000
  },
  {
   "sleep": 300
