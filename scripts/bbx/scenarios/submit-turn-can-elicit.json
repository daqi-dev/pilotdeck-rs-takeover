{
 "name": "submit-turn-can-elicit",
 "about": "submit_turn 的 canElicit：canPrompt=false 时，canElicit=true 让 ask_user_question 仍声明给模型并经专用 elicitation 询问（src/agent/loop/AgentLoop.ts:2328-2337、src/tool/execution/ToolRuntime.ts:170-183），elicitationAvailable 取会话是否有 elicitation 端口（src/agent/loop/AgentTurnCapabilities.ts:291）；不带 / false 时该工具不声明、调用被拒；canElicit 不放开其它需要询问的工具（bash）；canPrompt 缺省时 canElicit 无影响。",
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\": \"Elicit run\"}"
   }
  },
  {
   "name": "e1-after",
   "when": [
    "e1:",
    "\"tool_call_id\":\"call_e_1\""
   ],
   "reply": {
    "text": "Done e1."
   }
  },
  {
   "name": "e1",
   "when": [
    "e1:"
   ],
   "reply": {
    "tool": {
     "id": "call_e_1",
     "name": "ask_user_question",
     "arguments": {
      "questions": [
       {
        "question": "Which color?",
        "header": "Color",
        "options": [
         {
          "label": "Red",
          "description": "warm"
         },
         {
          "label": "Blue",
          "description": "cool"
         }
        ],
        "multiSelect": false
       }
      ]
     }
    }
   }
  },
