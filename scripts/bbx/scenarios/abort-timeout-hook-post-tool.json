{
  "name": "abort-timeout-hook-post-tool",
  "about": "超时列（submit_turn.timeoutMs，从 abort-hook-post-tool 拆出）：中止落在 PostToolUse hook 执行中（ToolRuntime.ts:387-394）：abort_turn、close_session、timeoutMs。比较 hook 是否被杀、工具结果是否保留、帧、会话记录、下一轮。",
  "files": {
    "home/.pilotdeck/plugins/bbx-abort/plugin.json": {
      "name": "bbx-abort",
      "version": "0.1.0",
      "description": "bbx bbx-abort",
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "cat >/dev/null; sleep 3"
              }
            ]
          }
        ]
      }
    },
    "home/.pilotdeck/plugins/bbx-abort/hook.mjs": "// bbx hook fixture: node hook.mjs <log> <exit> [stdout] [stderr] [sleepMs]\nimport fs from 'node:fs';\nconst [log, exit = '0', out = '', err = '', sleep = '0'] = process.argv.slice(2);\nconst dir = process.env.HOME + '/hooklog';\nconst append = (row) => { fs.mkdirSync(dir, { recursive: true }); fs.appendFileSync(dir + '/' + log + '.jsonl', JSON.stringify(row) + '\\n'); };\nlet input = '';\nprocess.stdin.on('data', (d) => { input += d; });\nprocess.stdin.on('end', () => {\n  let parsed; try { parsed = JSON.parse(input); } catch { parsed = { raw: input }; }\n  const keep = {};\n  for (const k of ['hook_event_name', 'hookEventName', 'tool_name', 'toolName', 'error', 'isInterrupt', 'is_interrupt', 'prompt', 'reason', 'stopHookActive']) if (k in parsed) keep[k] = parsed[k];\n  append({ argv: process.argv.slice(2), input: keep });\n  setTimeout(() => {\n    append({ argv: process.argv.slice(2), done: true });\n    if (out) process.stdout.write(out);\n    if (err) process.stderr.write(err);\n    process.exit(Number(exit));\n  }, Number(sleep));\n});\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Abort run\"}"
      }
    },
    {
      "name": "next-ho-run",
      "when": [
        "next-ho-run:"
      ],
      "reply": {
        "text": "Next ho-run."
      }
    },
    {
      "name": "ho-run-after",
      "when": [
        "ho-run:",
        "\"tool_call_id\":\"call_ho_run\""
      ],
      "reply": {
        "text": "Done ho-run."
      }
    },
    {
      "name": "ho-run",
      "when": [
        "ho-run:"
      ],
      "reply": {
        "tool": {
          "id": "call_ho_run",
          "name": "bash",
          "arguments": {
            "command": "echo ran > ran-ho-run.txt",
            "description": "ho-run"
          }
        }
      }
    },
    {
      "name": "next-ho-close",
      "when": [
        "next-ho-close:"
      ],
      "reply": {
        "text": "Next ho-close."
      }
    },
    {
      "name": "ho-close-after",
      "when": [
        "ho-close:",
        "\"tool_call_id\":\"call_ho_close\""
      ],
      "reply": {
        "text": "Done ho-close."
      }
    },
    {
      "name": "ho-close",
      "when": [
        "ho-close:"
      ],
      "reply": {
        "tool": {
          "id": "call_ho_close",
          "name": "bash",
          "arguments": {
            "command": "echo ran > ran-ho-close.txt",
            "description": "ho-close"
          }
        }
      }
    },
    {
      "name": "next-ho-timeout",
      "when": [
        "next-ho-timeout:"
      ],
      "reply": {
        "text": "Next ho-timeout."
      }
    },
    {
      "name": "ho-timeout-after",
      "when": [
        "ho-timeout:",
        "\"tool_call_id\":\"call_ho_timeout\""
      ],
      "reply": {
        "text": "Done ho-timeout."
      }
    },
    {
      "name": "ho-timeout",
      "when": [
        "ho-timeout:"
      ],
      "reply": {
        "tool": {
          "id": "call_ho_timeout",
          "name": "bash",
          "arguments": {
            "command": "echo ran > ran-ho-timeout.txt",
            "description": "ho-timeout"
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-ho-timeout",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-ho-timeout",
        "channelKey": "test",
        "message": "ho-timeout: go",
        "timeoutMs": 1500
      },
      "timeout": 20000
    },
    {
      "sleep": 3500
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-ho-timeout",
        "channelKey": "test",
        "message": "next-ho-timeout: again"
      },
      "timeout": 20000
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-ho-timeout"
      }
    }
  ]
}
