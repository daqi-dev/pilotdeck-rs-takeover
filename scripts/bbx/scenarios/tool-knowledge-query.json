     "name": "knowledge_query",
     "arguments": {
      "query": "make it fail"
     }
    }
   }
  },
  {
   "name": "q01-after",
   "when": [
    "q01:",
    "\"tool_call_id\":\"call_q01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "q01",
   "when": [
    "q01:"
