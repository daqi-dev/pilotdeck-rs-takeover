   "reply": {
    "tool": {
     "id": "call_q01",
     "name": "knowledge_query",
     "arguments": {
      "query": "what is bbx",
      "knowledge_base_ids": [
       "kb-1"
      ]
     }
    }
   }
  }
 ],
