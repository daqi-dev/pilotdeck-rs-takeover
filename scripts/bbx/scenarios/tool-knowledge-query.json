     "name": "knowledge_query",
     "arguments": {}
    }
   }
  },
  {
   "name": "q02-after",
   "when": [
    "q02:",
    "\"tool_call_id\":\"call_q02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "q02",
   "when": [
