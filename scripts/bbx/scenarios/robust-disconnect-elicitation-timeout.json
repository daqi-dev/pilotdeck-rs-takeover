{
  "name": "robust-disconnect-elicitation-timeout",
  "about": "轮次挂在提问上时断开，断开期间提问超时（PILOTDECK_ELICITATION_TIMEOUT_MS=5000）：重连后轮次状态、run_get、会话记录，以及同会话能否继续提交下一轮。",
  "env": {
    "PILOTDECK_ELICITATION_TIMEOUT_MS": "5000"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Robust run\"}"
      }
    },
    {
      "name": "turn-2",
      "when": [
        "turn-2:"
      ],
      "reply": {
        "text": "Done 2."
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "ask_user_question",
          "arguments": {
            "questions": [
              {
                "question": "Which color?",
                "header": "Color",
                "options": [
                  {
                    "label": "Red",
                    "description": "warm"
                  },
                  {
                    "label": "Blue",
                    "description": "cool"
                  }
                ],
                "multiSelect": false
              }
            ]
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: ask me",
        "runId": "run-bbx-1"
      },
      "timeout": 3000,
      "expectTimeout": true
    },
    {
      "disconnect": true
    },
    {
      "sleep": 6000
    },
    {
      "connect": true
    },
    {
      "ws": "active_turn_snapshot",
      "params": {
        "sessionKey": "s-bbx-1",
        "includeEvents": false
      }
    },
    {
      "ws": "run_get",
      "params": {
        "sessionKey": "s-bbx-1",
        "runId": "run-bbx-1"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-2: again",
        "runId": "run-bbx-2"
      },
      "timeout": 15000
    }
  ]
}
