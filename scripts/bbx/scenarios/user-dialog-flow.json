  },
  {
   "name": "turn-7",
   "when": [
    "turn-7:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_7",
     "name": "request_user_choice",
     "arguments": {
      "prompt": "Pick",
      "options": [
       {
        "value": "a",
        "label": "A"
       },
       {
        "value": "b",
        "description": "B"
       }
      ],
      "defaultValue": "b"
     }
    }
   }
  },
  {
   "name": "turn-6-after-tool",
   "when": [
    "turn-6:",
    "\"tool_call_id\":\"call_ud_6\""
   ],
   "reply": {
    "text": "Done 6."
   }
  },
  {
   "name": "turn-6",
   "when": [
    "turn-6:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_6",
     "name": "request_user_choice",
     "arguments": {
      "prompt": "Bad",
      "options": [
       {
        "value": "a"
       },
       {
        "value": "a"
       }
      ]
     }
    }
   }
  },
  {
   "name": "turn-5-after-tool",
   "when": [
    "turn-5:",
    "\"tool_call_id\":\"call_ud_5\""
   ],
   "reply": {
    "text": "Done 5."
   }
  },
  {
   "name": "turn-5",
   "when": [
    "turn-5:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_5",
     "name": "request_user_confirmation",
     "arguments": {
      "prompt": "Labels",
      "confirmLabel": "   "
     }
    }
   }
  },
  {
   "name": "turn-4-after-tool",
   "when": [
    "turn-4:",
    "\"tool_call_id\":\"call_ud_4\""
   ],
   "reply": {
    "text": "Done 4."
