  {
   "name": "turn-3",
   "when": [
    "turn-3:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_3",
     "name": "request_user_confirmation",
     "arguments": {
      "prompt": "Proceed?",
      "cancelLabel": "No way"
     }
    }
   }
  },
  {
   "name": "turn-2-after-tool",
   "when": [
    "turn-2:",
    "\"tool_call_id\":\"call_ud_2\""
   ],
   "reply": {
    "text": "Done 2."
