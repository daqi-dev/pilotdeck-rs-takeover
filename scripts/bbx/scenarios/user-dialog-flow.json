{
 "name": "user-dialog-flow",
 "about": "userDialogKinds 打开 input/select/confirm：三种工具的应答、取消（带原因）、空输入、工具入参校验失败；对话框挂起时按保存的 requestId 走 claim（新租约、无租约重复 claim、带租约续期）、无租约/错租约 respond、release（错租约、成功、重复）、release 后带旧租约 respond、不合法答案、成功答案、重复答案；租约过期后用旧租约 respond；轮次中止后 list 为空、respond 不再送达。",
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\": \"Dialog flow\"}"
   }
  },
  {
   "name": "turn-9-after-tool",
   "when": [
    "turn-9:",
    "\"tool_call_id\":\"call_ud_9\""
   ],
   "reply": {
    "text": "Done 9."
   }
  },
  {
   "name": "turn-9",
   "when": [
    "turn-9:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_9",
     "name": "request_user_choice",
     "arguments": {
      "prompt": "Pick",
      "options": [
       {
        "value": "a",
        "label": "A"
       },
       {
        "value": "b",
        "description": "B"
       }
      ]
     }
    }
   }
  },
  {
   "name": "turn-8-after-tool",
   "when": [
    "turn-8:",
    "\"tool_call_id\":\"call_ud_8\""
   ],
   "reply": {
    "text": "Done 8."
   }
  },
  {
   "name": "turn-8",
   "when": [
    "turn-8:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_8",
     "name": "request_user_confirmation",
     "arguments": {
      "prompt": "Lease?"
     }
    }
   }
  },
  {
   "name": "turn-7-after-tool",
   "when": [
    "turn-7:",
    "\"tool_call_id\":\"call_ud_7\""
   ],
   "reply": {
    "text": "Done 7."
