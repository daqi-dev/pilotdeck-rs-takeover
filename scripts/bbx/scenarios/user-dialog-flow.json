    "runId": "run-ud-7",
    "message": "turn-7: lease flow",
    "sdkSessionConfig": {
     "userDialogKinds": [
      "input",
      "select",
      "confirm"
     ]
    }
   },
   "timeout": 3000,
   "expectTimeout": true,
   "save": {
    "rid": "\"requestId\":\"([0-9a-f-]{36})\""
   }
  },
  {
   "ws": "user_dialog_list",
   "params": {
    "sessionKey": "s-ud"
   }
  },
  {
   "ws": "user_dialog_claim",
   "params": {
    "sessionKey": "s-ud",
    "requestId": "{saved.rid}"
   },
   "save": {
    "lease": "\"leaseId\":\"([0-9a-f-]{36})\""
   }
  },
  {
   "ws": "user_dialog_claim",
   "params": {
    "sessionKey": "s-ud",
    "requestId": "{saved.rid}"
   }
  },
  {
