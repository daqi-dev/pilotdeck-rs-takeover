   "name": "turn-1",
   "when": [
    "turn-1:"
   ],
   "reply": {
    "tool": {
     "id": "call_ud_1",
     "name": "request_user_input",
     "arguments": {
      "prompt": "Name?",
      "placeholder": "your name",
      "allowEmpty": false
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-ud",
    "channelKey": "test",
    "runId": "run-ud-1",
    "message": "turn-1: input",
    "sdkSessionConfig": {
     "userDialogKinds": [
      "input",
      "select",
      "confirm"
     ]
    }
   },
   "timeout": 20000,
   "answer": [
    {
     "on": {
      "type": "user_dialog_request"
     },
     "ws": "user_dialog_respond",
     "params": {
      "sessionKey": "s-ud",
      "requestId": "{event.requestId}",
      "result": {
       "behavior": "answered",
       "value": "Ada"
      }
     },
     "count": 1
    }
   ]
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-ud",
    "channelKey": "test",
    "runId": "run-ud-2",
    "message": "turn-2: choice",
    "sdkSessionConfig": {
     "userDialogKinds": [
      "input",
      "select",
      "confirm"
