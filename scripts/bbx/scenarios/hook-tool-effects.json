{
  "name": "hook-tool-effects",
  "about": "工具 hook 输出里不改变流程的字段：PreToolUse 的 permissionDecision ask / passthrough 不影响执行，allow 不跳过权限询问（用户拒绝照样拒）；PermissionDenied 的 retry 不触发重试；顶层 decision:approve、reason、suppressOutput、systemMessage 不起作用；PostToolUse 的 updatedMCPToolOutput（对象、null、字符串）只进工具结果的 metadata.lifecycle；hookSpecificOutput 的 hookEventName 与事件不同照样生效、缺了整个忽略。",
  "files": {
    "home/.pilotdeck/plugins/bbx-effects/plugin.json": {
      "name": "bbx-effects",
      "version": "0.1.0",
      "description": "bbx bbx-effects",
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"ask reason\"}}\n' '' 0",
                "if": "bash(case-pre-ask)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"passthrough\"}}\n' '' 0",
                "if": "bash(case-pre-passthrough)"
              },
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"decision\":\"approve\",\"reason\":\"approved\",\"suppressOutput\":true,\"systemMessage\":\"pre system note\"}\n' '' 0",
                "if": "bash(case-approve)"
              }
            ]
          },
          {
            "matcher": "write_file",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs pre 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\",\"permissionDecisionReason\":\"allowed by pre hook\"}}\n' '' 0",
                "if": "write_file(perm-pre-allow)"
              }
            ]
          }
        ],
        "PostToolUse": [
          {
            "matcher": "bash",
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"updatedMCPToolOutput\":{\"content\":[{\"type\":\"text\",\"text\":\"replaced by hook\"}]}}}\n' '' 0",
                "if": "bash(case-mcp-output)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"updatedMCPToolOutput\":null}}\n' '' 0",
                "if": "bash(case-mcp-null)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"SomethingElse\",\"additionalContext\":\"context under another event name\"}}\n' '' 0",
                "if": "bash(case-mismatch)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"hookSpecificOutput\":{\"additionalContext\":\"context without event name\"}}\n' '' 0",
                "if": "bash(case-noname)"
              },
              {
                "type": "command",
                "command": "node hook.mjs post 0 '{\"suppressOutput\":true,\"systemMessage\":\"post system note\",\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"updatedMCPToolOutput\":\"plain string output\"}}\n' '' 0",
                "if": "bash(case-approve)"
              }
            ]
          }
        ],
        "PermissionRequest": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs perm 0 '' '' 0"
              }
            ]
          }
        ],
        "PermissionDenied": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node hook.mjs denied 0 '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionDenied\",\"retry\":true}}\n' '' 0"
              }
            ]
          }
        ]
      }
    },
    "home/.pilotdeck/plugins/bbx-effects/hook.mjs": "// bbx hook fixture: node hook.mjs <log> <exit> [stdout] [stderr] [sleepMs]\nimport fs from 'node:fs';\nconst [log, exit = '0', out = '', err = '', sleep = '0'] = process.argv.slice(2);\nconst dir = process.env.HOME + '/hooklog';\nconst append = (row) => { fs.mkdirSync(dir, { recursive: true }); fs.appendFileSync(dir + '/' + log + '.jsonl', JSON.stringify(row) + '\\n'); };\nlet input = '';\nprocess.stdin.on('data', (d) => { input += d; });\nprocess.stdin.on('end', () => {\n  let parsed; try { parsed = JSON.parse(input); } catch { parsed = { raw: input }; }\n  const env = {};\n  for (const k of Object.keys(process.env).sort()) env[k] = /^PILOT/.test(k) && !/BUNDLED/.test(k) ? process.env[k] : true;\n  append({ argv: process.argv.slice(2), cwd: process.cwd(), input: parsed, env });\n  // exit \"@\": the behaviour is the JSON between HOOK<< and >> in the prompt (or the last assistant message).\n  let spec = { exit, out, err, sleep };\n  if (exit === '@') {\n    const m = /HOOK<<(.*?)>>/s.exec(String(parsed.prompt ?? parsed.lastAssistantMessage ?? ''));\n    spec = { exit: 0, out: '', err: '', sleep: 0, ...(m ? JSON.parse(m[1]) : {}) };\n  }\n  setTimeout(() => {\n    append({ argv: process.argv.slice(2), done: true });\n    if (spec.out) process.stdout.write(spec.out);\n    if (spec.err) process.stderr.write(spec.err);\n    process.exit(Number(spec.exit));\n  }, Number(spec.sleep));\n});\n"
  },
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Hook run\"}"
