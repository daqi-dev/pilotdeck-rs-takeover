      "reply": {
        "text": "done case-pre-ask"
      }
    },
    {
      "name": "case-pre-ask",
      "when": [
        "case-pre-ask:"
      ],
      "reply": {
        "tool": {
          "id": "call_case_pre_ask",
          "name": "bash",
          "arguments": {
            "command": "printf case-pre-ask",
