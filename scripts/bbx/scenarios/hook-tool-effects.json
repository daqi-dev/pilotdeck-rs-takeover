  ],
  "steps": [
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-pre-ask",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-pre-ask",
        "channelKey": "test",
        "message": "case-pre-ask: run the tool"
      },
      "timeout": 20000
    },
    {
      "sleep": 300
    },
    {
      "ws": "set_permission_mode",
      "params": {
        "sessionKey": "s-pre-passthrough",
        "mode": "bypassPermissions"
      }
    },
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-pre-passthrough",
