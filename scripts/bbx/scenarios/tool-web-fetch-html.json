{
  "name": "tool-web-fetch-html",
  "about": "web_fetch 的内容转换边角（urlFetcher.ts:282-328）：content-type 含 text/html 才走 turndown（大小写敏感，TEXT/HTML 与 application/xhtml+xml 原样当文本）、二进制类型的占位文字、按 UTF-8 解码（声明 iso-8859-1 的页、BOM、非法字节）、gzip / deflate 压缩、分块传输、嵌套列表与各种标签、恰好 100000 字符与多一个字符的截断、截断点落在代理对中间；前十六页用 raw 模式直接比工具结果，后两页走 llm 模式比二次请求里的正文。",
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\n    openrouter:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        moonshotai/kimi-k2.6:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
  "httpsPort": 38419,
  "env": {
    "NODE_EXTRA_CA_CERTS": "{HTTPS_CA}"
  },
  "files": {
    "home/.pilotdeck/plugins/bbx-site/plugin.json": {
      "name": "bbx-site",
      "version": "0.1.0",
      "description": "bbx web_fetch site",
      "hooks": {
        "UserPromptSubmit": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "node {ROOT}/site/site.mjs {ROOT} 38417 38411"
              }
            ]
          }
