{
  "name": "robust-disconnect-elicitation-rebind",
  "about": "轮次挂在 ask_user_question 的提问上时客户端断开：重连后不重新挂接直接 elicitation_respond（旧绑定），再用存下的 connectionId 作 previousBinding 重新挂接后作答；轮次在没有客户端订阅的情况下跑完，run_get / active_turn_snapshot / 会话记录。",
  "provider": [
    {
      "name": "title",
      "when": [
        "Generate a concise title"
      ],
      "reply": {
        "text": "{\"title\": \"Robust run\"}"
      }
    },
    {
      "name": "turn-1-after-tool",
      "when": [
        "turn-1:",
        "\"tool_call_id\":\"call_bbx_1\""
      ],
      "reply": {
        "text": "Done 1."
      }
    },
    {
      "name": "turn-1",
      "when": [
        "turn-1:"
      ],
      "reply": {
        "tool": {
          "id": "call_bbx_1",
          "name": "ask_user_question",
          "arguments": {
            "questions": [
              {
                "question": "Which color?",
                "header": "Color",
                "options": [
                  {
                    "label": "Red",
                    "description": "warm"
                  },
                  {
                    "label": "Blue",
                    "description": "cool"
                  }
                ],
                "multiSelect": false
              }
            ]
          }
        }
      }
    }
  ],
  "steps": [
    {
      "ws": "submit_turn",
      "params": {
        "sessionKey": "s-bbx-1",
        "channelKey": "test",
        "message": "turn-1: ask me",
        "runId": "run-bbx-1"
      },
      "timeout": 3000,
      "expectTimeout": true,
      "save": {
        "cid": "\"connectionId\":\"([^\"]+)\"",
        "rid": "\"requestId\":\"([^\"]+)\""
      }
    },
    {
      "disconnect": true
    },
    {
      "sleep": 500
    },
    {
      "connect": true
    },
    {
      "ws": "active_turn_snapshot",
      "params": {
        "sessionKey": "s-bbx-1",
        "includeEvents": false
      }
    },
    {
      "ws": "elicitation_respond",
      "params": {
        "sessionKey": "s-bbx-1",
        "requestId": "{saved.rid}",
        "answer": {
          "type": "answered",
          "answers": {
            "Which color?": "Red"
          }
        }
      }
    },
    {
      "ws": "reconnect_interaction",
      "params": {
        "sessionKey": "s-bbx-1",
        "previousBinding": {
          "connectionId": "{saved.cid}",
          "generation": 1
        }
      }
    },
    {
      "ws": "elicitation_respond",
      "params": {
        "sessionKey": "s-bbx-1",
        "requestId": "{saved.rid}",
        "answer": {
          "type": "answered",
          "answers": {
            "Which color?": "Blue"
          }
        }
      }
    },
    {
      "sleep": 2500
    },
    {
      "ws": "active_turn_snapshot",
      "params": {
        "sessionKey": "s-bbx-1",
        "includeEvents": false
      }
    },
    {
      "ws": "run_get",
      "params": {
        "sessionKey": "s-bbx-1",
        "runId": "run-bbx-1"
      }
    },
    {
      "ws": "read_session_messages",
      "params": {
        "sessionKey": "s-bbx-1"
      }
    }
  ]
}
