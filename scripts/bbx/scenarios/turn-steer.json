{
  "name": "turn-steer",
  "about": "steer_turn 与 cancel_steer：没有进行中的轮次；轮次进行中（bash sleep 期间）插话被接受并在下一次模型请求前应用（steer_applied、会话记录、发给 provider 的请求），应用后再取消；runId 不匹配；取消未知条目；轮次结束后取消。每轮用不同会话。",
  "provider": [
    {
      "name": "title",
      "when": ["Generate a concise title"],
      "reply": { "text": "{\"title\": \"Steer run\"}" }
    },
    {
      "name": "turn-3-after-tool",
      "when": ["turn-3:", "\"tool_call_id\":\"call_bbx_3\""],
      "reply": { "text": "Done 3." }
    },
    {
      "name": "turn-3",
      "when": ["turn-3:"],
      "reply": { "tool": { "id": "call_bbx_3", "name": "bash", "arguments": { "command": "sleep 2; echo slept-3" } } }
    },
    {
      "name": "turn-2-after-tool",
      "when": ["turn-2:", "\"tool_call_id\":\"call_bbx_2\""],
      "reply": { "text": "Done 2." }
    },
    {
      "name": "turn-2",
      "when": ["turn-2:"],
      "reply": { "tool": { "id": "call_bbx_2", "name": "bash", "arguments": { "command": "sleep 2; echo slept-2" } } }
    },
    {
      "name": "turn-1-after-tool",
      "when": ["turn-1:", "\"tool_call_id\":\"call_bbx_1\""],
      "reply": { "text": "Done 1." }
    },
    {
      "name": "turn-1",
      "when": ["turn-1:"],
      "reply": { "tool": { "id": "call_bbx_1", "name": "bash", "arguments": { "command": "sleep 2; echo slept-1" } } }
    }
  ],
  "steps": [
    { "ws": "steer_turn", "params": { "sessionKey": "s-bbx-1", "runId": "run-bbx-1", "itemId": "item-0", "message": "too early" } },
    { "ws": "cancel_steer", "params": { "sessionKey": "s-bbx-1", "runId": "run-bbx-1", "itemId": "item-0" } },
    { "ws": "set_permission_mode", "params": { "sessionKey": "s-bbx-1", "mode": "bypassPermissions" } },
    {
      "ws": "submit_turn",
      "params": { "sessionKey": "s-bbx-1", "channelKey": "test", "runId": "run-bbx-1", "message": "turn-1: sleep" },
      "answer": [
        { "on": { "type": "tool_call_started" }, "ws": "steer_turn", "params": { "sessionKey": "s-bbx-1", "runId": "run-bbx-1", "itemId": "item-1", "message": "steer-1: also say hi" }, "count": 1 },
        { "on": { "type": "steer_applied" }, "ws": "cancel_steer", "params": { "sessionKey": "s-bbx-1", "runId": "run-bbx-1", "itemId": "item-1" }, "count": 1 }
      ],
      "timeout": 20000
    },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-bbx-1" } },
    { "ws": "set_permission_mode", "params": { "sessionKey": "s-bbx-2", "mode": "bypassPermissions" } },
    {
      "ws": "submit_turn",
      "params": { "sessionKey": "s-bbx-2", "channelKey": "test", "runId": "run-bbx-2", "message": "turn-2: sleep" },
      "answer": [
        { "on": { "type": "tool_call_started" }, "ws": "steer_turn", "params": { "sessionKey": "s-bbx-2", "runId": "run-other", "itemId": "item-2", "message": "steer-2: wrong run" }, "count": 1 }
      ],
      "timeout": 20000
    },
    { "ws": "set_permission_mode", "params": { "sessionKey": "s-bbx-3", "mode": "bypassPermissions" } },
    {
      "ws": "submit_turn",
      "params": { "sessionKey": "s-bbx-3", "channelKey": "test", "runId": "run-bbx-3", "message": "turn-3: sleep" },
      "answer": [
        { "on": { "type": "tool_call_started" }, "ws": "cancel_steer", "params": { "sessionKey": "s-bbx-3", "runId": "run-bbx-3", "itemId": "item-unknown" }, "count": 1 }
      ],
      "timeout": 20000
    },
    { "ws": "cancel_steer", "params": { "sessionKey": "s-bbx-3", "runId": "run-bbx-3", "itemId": "item-unknown" } }
  ]
}
