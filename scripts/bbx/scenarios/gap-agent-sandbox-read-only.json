{
 "name": "gap-agent-sandbox-read-only",
 "about": "agent.sandboxMode=read-only（pilot/config/loadPilotConfig.ts:396,428-440，tool/execution-world/SandboxPort.ts）：bypassPermissions 下 bash 只读命令、bash 写文件、write_file 各一轮（execute_code 的结果带耗时，token 估算随之抖，基线自比不稳，这里不测）。比较工具结果与落盘。项目为 alpha。",
 "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\n  sandboxMode: read-only\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
 "files": {
  "home/.pilotdeck/projects/private-tmp-pdrs-bbx-root-home-work-alpha/.cwd": "{HOME}/work/alpha\n",
  "home/work/alpha/r.txt": "read me\n"
 },
 "provider": [
  {
   "name": "title",
   "when": [
    "Generate a concise title"
   ],
   "reply": {
    "text": "{\"title\":\"Gap\"}"
   }
  },
  {
   "name": "t03-after",
   "when": [
    "g03:",
    "\"tool_call_id\":\"call_g03\""
   ],
   "reply": {
    "text": "Done 03."
   }
  },
  {
   "name": "t03",
   "when": [
    "g03:"
   ],
   "reply": {
    "tool": {
     "id": "call_g03",
     "name": "write_file",
     "arguments": {
      "file_path": "from-write.txt",
      "content": "w\n"
     }
    }
   }
  },
  {
   "name": "t02-after",
   "when": [
    "g02:",
    "\"tool_call_id\":\"call_g02\""
   ],
   "reply": {
    "text": "Done 02."
   }
  },
  {
   "name": "t02",
   "when": [
    "g02:"
   ],
   "reply": {
    "tool": {
     "id": "call_g02",
     "name": "bash",
     "arguments": {
      "command": "echo x > from-bash.txt; echo rc=$?"
     }
    }
   }
  },
  {
   "name": "t01-after",
   "when": [
    "g01:",
    "\"tool_call_id\":\"call_g01\""
   ],
   "reply": {
    "text": "Done 01."
   }
  },
  {
   "name": "t01",
   "when": [
    "g01:"
   ],
   "reply": {
    "tool": {
     "id": "call_g01",
     "name": "bash",
     "arguments": {
      "command": "cat r.txt"
     }
    }
   }
  }
 ],
 "steps": [
  {
   "ws": "set_permission_mode",
   "params": {
    "sessionKey": "s-gap",
    "mode": "bypassPermissions",
    "projectKey": "{HOME}/work/alpha"
   }
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g01: go",
    "projectKey": "{HOME}/work/alpha"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g02: go",
    "projectKey": "{HOME}/work/alpha"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  },
  {
   "ws": "submit_turn",
   "params": {
    "sessionKey": "s-gap",
    "channelKey": "test",
    "message": "g03: go",
    "projectKey": "{HOME}/work/alpha"
   },
   "timeout": 20000
  },
  {
   "sleep": 300
  }
 ]
}
