{
  "name": "memory-enabled",
  "about": "memory.enabled: true（edgeclaw，不配模型）时 memory_list / memory_wipe 的正常路径：空库列出、按项目与按会话清空，以及落盘。记忆的写入需要模型抽取，不在本场景里。",
  "config": "schemaVersion: 1\nagent:\n  model: bbx/deterministic\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    bbx:\n      protocol: openai\n      url: {MOCK}/v1\n      apiKey: bbx-mock-only\n      models:\n        deterministic:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\nmemory:\n  enabled: true\n  provider: edgeclaw\n  captureStrategy: last_turn\n  includeAssistant: false\n",
