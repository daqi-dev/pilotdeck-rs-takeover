{
  "name": "proto-google-basic",
  "about": "Google Gemini 协议（基线经 @google/genai SDK 发请求：providers/google/client.ts、request.ts 请求体、stream.ts 流解析、response.ts 非流式解析；streaming/streamModel.ts:172/366 流式、:94/349 非流式）。protocol: google 的 provider 指向假 provider（url 不带版本段）。标题生成走非流式 :generateContent（session/title/SessionTitleGenerator.ts:74），标题应答带 thought 部分；provider 设了 timeoutMs，非流式请求带 X-Server-Timeout（流式不带）；s-g5 的标题请求回 500（complete 的重试）。g1 纯文本；g2 工具调用（不带 functionCall.id，基线按 responseId 合成 id）后回文本（历史里的 functionCall / functionResponse）；g3 文本加两个工具调用（显式 id）；g4 thought 部分 + 分块文本，第二轮把 thought 与 thoughtSignature 回传；g5 400 INVALID_ARGUMENT；g6 500 INTERNAL（流式重试后出错）；g7 429 RESOURCE_EXHAUSTED；g8 用量带 cachedContentTokenCount / thoughtsTokenCount；g9 finishReason MAX_TOKENS；g10 finishReason SAFETY。比较请求的方法、路径、头、体和后续事件、落盘。SDK 把 HTTP 应答头整份挂在每个流块的 sdkHttpResponse 上（工具调用的 raw 会带着它落盘），假 provider 因此给 Gemini 应答固定 date 头。",
  "config": "schemaVersion: 1\nagent:\n  model: gem/gemini-bbx\n  maxContextTokens: 65536\n  maxOutputTokens: 8192\nmodel:\n  providers:\n    gem:\n      protocol: google\n      url: {MOCK}\n      apiKey: bbx-google-key\n      timeoutMs: 45000\n      retry:\n        baseDelayMs: 1\n        maxDelayMs: 1\n        jitter: 0\n      models:\n        gemini-bbx:\n          capabilities:\n            supportsToolUse: true\n            maxContextTokens: 65536\n            maxOutputTokens: 8192\ntelemetry:\n  enabled: false\n",
  "files": { "home/.pilotdeck/a.txt": "alpha\n", "home/.pilotdeck/b.txt": "beta\n" },
  "provider": [
    { "name": "title-fail", "when": ["Generate a concise title", "g5:"], "reply": { "status": 500, "body": { "error": { "code": 500, "message": "Title backend failed.", "status": "INTERNAL" } } } },
    { "name": "title", "when": ["Generate a concise title"], "reply": { "reasoning": "Naming it.", "text": "{\"title\":\"Gem\"}", "usage": { "prompt_tokens": 30, "completion_tokens": 5, "total_tokens": 35 } } },
    { "name": "g1", "when": ["g1:"], "reply": { "text": "Hello from Gemini mock." } },
    { "name": "g2-done", "when": ["g2:", "\"functionResponse\""], "reply": { "text": "g2 done." } },
    { "name": "g2", "when": ["g2:"], "reply": { "tool": { "name": "read_file", "arguments": { "file_path": "a.txt" } } } },
    { "name": "g3-done", "when": ["g3:", "\"functionResponse\""], "reply": { "text": "g3 done." } },
    { "name": "g3", "when": ["g3:"], "reply": { "text": "Reading two.", "tools": [
      { "id": "call_g3a", "name": "read_file", "arguments": { "file_path": "a.txt" } },
      { "id": "call_g3b", "name": "read_file", "arguments": { "file_path": "b.txt" } } ] } },
    { "name": "g4-second", "when": ["g4:", "g4 again"], "reply": { "text": "g4 second answer." } },
    { "name": "g4", "when": ["g4:"], "reply": { "reasoning": "Let me think about g4.", "text": "g4 answer.", "chunks": ["g4 ", "answer."] } },
    { "name": "g5", "when": ["g5:"], "reply": { "status": 400, "body": { "error": { "code": 400, "message": "Invalid JSON payload received from mock.", "status": "INVALID_ARGUMENT" } } } },
    { "name": "g6", "when": ["g6:"], "reply": { "status": 500, "body": { "error": { "code": 500, "message": "An internal error has occurred.", "status": "INTERNAL" } } } },
    { "name": "g7", "when": ["g7:"], "reply": { "status": 429, "body": { "error": { "code": 429, "message": "Resource has been exhausted (e.g. check quota).", "status": "RESOURCE_EXHAUSTED" } } } },
    { "name": "g8", "when": ["g8:"], "reply": { "text": "g8 usage.", "usage": { "prompt_tokens": 120, "completion_tokens": 40, "total_tokens": 185, "prompt_tokens_details": { "cached_tokens": 100 }, "completion_tokens_details": { "reasoning_tokens": 25 } } } },
    { "name": "g9-more", "when": ["g9:", "g9 cut"], "reply": { "text": " g9 rest." } },
    { "name": "g9", "when": ["g9:"], "reply": { "text": "g9 cut", "finish": "MAX_TOKENS" } },
    { "name": "g10", "when": ["g10:"], "reply": { "text": "g10 blocked", "finish": "SAFETY" } }
  ],
  "steps": [
    { "ws": "submit_turn", "params": { "sessionKey": "s-g1", "channelKey": "test", "message": "g1: hi" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g1" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g2", "channelKey": "test", "message": "g2: read" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g2" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g3", "channelKey": "test", "message": "g3: read two" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g3" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g4", "channelKey": "test", "message": "g4: think" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g4", "channelKey": "test", "message": "g4 again" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g4" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g5", "channelKey": "test", "message": "g5: fail" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g6", "channelKey": "test", "message": "g6: server" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g7", "channelKey": "test", "message": "g7: limited" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g7" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g8", "channelKey": "test", "message": "g8: usage" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "usage_snapshot", "params": { "sessionKey": "s-g8" } },
    { "ws": "model_usage_snapshot", "params": { "sessionKey": "s-g8" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g9", "channelKey": "test", "message": "g9: long" }, "timeout": 20000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g9" } },
    { "ws": "submit_turn", "params": { "sessionKey": "s-g10", "channelKey": "test", "message": "g10: safety" }, "timeout": 30000 },
    { "sleep": 300 },
    { "ws": "read_session_messages", "params": { "sessionKey": "s-g10" } }
  ]
}
